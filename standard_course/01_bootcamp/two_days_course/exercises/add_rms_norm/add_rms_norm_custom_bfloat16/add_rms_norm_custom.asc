#include "kernel_operator.h"

namespace {
constexpr uint32_t BUF_ALIGN_BYTES = 32;
constexpr uint32_t REDUCE_WORK_ELEMS = 64;

__aicore__ inline uint32_t AlignToBuf(uint32_t bytes)
{
    return (bytes + BUF_ALIGN_BYTES - 1u) & ~(BUF_ALIGN_BYTES - 1u);
}
}

class KernelAddRmsNormCustom {
public:
    __aicore__ inline KernelAddRmsNormCustom() {}

    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR gamma,
                                GM_ADDR y, GM_ADDR rstd, GM_ADDR x,
                                uint32_t m, uint32_t n, float in_epsilon, float inv_n)
    {
        uint32_t blockDim = AscendC::GetBlockNum();
        uint32_t blockIdx = AscendC::GetBlockIdx();

        rowLength = n;
        epsilon = in_epsilon;
        invN = inv_n;

        uint32_t rowsPerCore = m / blockDim;
        uint32_t tailRows = m % blockDim;
        rowStart = blockIdx * rowsPerCore + ((blockIdx < tailRows) ? blockIdx : tailRows);
        rowCount = rowsPerCore + ((blockIdx < tailRows) ? 1u : 0u);

        uint64_t totalElems = static_cast<uint64_t>(m) * n;
        x1Gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(x1), totalElems);
        x2Gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(x2), totalElems);
        gammaGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(gamma), n);
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(y), totalElems);
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(x), totalElems);
        rstdGm.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(rstd), m);

        const uint32_t aligned_n = AlignToBuf(n * sizeof(bfloat16_t)) / sizeof(bfloat16_t);

        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ub_allocator;

        x1Buf = ub_allocator.Alloc<bfloat16_t>(aligned_n);
        x2Buf = ub_allocator.Alloc<bfloat16_t>(aligned_n);
        gammaBuf = ub_allocator.Alloc<bfloat16_t>(aligned_n);
        yBuf = ub_allocator.Alloc<bfloat16_t>(aligned_n);
        xBuf = ub_allocator.Alloc<bfloat16_t>(aligned_n);

        x1fBuf = ub_allocator.Alloc<float>(aligned_n);
        x2fBuf = ub_allocator.Alloc<float>(aligned_n);
        xfBuf = ub_allocator.Alloc<float>(aligned_n);
        reduceWorkBuf = ub_allocator.Alloc<float>(REDUCE_WORK_ELEMS);
    }

    __aicore__ inline void Process()
    {
        for (uint32_t r = 0; r < rowCount; ++r) {
            ProcessRow(rowStart + r);
        }
    }

private:
    __aicore__ inline void ProcessRow(uint32_t row)
    {
        uint64_t rowBase = static_cast<uint64_t>(row) * rowLength;

        AscendC::DataCopyParams params{};
        params.blockLen = rowLength * sizeof(bfloat16_t);
        params.blockCount = 1;

        AscendC::DataCopyPad(x1Buf, x1Gm[rowBase], params, AscendC::DataCopyPadParams{});
        AscendC::DataCopyPad(x2Buf, x2Gm[rowBase], params, AscendC::DataCopyPadParams{});
        AscendC::DataCopyPad(gammaBuf, gammaGm, params, AscendC::DataCopyPadParams{});
        AscendC::PipeBarrier<PIPE_ALL>();

        AscendC::Cast(x1fBuf, x1Buf, AscendC::RoundMode::CAST_NONE, rowLength);
        AscendC::Cast(x2fBuf, x2Buf, AscendC::RoundMode::CAST_NONE, rowLength);

        AscendC::Add(x1fBuf, x1fBuf, x2fBuf, rowLength);
        AscendC::Cast(xBuf, x1fBuf, AscendC::RoundMode::CAST_RINT, rowLength);
        AscendC::PipeBarrier<PIPE_V>();

        AscendC::Cast(x1fBuf, xBuf, AscendC::RoundMode::CAST_NONE, rowLength); // x1fBuf = x1 + x2
        AscendC::PipeBarrier<PIPE_V>();

        AscendC::Mul(xfBuf, x1fBuf, x1fBuf, rowLength);     // xfBuf = x^2
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::ReduceSum<float>(x2fBuf, xfBuf, reduceWorkBuf, static_cast<int32_t>(rowLength));
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(x2fBuf, x2fBuf, invN, 1);
        AscendC::PipeBarrier<PIPE_V>();

        AscendC::Adds(x2fBuf, x2fBuf, epsilon, 1);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Sqrt(x2fBuf, x2fBuf, 1);       // x2fBuf = RMS
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Duplicate(reduceWorkBuf, 1.0f, 1);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Div(xfBuf, reduceWorkBuf, x2fBuf, 1);  // xfBuf = rstd
        AscendC::PipeBarrier<PIPE_ALL>();

        float rstd = xfBuf.GetValue(0);      // rstd = 1/RMS
        AscendC::Muls(x1fBuf, x1fBuf, rstd, rowLength);  // x1fBuf = x * rstd
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Cast(yBuf, x1fBuf, AscendC::RoundMode::CAST_RINT, rowLength);  // normalized_bf16
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Cast(x1fBuf, yBuf, AscendC::RoundMode::CAST_NONE, rowLength);  // fp32(normalized_bf16)
        AscendC::PipeBarrier<PIPE_V>();

        AscendC::Cast(x2fBuf, gammaBuf, AscendC::RoundMode::CAST_NONE, rowLength); // fp32(gamma)
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(x2fBuf, x2fBuf, x1fBuf, rowLength);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Cast(yBuf, x2fBuf, AscendC::RoundMode::CAST_RINT, rowLength);   // y, bfloat16
        AscendC::PipeBarrier<PIPE_ALL>();

        AscendC::DataCopyPad(yGm[rowBase], yBuf, params);
        AscendC::DataCopyPad(xGm[rowBase], xBuf, params);
        params.blockLen = sizeof(float);
        AscendC::DataCopyPad(rstdGm[row], xfBuf, params);
        AscendC::PipeBarrier<PIPE_ALL>();
    }

private:
    uint32_t rowLength;
    uint32_t rowStart;
    uint32_t rowCount;
    float epsilon;
    float invN;

    AscendC::TPipe pipe;
    AscendC::LocalTensor<bfloat16_t> x1Buf;
    AscendC::LocalTensor<bfloat16_t> x2Buf;
    AscendC::LocalTensor<bfloat16_t> gammaBuf;
    AscendC::LocalTensor<bfloat16_t> yBuf;
    AscendC::LocalTensor<bfloat16_t> xBuf;

    AscendC::LocalTensor<float> x1fBuf;
    AscendC::LocalTensor<float> x2fBuf;
    AscendC::LocalTensor<float> xfBuf;
    AscendC::LocalTensor<float> reduceWorkBuf;

    AscendC::GlobalTensor<bfloat16_t> x1Gm;
    AscendC::GlobalTensor<bfloat16_t> x2Gm;
    AscendC::GlobalTensor<bfloat16_t> gammaGm;
    AscendC::GlobalTensor<bfloat16_t> yGm;
    AscendC::GlobalTensor<bfloat16_t> xGm;
    AscendC::GlobalTensor<float> rstdGm;
};

__global__ __vector__ void add_rms_norm_custom(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR gamma,
    GM_ADDR y, GM_ADDR rstd, GM_ADDR x,
    uint32_t m, uint32_t n, float epsilon, float inv_n)
{
    KernelAddRmsNormCustom op;
    op.Init(x1, x2, gamma, y, rstd, x, m, n, epsilon, inv_n);
    op.Process();
}

extern "C" void add_rms_norm_custom_impl(
    void *aclStream,
    uint8_t *x1, uint8_t *x2, uint8_t *gamma,
    uint8_t *y, uint8_t *rstd, uint8_t *x,
    uint32_t m, uint32_t n, float epsilon)
{
    if (m == 0 || n == 0) {
        return;
    }

    constexpr uint32_t NPU_CORE_NUM = 32;
    uint32_t blocks_num = (m < NPU_CORE_NUM) ? m : NPU_CORE_NUM;
    float inv_n = 1.0f / static_cast<float>(n);
    add_rms_norm_custom<<<blocks_num, 0, aclStream>>>(x1, x2, gamma, y, rstd, x, m, n, epsilon, inv_n);
}
