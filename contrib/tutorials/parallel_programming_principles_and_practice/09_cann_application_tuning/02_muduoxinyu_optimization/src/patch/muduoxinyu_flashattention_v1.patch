+// Dedicated persistent workspace for the FlashAttention V4 op. Semantics match
+// EnsurePersistentBuffer, but any growth sync caused by replacing a live
+// buffer is additionally counted in flashSyncCount (first allocation from
+// nullptr is not a sync).
+static void* EnsureFlashWorkspace(CNPUBackend::Impl* impl,
+                                  size_t requiredBytes) {
+    PersistentDeviceBuffer& buffer = impl->flashWorkspace;
+    if (requiredBytes <= buffer.capacity) {
+        return buffer.ptr;
+    }
+    if (buffer.ptr != nullptr) {
+        ACL_CHECK(aclrtSynchronizeStream(impl->stream_));
+        impl->workspaceGrowthSyncCount++;
+        impl->flashSyncCount++;
+        ACL_CHECK(aclrtFree(buffer.ptr));
+        buffer.ptr = nullptr;
+        buffer.capacity = 0;
+    }
+    if (requiredBytes > 0) {
+        ACL_CHECK(aclrtMalloc(&buffer.ptr, requiredBytes, ACL_MEM_MALLOC_HUGE_FIRST));
+        buffer.capacity = requiredBytes;
+        impl->hotAllocCount++;
+    }
+    return buffer.ptr;
+}
