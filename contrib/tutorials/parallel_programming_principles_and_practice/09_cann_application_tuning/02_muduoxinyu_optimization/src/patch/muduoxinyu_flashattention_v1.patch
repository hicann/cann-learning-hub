+// Device-side dtype cast (Path B FP32 <-> FP16). The workspace is served from
+// the shared persistent buffer; no per-call allocation. Counts into
+// flashCastCalls for the structured runtime evidence. targetDtype must match
+// the dtype of the out tensor (official aclnnCast two-stage signature).
+static void RunAclnnCast(CNPUBackend::Impl* impl,
+                         aclTensor* input,
+                         aclDataType targetDtype,
+                         aclTensor* out) {
+    uint64_t workspaceSize = 0;
+    aclOpExecutor* executor = nullptr;
+    ACL_CHECK(aclnnCastGetWorkspaceSize(input, targetDtype, out, &workspaceSize, &executor));
+
+    // Growth of the shared workspace inside a cast is a real synchronous
+    // drain on the flash path: account it in flashSyncCount.
+    const long long growthBefore = impl->workspaceGrowthSyncCount;
+    void* workspace = EnsurePersistentBuffer(
+        impl, impl->primitiveWorkspace, static_cast<size_t>(workspaceSize));
+    const long long growthAfter = impl->workspaceGrowthSyncCount;
+    if (growthAfter > growthBefore) {
+        impl->flashSyncCount += (growthAfter - growthBefore);
+    }
+    ACL_CHECK(aclnnCast(workspace, workspaceSize, executor, impl->stream_));
+    impl->flashCastCalls++;
+}
