+void CNPUBackend::prepareFlashAttention(int numLayers, int numHeads, int numKvHeads,
+                                        int headSize, int maxSeqLen) {
+    if (numLayers <= 0 || numHeads <= 0 || numKvHeads <= 0 || headSize <= 0 || maxSeqLen <= 0) {
+        std::cerr << "[NPU_FLASH_ATTENTION] invalid model shape: numLayers=" << numLayers
+                  << " numHeads=" << numHeads << " numKvHeads=" << numKvHeads
+                  << " headSize=" << headSize << " maxSeqLen=" << maxSeqLen << std::endl;
+        exit(EXIT_FAILURE);
+    }
+    if (numHeads % numKvHeads != 0) {
+        std::cerr << "[NPU_FLASH_ATTENTION] unsupported head relationship: numHeads="
+                  << numHeads << " numKvHeads=" << numKvHeads
+                  << " (only MHA/GQA with numHeads % numKvHeads == 0 is supported)."
+                  << std::endl;
+        exit(EXIT_FAILURE);
+    }
+    if (numHeads / numKvHeads > 64) {
+        std::cerr << "[NPU_FLASH_ATTENTION] unsupported head relationship: numHeads="
+                  << numHeads << " numKvHeads=" << numKvHeads
+                  << " (numHeads / numKvHeads > 64 is not supported)."
+                  << std::endl;
+        exit(EXIT_FAILURE);
+    }
+
+    if (pImpl->flashAttentionPrepared &&
+        pImpl->flashNumLayers == numLayers &&
+        pImpl->flashNumHeads == numHeads &&
+        pImpl->flashNumKvHeads == numKvHeads &&
+        pImpl->flashHeadSize == headSize &&
+        pImpl->flashMaxSeqLen == maxSeqLen) {
+        return;
+    }
+
+    ACL_CHECK(aclrtSetCurrentContext(pImpl->context_));
+
+    if (pImpl->flashAttentionPrepared) {
+        // Shape change on a live session is a cold-path event: drain the
+        // stream before replacing the persistent FP16 buffers.
+        ACL_CHECK(aclrtSynchronizeStream(pImpl->stream_));
+        pImpl->workspaceGrowthSyncCount++;
+        pImpl->flashSyncCount++;
+        ReleaseFlashAttentionResources(pImpl);
+    }
+
+    const size_t kvCacheBytes = static_cast<size_t>(numLayers) * numKvHeads
+                              * maxSeqLen * headSize * sizeof(uint16_t);
+    const size_t queryBytes = static_cast<size_t>(numHeads) * headSize * sizeof(uint16_t);
+    const size_t kvScratchBytes = static_cast<size_t>(numKvHeads) * headSize * sizeof(uint16_t);
+
+    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&pImpl->flashKeyCache),
+                          kvCacheBytes, ACL_MEM_MALLOC_HUGE_FIRST));
+    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&pImpl->flashValueCache),
+                          kvCacheBytes, ACL_MEM_MALLOC_HUGE_FIRST));
+    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&pImpl->flashQueryBuf),
+                          queryBytes, ACL_MEM_MALLOC_HUGE_FIRST));
+    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&pImpl->flashOutBuf),
+                          queryBytes, ACL_MEM_MALLOC_HUGE_FIRST));
+    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&pImpl->flashKScratchBuf),
+                          kvScratchBytes, ACL_MEM_MALLOC_HUGE_FIRST));
+    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&pImpl->flashVScratchBuf),
+                          kvScratchBytes, ACL_MEM_MALLOC_HUGE_FIRST));
+
+    pImpl->flashNumLayers = numLayers;
+    pImpl->flashNumHeads = numHeads;
+    pImpl->flashNumKvHeads = numKvHeads;
+    pImpl->flashHeadSize = headSize;
+    pImpl->flashMaxSeqLen = maxSeqLen;
+    pImpl->flashAttentionPrepared = true;
+
+    // Only announce the path as enabled after every persistent FP16 buffer
+    // has been allocated and the prepared flag is set.
+    if (!pImpl->flashPathPrinted) {
+        pImpl->flashPathPrinted = true;
+        std::cout << "[NPU_ATTENTION_PATH] path=flash_attention_v4 dtype=fp16 "
+                  << "api=aclnnIncreFlashAttentionV4 fallback=0" << std::endl;
+    }
+}
