// ============================================================================
// rope_simt_950.asc — RoPE SIMT 模板源码（一个线程处理一个 pair）
//
// ONLY 目标硬件：Ascend 950PR / 950DT（npu-arch=dav-3510）
// 仅在 950 环境的编译方式（教学示意，本课程不执行）：
//   ccec --enable-simt --npu-arch=dav-3510 rope_simt_950.asc
//
// 能力门（重要边界，务必先读）：
//   * Ascend 910B3 不支持正式 SIMT 路径；
//   * 本文件在 910B3 上【不编译、不执行】，课程在 910B3 上的固定结论为
//     simt_status=DEFERRED_UNSUPPORTED_TARGET；
//   * 不得用 ccec/bisheng 的 help 输出（含 SIMD/SIMT flag）当作 SIMT 通过依据；
//   * 本文件是教学模板，不是任何环境上的 PASS 依据。
//
// pair-planar 语义（与 SIMD 路径完全一致，一个线程计算一个 pair）：
//   out_even[p] = x_even[p] * cos[p] - x_odd[p] * sin[p]
//   out_odd [p] = x_even[p] * sin[p] + x_odd[p] * cos[p]
//   p ∈ [0, count)，count 由 Host 传入；越界线程直接返回（边界检查）。
// ============================================================================

// 全局线程号由 blockIdx/threadIdx 合成（与 gather_2d.asc 04_06 样例同范式）。
__global__ void rope_simt(float* x_even, float* x_odd, float* cos, float* sin,
                          float* out_even, float* out_odd, unsigned int count)
{
    unsigned int p = blockIdx.x * blockDim.x + threadIdx.x;
    if (p >= count) {          // 边界检查：只有 count 内的线程参与计算
        return;
    }
    out_even[p] = x_even[p] * cos[p] - x_odd[p] * sin[p];
    out_odd[p]  = x_even[p] * sin[p] + x_odd[p] * cos[p];
}

// 以下仅为 950 上启动方式的注释示意（910B3 不编译、不运行）：
//   unsigned int count   = 384;   // 12 heads x 32 pairs = 384 连续 pair
//   unsigned int threads = 128;
//   unsigned int blocks  = (count + threads - 1) / threads;
//   rope_simt<<<blocks, threads, 0, stream>>>(
//       dXEven, dXOdd, dCos, dSin, dOutEven, dOutOdd, count);
