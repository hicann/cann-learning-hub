/*
 * 实验5.1 msSanitizer 标准算子工程版：Add 算子 Kernel 侧（configure_file 输入模板）。
 * 本文件是模板，不直接参与编译：op_kernel/CMakeLists.txt 用 configure_file 把
 * 四个 @LAB05_FAULT_MODE_*_LITERAL@ 占位符替换为0/1字面量，生成到根构建树
 * ${CMAKE_BINARY_DIR}/lab05_generated_kernel/add_custom_msanitizer.cpp；
 * 该生成文件才是真正参与 Kernel 编译的源码，构建过程不改写源码树。
 * 故障选择走「生成字面量」而非 -D 编译定义：真机已验证 CANN 9.0.0 的
 * add_ops_compile_options / npu_op_kernel_options 不保证自定义 -D 进入 Kernel
 * 预处理。四类故障路径均为本课程适配，不是官方样例原样。
 */

#include "kernel_operator.h"
#include "add_custom_msanitizer_tiling.h"
#include "kernel_operator_dump_tensor_intf_impl.h"
constexpr int32_t BUFFER_NUM = 2;

// 由 CMake configure_file 按当前构建模式生成；四个字面量中最多一个为1。
#define LAB05_CONFIGURED_FAULT_MODE_MEMCHECK @LAB05_FAULT_MODE_MEMCHECK_LITERAL@
#define LAB05_CONFIGURED_FAULT_MODE_RACECHECK @LAB05_FAULT_MODE_RACECHECK_LITERAL@
#define LAB05_CONFIGURED_FAULT_MODE_INITCHECK @LAB05_FAULT_MODE_INITCHECK_LITERAL@
#define LAB05_CONFIGURED_FAULT_MODE_SYNCCHECK @LAB05_FAULT_MODE_SYNCCHECK_LITERAL@
#define LAB05_CONFIGURED_HAS_FAULT \
    (LAB05_CONFIGURED_FAULT_MODE_MEMCHECK || LAB05_CONFIGURED_FAULT_MODE_RACECHECK || \
     LAB05_CONFIGURED_FAULT_MODE_INITCHECK || LAB05_CONFIGURED_FAULT_MODE_SYNCCHECK)

#if LAB05_CONFIGURED_HAS_FAULT
// memcheck 使用独立的编译期分支（只分配 xLocal）；racecheck/initcheck/
// synccheck 共用一条最小 LocalMemAllocator 路径。每条路径都与正常 TPipe Add
// 完全隔离。每次构建只启用一个故障，避免不同检测器相互干扰。
template<typename TYPE_X, typename TYPE_Y, typename TYPE_Z>
__aicore__ inline void RunSanitizerFault(GM_ADDR x, GM_ADDR y, GM_ADDR z)
{
    // 只让第 0 个核执行教学故障，避免同一错误被多个核重复报告。
    if (AscendC::GetBlockIdx() != 0) {
        return;
    }
    // LocalMemAllocator 静态内存路径必须先初始化 SoC 状态；正常路径由 TPipe
    // 管理，本专用故障路径不创建 TPipe，因此在这里显式完成初始化。
    AscendC::InitSocState();
    // 复用独立 ASC 版已经真机验证的2048元素故障尺度。Host为输入分配4096个
    // float，因此 memcheck 模式扩大到4096元素时，Global侧读取仍然合法。
    constexpr uint32_t FAULT_BLOCK = 2048u;
    constexpr uint32_t MEMCHECK_COPY_BLOCK = FAULT_BLOCK * 2u;
#if LAB05_CONFIGURED_FAULT_MODE_MEMCHECK == 1
    // memcheck 独立编译期分支：本分支只创建 xGm、LocalMemAllocator 和一个
    // 2048-float 的 xLocal，不再为 memcheck 分配 yLocal/zLocal。
    AscendC::GlobalTensor<TYPE_X> xGm;
    xGm.SetGlobalBuffer((__gm__ TYPE_X*)x, MEMCHECK_COPY_BLOCK);
    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<TYPE_X> xLocal = ubAllocator.Alloc<TYPE_X, FAULT_BLOCK>();
    // xGm 是合法的 4096-float Global 输入（读取侧完全合法）；DataCopy 把
    // 4096 个 float 写入仅 2048-float 的 xLocal，写入量明显越过本分支
    // allocator 的总分配区，预期稳定报告 UB illegal write / out-of-bounds。
    // 旧构造会连续分配 x/y/z 三个 tensor，越界部分仍落在同一 allocator 已
    // 分配的 yLocal 区域，故障不是“明显越过本次总分配区”的最小构造，在
    // A3 真机上表现为只打印 "Start memcheck sanitizer" 后持续卡住。
    AscendC::DataCopy(xLocal, xGm, MEMCHECK_COPY_BLOCK);
    // 完成/屏障后直接结束 memcheck 分支：不执行 Add/CopyOut，也不分配
    // yLocal/zLocal。memcheck 只关心搬运越界本身。
    AscendC::PipeBarrier<PIPE_ALL>();
    return;
#else
    // racecheck/initcheck/synccheck 共用路径（原有实现与已通过语义保持不变）。
    AscendC::GlobalTensor<TYPE_X> xGm;
    AscendC::GlobalTensor<TYPE_Y> yGm;
    AscendC::GlobalTensor<TYPE_Z> zGm;
    xGm.SetGlobalBuffer((__gm__ TYPE_X*)x, MEMCHECK_COPY_BLOCK);
    yGm.SetGlobalBuffer((__gm__ TYPE_Y*)y, FAULT_BLOCK);
    zGm.SetGlobalBuffer((__gm__ TYPE_Z*)z, FAULT_BLOCK);
    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<TYPE_X> xLocal = ubAllocator.Alloc<TYPE_X, FAULT_BLOCK>();
    AscendC::LocalTensor<TYPE_Y> yLocal = ubAllocator.Alloc<TYPE_Y, FAULT_BLOCK>();
    AscendC::LocalTensor<TYPE_Z> zLocal = ubAllocator.Alloc<TYPE_Z, FAULT_BLOCK>();
    AscendC::DataCopy(xLocal, xGm, FAULT_BLOCK);
    AscendC::DataCopy(yLocal, yGm, FAULT_BLOCK);

#if LAB05_CONFIGURED_FAULT_MODE_SYNCCHECK == 1
    // 保留正确同步对，再插入一个没有WaitFlag的SetFlag，预期报告unpaired set_flag。
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID1);
#elif LAB05_CONFIGURED_FAULT_MODE_RACECHECK == 0
    // racecheck模式刻意删除MTE2->Vector同步，预期报告RAW hazard。
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
#endif

#if LAB05_CONFIGURED_FAULT_MODE_INITCHECK == 0
    AscendC::Add(zLocal, xLocal, yLocal, FAULT_BLOCK);
#else
    // initcheck 必须检测“已分配但未写入的数据被读取”，而不是未初始化的
    // Tensor描述。zLocal 已在 UB 分配，但这里故意跳过写入，随后 DataCopy
    // 从 zLocal 读取未初始化数据，预期报告 uninitialized read on UB。
#endif
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::DataCopy(zGm, zLocal, FAULT_BLOCK);
    AscendC::PipeBarrier<PIPE_ALL>();
#endif
}
#endif

template<typename TYPE_X, typename TYPE_Y, typename TYPE_Z> class KernelAddMsanitizer {
public:
    __aicore__ inline KernelAddMsanitizer() {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t smallCoreDataNum,
                                uint32_t bigCoreDataNum, uint32_t finalBigTileNum,
                                uint32_t finalSmallTileNum, uint32_t tileDataNum,
                                uint32_t smallTailDataNum, uint32_t bigTailDataNum,
                                uint32_t tailBlockNum)
    {
        uint32_t coreNum = AscendC::GetBlockIdx();
        uint32_t globalBufferIndex = bigCoreDataNum * AscendC::GetBlockIdx();
        this->tileDataNum = tileDataNum;
        if (coreNum < tailBlockNum) {
          this->coreDataNum = bigCoreDataNum;
          this->tileNum = finalBigTileNum;
          this->tailDataNum = bigTailDataNum;
        }
        else {
          this->coreDataNum = smallCoreDataNum;
          this->tileNum = finalSmallTileNum;
          this->tailDataNum = smallTailDataNum;
          globalBufferIndex -= (bigCoreDataNum - smallCoreDataNum) * (AscendC::GetBlockIdx() - tailBlockNum);
        }
        xGm.SetGlobalBuffer((__gm__ TYPE_X*)x + globalBufferIndex, this->coreDataNum);
        yGm.SetGlobalBuffer((__gm__ TYPE_Y*)y + globalBufferIndex, this->coreDataNum);
        zGm.SetGlobalBuffer((__gm__ TYPE_Z*)z + globalBufferIndex, this->coreDataNum);
        pipe.InitBuffer(inQueueX, BUFFER_NUM, this->tileDataNum * sizeof(TYPE_X));
        pipe.InitBuffer(inQueueY, BUFFER_NUM, this->tileDataNum * sizeof(TYPE_Y));
        pipe.InitBuffer(outQueueZ, BUFFER_NUM, this->tileDataNum * sizeof(TYPE_Z));
    }
    __aicore__ inline void Process()
    {
        // baseline：原始 TPipe 三阶段流水，全部长度保持正确。
        int32_t loopCount = this->tileNum;
        this->processDataNum = this->tileDataNum;
        for (int32_t i = 0; i < loopCount; i++) {
            if (i == this->tileNum - 1) {
              this->processDataNum = this->tailDataNum;
            }
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t progress)
    {
        // baseline 正常流程：长度始终正确，无任何乘数/越界逻辑。
        AscendC::LocalTensor<TYPE_X> xLocal = inQueueX.AllocTensor<TYPE_X>();
        AscendC::LocalTensor<TYPE_Y> yLocal = inQueueY.AllocTensor<TYPE_Y>();
        AscendC::DataCopy(xLocal, xGm[progress * this->tileDataNum], this->processDataNum);
        AscendC::DataCopy(yLocal, yGm[progress * this->tileDataNum], this->processDataNum);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);
    }
    __aicore__ inline void Compute(int32_t progress)
    {
        AscendC::LocalTensor<TYPE_X> xLocal = inQueueX.DeQue<TYPE_X>();
        AscendC::LocalTensor<TYPE_Y> yLocal = inQueueY.DeQue<TYPE_Y>();
        AscendC::LocalTensor<TYPE_Z> zLocal = outQueueZ.AllocTensor<TYPE_Z>();
        AscendC::Add(zLocal, xLocal, yLocal, this->processDataNum);
        outQueueZ.EnQue<TYPE_Z>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);
    }
    __aicore__ inline void CopyOut(int32_t progress)
    {
        AscendC::LocalTensor<TYPE_Z> zLocal = outQueueZ.DeQue<TYPE_Z>();
        AscendC::DataCopy(zGm[progress * this->tileDataNum], zLocal, this->processDataNum);
        outQueueZ.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, BUFFER_NUM> inQueueX, inQueueY;
    AscendC::TQue<AscendC::QuePosition::VECOUT, BUFFER_NUM> outQueueZ;
    AscendC::GlobalTensor<TYPE_X> xGm;
    AscendC::GlobalTensor<TYPE_Y> yGm;
    AscendC::GlobalTensor<TYPE_Z> zGm;
    uint32_t coreDataNum;
    uint32_t tileNum;
    uint32_t tileDataNum;
    uint32_t tailDataNum;
    uint32_t processDataNum;
};



 __global__ __aicore__ void add_custom_msanitizer(GM_ADDR x, GM_ADDR y, GM_ADDR z, GM_ADDR workspace, GM_ADDR tiling)
{
    // 两个模式必须保留同一份 Tiling 注册合同。若把注册宏仅放在 baseline 分支，
    // memcheck 二进制会生成 0 字节 Tiling 元数据，Host 侧 GetTilingData() 返回空指针，
    // 程序会在 Kernel 启动前崩溃，mssanitizer 自然无法给出设备侧诊断。
    REGISTER_TILING_DEFAULT(TilingDataMsanitizer);
    GET_TILING_DATA_WITH_STRUCT(TilingDataMsanitizer, tiling_data, tiling);
#if LAB05_CONFIGURED_HAS_FAULT
    // 故障模式仍保留标准算子 Tiling 合同，但不初始化正常 TPipe/队列，
    // 只运行本次构建选中的最小故障分支。
    RunSanitizerFault<DTYPE_X, DTYPE_Y, DTYPE_Z>(x, y, z);
#else
    KernelAddMsanitizer<DTYPE_X, DTYPE_Y, DTYPE_Z> op;
    op.Init(x, y, z, tiling_data.smallCoreDataNum,
            tiling_data.bigCoreDataNum, tiling_data.finalBigTileNum,
            tiling_data.finalSmallTileNum, tiling_data.tileDataNum,
            tiling_data.smallTailDataNum, tiling_data.bigTailDataNum,
            tiling_data.tailBlockNum);
    op.Process();
#endif
}
