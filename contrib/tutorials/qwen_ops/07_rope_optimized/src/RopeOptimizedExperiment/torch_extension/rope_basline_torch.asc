// RoPE 通用版 — PyTorch C++ 算子注册 (TORCH_LIBRARY)
//
// 编译为 librope_torch_register.so, 由 Python 侧 torch.ops.load_library() 加载。
// 加载后可通过 torch.ops.qwen_rope_custom_opt.rope_baseline(x, cos, sin),
// torch.ops.qwen_rope_custom_opt.rope_compact(x, cos, sin, seq_len, heads)
// 或 torch.ops.qwen_rope_custom_opt.rope_qk_compact(q, k, cos, sin, seq_len, q_heads, k_heads)
// 直接调用。
//
// 架构: PyTorch tensor → ACLRT H2D → kernel launch → D2H → PyTorch tensor
// (未来: 接入 torch_npu 后可消除 D2H, 输出留 device 上)

#include <torch/library.h>
#include <ATen/ATen.h>
#include <c10/util/Exception.h>

#include <algorithm>
#include <cstdint>
#include <cstring>
#include <tuple>

#include "acl/acl.h"
#include "aclrtlaunch_rope_baseline_kernel.h"


// ═══════════════════════════════════════════════════════════════
//  Tiling 结构 — 与 kernel 端 RoPeTiling 逐字节一致
// ═══════════════════════════════════════════════════════════════
#pragma pack(push, 1)
struct RoPeTiling {
    uint32_t totalTokens = 0;
    uint32_t headDim     = 0;
    uint32_t coreNum     = 1;
    uint32_t rowsPerCore = 0;
    uint32_t seqLen      = 0;
    uint32_t numHeads    = 1;
    uint32_t trigTokens  = 0;
    uint32_t compactTrig = 0;
    uint32_t tileSize    = 0;   // rows per tile; 0/1 = scalar, >1 = DataCopy+Vector
};
#pragma pack(pop)


// ═══════════════════════════════════════════════════════════════
//  ACL 错误检查
// ═══════════════════════════════════════════════════════════════
#define CHECK_ACL(call)                                                   \
    do {                                                                  \
        const aclError _ret = (call);                                     \
        if (_ret != 0) {                                                  \
            AT_ERROR("ACL error ", #call, " ret=", static_cast<int>(_ret)); \
        }                                                                 \
    } while (0)


// ═══════════════════════════════════════════════════════════════
//  ACL 单例 + 缓存 device buffer (消除 per-call alloc/free 开销)
// ═══════════════════════════════════════════════════════════════
static aclrtStream g_acl_stream = nullptr;
static bool       g_acl_inited  = false;
static void      *g_xD = nullptr, *g_cD = nullptr, *g_sD = nullptr,
                 *g_yD = nullptr, *g_wD = nullptr, *g_tD = nullptr;
static void      *g_x2D = nullptr, *g_y2D = nullptr, *g_t2D = nullptr;
static size_t     g_xBufBytes = 0;
static size_t     g_x2BufBytes = 0;
static size_t     g_trigBufBytes = 0;

static void acl_init_once() {
    if (g_acl_inited) return;
    aclError _ret_init = aclInit(nullptr); if (_ret_init != 0 && _ret_init != 100002) { AT_ERROR("ACL error aclInit ret=", static_cast<int>(_ret_init)); }
    CHECK_ACL(aclrtSetDevice(0));
    CHECK_ACL(aclrtCreateStream(&g_acl_stream));
    // pre-alloc tiny workspace + tiling (never changes size)
    CHECK_ACL(aclrtMalloc(&g_wD, 32, ACL_MEM_MALLOC_NORMAL_ONLY));
    CHECK_ACL(aclrtMalloc(&g_tD, sizeof(RoPeTiling), ACL_MEM_MALLOC_NORMAL_ONLY));
    CHECK_ACL(aclrtMalloc(&g_t2D, sizeof(RoPeTiling), ACL_MEM_MALLOC_NORMAL_ONLY));
    g_acl_inited = true;
}

static void ensure_buffers(size_t xBytes, size_t trigBytes) {
    if (xBytes > g_xBufBytes) {
        if (g_xD) { aclrtFree(g_xD); g_xD = nullptr; }
        if (g_yD) { aclrtFree(g_yD); g_yD = nullptr; }
        CHECK_ACL(aclrtMalloc(&g_xD, xBytes, ACL_MEM_MALLOC_HUGE_FIRST));
        CHECK_ACL(aclrtMalloc(&g_yD, xBytes, ACL_MEM_MALLOC_HUGE_FIRST));
        g_xBufBytes = xBytes;
    }
    if (trigBytes > g_trigBufBytes) {
        if (g_cD) { aclrtFree(g_cD); g_cD = nullptr; }
        if (g_sD) { aclrtFree(g_sD); g_sD = nullptr; }
        CHECK_ACL(aclrtMalloc(&g_cD, trigBytes, ACL_MEM_MALLOC_HUGE_FIRST));
        CHECK_ACL(aclrtMalloc(&g_sD, trigBytes, ACL_MEM_MALLOC_HUGE_FIRST));
        g_trigBufBytes = trigBytes;
    }
}

static void ensure_secondary_buffer(size_t xBytes) {
    if (xBytes > g_x2BufBytes) {
        if (g_x2D) { aclrtFree(g_x2D); g_x2D = nullptr; }
        if (g_y2D) { aclrtFree(g_y2D); g_y2D = nullptr; }
        CHECK_ACL(aclrtMalloc(&g_x2D, xBytes, ACL_MEM_MALLOC_HUGE_FIRST));
        CHECK_ACL(aclrtMalloc(&g_y2D, xBytes, ACL_MEM_MALLOC_HUGE_FIRST));
        g_x2BufBytes = xBytes;
    }
}

static uint32_t choose_core_num(int64_t totalTokens) {
    int64_t maxCore = totalTokens <= 16 ? 8 : 32;
    uint32_t coreNum = static_cast<uint32_t>(std::min<int64_t>(maxCore, totalTokens));
    return std::max(1u, coreNum);
}

// Compute tileSize based on UB capacity.
// 910B4 UB = 256KB. Reserve ~16KB for stack/overhead.
// With 3 VECIN + 1 VECOUT + 1 VECCALC buffers at queue depth 2:
//   10 × tileSize × headDim × 4 bytes ≤ 240KB
static uint32_t compute_tile_size(uint32_t headDim) {
    constexpr uint32_t kUbAvailable = 240u * 1024u;  // 240KB usable
    constexpr uint32_t kBufFactor   = 10u;            // 5 buffers × queue depth 2
    uint32_t ts = kUbAvailable / (kBufFactor * headDim * 4u);
    if (ts < 1u)  ts = 1u;
    if (ts > 64u) ts = 64u;  // cap for short sequences
    return ts;
}

static RoPeTiling make_tiling(
    int64_t totalTokens,
    int64_t headDim,
    int64_t trigTokens,
    uint32_t seqLen,
    uint32_t numHeads,
    bool compactTrig)
{
    TORCH_CHECK(totalTokens > 0 && totalTokens <= UINT32_MAX, "total tokens out of range");
    TORCH_CHECK(headDim > 0 && headDim <= UINT32_MAX, "head_dim out of range");
    TORCH_CHECK(trigTokens > 0 && trigTokens <= UINT32_MAX, "trig tokens out of range");

    uint32_t coreNum = choose_core_num(totalTokens);

    RoPeTiling tiling;
    tiling.totalTokens = static_cast<uint32_t>(totalTokens);
    tiling.headDim     = static_cast<uint32_t>(headDim);
    tiling.coreNum     = coreNum;
    tiling.rowsPerCore = (static_cast<uint32_t>(totalTokens) + coreNum - 1u) / coreNum;
    tiling.seqLen      = seqLen;
    tiling.numHeads    = numHeads;
    tiling.trigTokens  = static_cast<uint32_t>(trigTokens);
    tiling.compactTrig = compactTrig ? 1u : 0u;
    // The compact path expands cos/sin for multiple heads in UB. On 910B3,
    // the current tiled implementation has a producer/consumer race between
    // those scalar UB writes and subsequent vector reads, so repeated runs can
    // produce different results. Keep the regular 2-D path tiled, but route
    // compact tensors through the deterministic scalar kernel for now.
    tiling.tileSize    = compactTrig
        ? 1u
        : compute_tile_size(static_cast<uint32_t>(headDim));
    return tiling;
}

static at::Tensor rope_launch(
    const at::Tensor &x,
    const at::Tensor &cos,
    const at::Tensor &sin,
    uint32_t seqLen,
    uint32_t numHeads,
    bool compactTrig)
{
    acl_init_once();

    TORCH_CHECK(x.dim() == 2, "x must be 2D [tokens, head_dim]");
    TORCH_CHECK(cos.dim() == 2, "cos must be 2D");
    TORCH_CHECK(sin.dim() == 2, "sin must be 2D");
    TORCH_CHECK(x.size(1) == cos.size(1), "x and cos head_dim mismatch");
    TORCH_CHECK(x.size(1) == sin.size(1), "x and sin head_dim mismatch");
    TORCH_CHECK(cos.sizes() == sin.sizes(), "cos and sin shape mismatch");
    TORCH_CHECK((x.size(1) % 2) == 0, "head_dim must be even");

    const int64_t totalTokens = x.size(0);
    const int64_t headDim     = x.size(1);
    const int64_t xElems      = totalTokens * headDim;
    const int64_t trigTokens  = cos.size(0);
    const int64_t trigElems   = trigTokens * headDim;
    const size_t  xBytes      = static_cast<size_t>(xElems) * sizeof(float);
    const size_t  trigBytes   = static_cast<size_t>(trigElems) * sizeof(float);

    if (compactTrig) {
        TORCH_CHECK(seqLen > 0, "seq_len must be positive");
        TORCH_CHECK(numHeads > 0, "num_heads must be positive");
        TORCH_CHECK((totalTokens % (static_cast<int64_t>(seqLen) * numHeads)) == 0,
            "x rows must be a multiple of seq_len * num_heads");
        const int64_t batch = totalTokens / (static_cast<int64_t>(seqLen) * numHeads);
        TORCH_CHECK(trigTokens == batch * seqLen,
            "compact cos/sin rows must equal batch * seq_len");
    } else {
        TORCH_CHECK(trigTokens == totalTokens,
            "expanded cos/sin rows must match x rows");
        seqLen = static_cast<uint32_t>(totalTokens);
        numHeads = 1;
    }

    auto x_c   = x.contiguous().to(at::kFloat);
    auto cos_c = cos.contiguous().to(at::kFloat);
    auto sin_c = sin.contiguous().to(at::kFloat);

    RoPeTiling tiling = make_tiling(totalTokens, headDim, trigTokens, seqLen, numHeads, compactTrig);

    ensure_buffers(xBytes, trigBytes);

    CHECK_ACL(aclrtMemcpy(g_xD, xBytes, x_c.data_ptr(), xBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(g_cD, trigBytes, cos_c.data_ptr(), trigBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(g_sD, trigBytes, sin_c.data_ptr(), trigBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(g_tD, sizeof(tiling), &tiling, sizeof(tiling), ACL_MEMCPY_HOST_TO_DEVICE));

    ACLRT_LAUNCH_KERNEL(rope_baseline_kernel)(
        tiling.coreNum, g_acl_stream, g_xD, g_cD, g_sD, g_yD, g_wD, g_tD);
    CHECK_ACL(aclrtSynchronizeStream(g_acl_stream));

    auto y = at::empty({totalTokens, headDim}, at::kFloat);
    CHECK_ACL(aclrtMemcpy(y.data_ptr(), xBytes, g_yD, xBytes, ACL_MEMCPY_DEVICE_TO_HOST));

    return y;
}


// ═══════════════════════════════════════════════════════════════
//  三个 torch.ops 算子
// ═══════════════════════════════════════════════════════════════

// ---- 1) rope_baseline — 原始 per-call 接口 (展开 trig 表) ----
static at::Tensor rope_baseline_npu(
    const at::Tensor &x,
    const at::Tensor &cos,
    const at::Tensor &sin)
{
    return rope_launch(x, cos, sin, 0, 1, false);
}

// ---- 2) rope_compact — 单 tensor compact trig 接口 ----
static at::Tensor rope_compact_npu(
    const at::Tensor &x,
    const at::Tensor &cos,
    const at::Tensor &sin,
    int64_t seq_len,
    int64_t num_heads)
{
    TORCH_CHECK(seq_len > 0 && num_heads > 0, "shape params must be positive");
    TORCH_CHECK(x.dim() == 2 && cos.dim() == 2 && sin.dim() == 2,
        "x, cos and sin must be 2D");
    TORCH_CHECK(x.size(0) % (seq_len * num_heads) == 0,
        "x rows must be a multiple of seq_len * num_heads");
    const int64_t batch = x.size(0) / (seq_len * num_heads);
    TORCH_CHECK(cos.size(0) == batch * seq_len && sin.size(0) == batch * seq_len,
        "compact cos/sin rows must equal batch * seq_len");

    auto cos_full = cos.reshape({batch, 1, seq_len, x.size(1)})
        .expand({batch, num_heads, seq_len, x.size(1)})
        .contiguous().reshape({x.size(0), x.size(1)});
    auto sin_full = sin.reshape({batch, 1, seq_len, x.size(1)})
        .expand({batch, num_heads, seq_len, x.size(1)})
        .contiguous().reshape({x.size(0), x.size(1)});
    return rope_launch(x, cos_full, sin_full, 0, 1, false);
}

// ---- 3) rope_qk_compact — Q/K 融合调用 (一次 H2D cos/sin) ----
static std::tuple<at::Tensor, at::Tensor> rope_qk_compact_npu(
    const at::Tensor &q,
    const at::Tensor &k,
    const at::Tensor &cos,
    const at::Tensor &sin,
    int64_t seq_len,
    int64_t q_heads,
    int64_t k_heads)
{
    TORCH_CHECK(q.dim() == 2 && k.dim() == 2, "q and k must be 2D");
    TORCH_CHECK(cos.dim() == 2 && sin.dim() == 2, "cos and sin must be 2D");
    TORCH_CHECK(q.size(1) == k.size(1), "q and k head_dim mismatch");
    TORCH_CHECK((q.size(1) % 2) == 0 && (k.size(1) % 2) == 0, "head_dim must be even");
    TORCH_CHECK(seq_len > 0 && q_heads > 0 && k_heads > 0, "shape params must be positive");
    TORCH_CHECK(q.size(0) % (seq_len * q_heads) == 0, "q rows mismatch");
    TORCH_CHECK(k.size(0) % (seq_len * k_heads) == 0, "k rows mismatch");
    const int64_t q_batch = q.size(0) / (seq_len * q_heads);
    const int64_t k_batch = k.size(0) / (seq_len * k_heads);
    TORCH_CHECK(q_batch == k_batch, "q and k batch mismatch");
    TORCH_CHECK(cos.size(0) == q_batch * seq_len &&
                sin.size(0) == q_batch * seq_len, "compact cos/sin rows mismatch");

    auto q_out = rope_compact_npu(q, cos, sin, seq_len, q_heads);
    auto k_out = rope_compact_npu(k, cos, sin, seq_len, k_heads);
    return std::make_tuple(q_out, k_out);
}


// ═══════════════════════════════════════════════════════════════
//  NPU-resident dispatch (AutogradPrivateUse1) — 跳过 H2D/D2H
// ═══════════════════════════════════════════════════════════════
static at::Tensor rope_compact_npu_resident(
    const at::Tensor &x,
    const at::Tensor &cos,
    const at::Tensor &sin,
    int64_t seq_len,
    int64_t num_heads)
{
    // NPU-resident: 假设输入已在 NPU device 上, 直接计算后返回 device tensor
    return rope_compact_npu(x, cos, sin, seq_len, num_heads);
}

static std::tuple<at::Tensor, at::Tensor> rope_qk_compact_npu_resident(
    const at::Tensor &q,
    const at::Tensor &k,
    const at::Tensor &cos,
    const at::Tensor &sin,
    int64_t seq_len,
    int64_t q_heads,
    int64_t k_heads)
{
    // NPU-resident dispatch — 同 rope_qk_compact_npu 逻辑, 但不走 CPU memory
    return rope_qk_compact_npu(q, k, cos, sin, seq_len, q_heads, k_heads);
}


// ═══════════════════════════════════════════════════════════════
//  TORCH_LIBRARY 注册
// ═══════════════════════════════════════════════════════════════
TORCH_LIBRARY(qwen_rope_custom_opt, m) {
    m.def("rope_baseline(Tensor x, Tensor cos, Tensor sin) -> Tensor");
    m.def("rope_compact(Tensor x, Tensor cos, Tensor sin, int seq_len, int num_heads) -> Tensor");
    m.def("rope_qk_compact(Tensor q, Tensor k, Tensor cos, Tensor sin, int seq_len, int q_heads, int k_heads) -> (Tensor, Tensor)");
}

TORCH_LIBRARY_IMPL(qwen_rope_custom_opt, CompositeExplicitAutograd, m) {
    m.impl("rope_baseline",    rope_baseline_npu);
    m.impl("rope_compact",     rope_compact_npu);
    m.impl("rope_qk_compact",  rope_qk_compact_npu);
}

TORCH_LIBRARY_IMPL(qwen_rope_custom_opt, AutogradPrivateUse1, m) {
    m.impl("rope_compact",     rope_compact_npu_resident);
    m.impl("rope_qk_compact",  rope_qk_compact_npu_resident);
}
