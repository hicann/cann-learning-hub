#include <torch/library.h>
#include <ATen/ATen.h>
#include <c10/util/Exception.h>

#include <algorithm>
#include <cstdint>
#include <cstring>
#include <limits>
#include <vector>

#include "acl/acl.h"
#include "aclrtlaunch_rmsnorm_optimized_kernel.h"
#include "rmsnorm_tiling.h"

#define CHECK_ACL(call)                                                    \
    do {                                                                   \
        const aclError ret = (call);                                       \
        if (ret != ACL_SUCCESS) {                                         \
            AT_ERROR("ACL error: ", #call, " ret=", static_cast<int>(ret)); \
        }                                                                  \
    } while (0)

static aclrtStream g_stream = nullptr;
static bool g_aclInited = false;

static void InitAclOnce()
{
    if (g_aclInited) {
        return;
    }
    const aclError initRet = aclInit(nullptr);
    if (initRet != ACL_SUCCESS && initRet != ACL_ERROR_REPEAT_INITIALIZE) {
        AT_ERROR("ACL error: aclInit(nullptr) ret=", static_cast<int>(initRet));
    }
    CHECK_ACL(aclrtSetDevice(0));
    CHECK_ACL(aclrtCreateStream(&g_stream));
    g_aclInited = true;
}

static at::Tensor rmsnorm_optimized_npu(const at::Tensor &input, const at::Tensor &weight, double eps)
{
    TORCH_CHECK(input.device().is_cpu(), "optimized wrapper expects CPU input tensor");
    TORCH_CHECK(weight.device().is_cpu(), "optimized wrapper expects CPU weight tensor");
    TORCH_CHECK(input.scalar_type() == at::kFloat, "input must be float32");
    TORCH_CHECK(weight.scalar_type() == at::kFloat, "weight must be float32");
    TORCH_CHECK(input.dim() >= 1, "input must have at least 1 dimension");
    TORCH_CHECK(weight.dim() == 1, "weight must be a 1D tensor");
    TORCH_CHECK(input.size(input.dim() - 1) == weight.size(0), "input last dimension must equal weight size");
    TORCH_CHECK(input.numel() > 0, "empty tensor is not supported");
    TORCH_CHECK(input.numel() <= std::numeric_limits<uint32_t>::max(), "tensor is too large for uint32 tiling");
    TORCH_CHECK(weight.numel() <= std::numeric_limits<uint32_t>::max(), "weight is too large for uint32 tiling");
    TORCH_CHECK(eps > 0.0, "eps must be positive");

    InitAclOnce();

    auto inputContig = input.contiguous();
    auto weightContig = weight.contiguous();
    auto output = at::empty_like(inputContig);

    const uint32_t hidden = static_cast<uint32_t>(weightContig.numel());
    const uint32_t totalSize = static_cast<uint32_t>(inputContig.numel());
    const uint32_t rows = totalSize / hidden;
    const uint32_t coreNum = std::max(1u, std::min<uint32_t>(8u, rows));
    TORCH_CHECK((hidden % 8u) == 0u, "optimized wrapper requires hidden to be a multiple of 8 floats");

    RmsNormOptimizedTiling tiling;
    tiling.rows = rows;
    tiling.hidden = hidden;
    tiling.coreNum = coreNum;
    tiling.rowsPerCore = (rows + coreNum - 1u) / coreNum;
    tiling.eps = static_cast<float>(eps);
    tiling.invHidden = 1.0f / static_cast<float>(hidden);

    const size_t inputBytes = static_cast<size_t>(totalSize) * sizeof(float);
    const size_t weightBytes = static_cast<size_t>(hidden) * sizeof(float);
    void *inputD = nullptr;
    void *weightD = nullptr;
    void *outD = nullptr;
    void *workspaceD = nullptr;
    void *tilingD = nullptr;

    CHECK_ACL(aclrtMalloc(&inputD, inputBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(&weightD, weightBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(&outD, inputBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(&workspaceD, 32, ACL_MEM_MALLOC_NORMAL_ONLY));
    CHECK_ACL(aclrtMalloc(&tilingD, sizeof(RmsNormOptimizedTiling), ACL_MEM_MALLOC_NORMAL_ONLY));

    CHECK_ACL(aclrtMemcpy(inputD, inputBytes, inputContig.data_ptr<float>(), inputBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(weightD, weightBytes, weightContig.data_ptr<float>(), weightBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(tilingD, sizeof(tiling), &tiling, sizeof(tiling), ACL_MEMCPY_HOST_TO_DEVICE));

    ACLRT_LAUNCH_KERNEL(rmsnorm_optimized_kernel)(coreNum, g_stream, inputD, weightD, outD, workspaceD, tilingD);
    CHECK_ACL(aclrtSynchronizeStream(g_stream));

    CHECK_ACL(aclrtMemcpy(output.data_ptr<float>(), inputBytes, outD, inputBytes, ACL_MEMCPY_DEVICE_TO_HOST));

    CHECK_ACL(aclrtFree(inputD));
    CHECK_ACL(aclrtFree(weightD));
    CHECK_ACL(aclrtFree(outD));
    CHECK_ACL(aclrtFree(workspaceD));
    CHECK_ACL(aclrtFree(tilingD));

    return output.view(input.sizes());
}

TORCH_LIBRARY(rmsnorm_custom, m) {
    m.def("rms_norm(Tensor input, Tensor weight, float eps=1e-6) -> Tensor");
}

TORCH_LIBRARY_IMPL(rmsnorm_custom, CompositeExplicitAutograd, m) {
    m.impl("rms_norm", rmsnorm_optimized_npu);
}
