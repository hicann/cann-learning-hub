#include <ATen/ATen.h>
#include <c10/util/Exception.h>
#include <torch/library.h>

#include <algorithm>
#include <cmath>
#include <cstdint>
#include <limits>

#include "acl/acl.h"
#include "aclrtlaunch_gqa_attention_optimized_kernel.h"
#include "gqa_attention_tiling.h"

#define CHECK_ACL(call) do { const aclError ret = (call); if (ret != ACL_SUCCESS) AT_ERROR("ACL error: ", #call, " ret=", static_cast<int>(ret)); } while (0)

static aclrtStream gStream = nullptr;
static bool gAclInited = false;
static void InitAclOnce()
{
    if (!gAclInited) {
        const aclError initRet = aclInit(nullptr);
        if (initRet != ACL_SUCCESS && initRet != ACL_ERROR_REPEAT_INITIALIZE) {
            AT_ERROR("ACL error: aclInit(nullptr) ret=", static_cast<int>(initRet));
        }
        CHECK_ACL(aclrtSetDevice(0));
        CHECK_ACL(aclrtCreateStream(&gStream));
        gAclInited = true;
    }
}

static at::Tensor gqa_attention_optimized_npu(const at::Tensor &q, const at::Tensor &k, const at::Tensor &v, double scale, bool causal)
{
    TORCH_CHECK(q.device().is_cpu() && k.device().is_cpu() && v.device().is_cpu(), "wrapper expects CPU tensors");
    TORCH_CHECK(q.scalar_type() == at::kFloat && k.scalar_type() == at::kFloat && v.scalar_type() == at::kFloat, "q, k and v must be float32");
    TORCH_CHECK(q.dim() == 4 && k.dim() == 4 && v.dim() == 4, "q, k and v must be [B,H,S,D]");
    TORCH_CHECK(k.sizes() == v.sizes(), "k and v shapes must match");
    TORCH_CHECK(q.size(0) == k.size(0) && q.size(3) == k.size(3), "batch and head_dim must match");
    TORCH_CHECK(q.size(1) % k.size(1) == 0, "query heads must be divisible by kv heads");
    TORCH_CHECK(q.size(0) > 0 && q.size(2) > 0 && k.size(2) > 0 && q.size(3) > 0, "empty tensors are unsupported");
    TORCH_CHECK(q.size(3) % 8 == 0, "head_dim must be divisible by 8 for the AscendC vector path");
    TORCH_CHECK(q.numel() <= std::numeric_limits<uint32_t>::max() && k.numel() <= std::numeric_limits<uint32_t>::max(), "tensor is too large");

    const uint32_t batch = q.size(0), queryHeads = q.size(1), kvHeads = k.size(1);
    const uint32_t queryLen = q.size(2), keyLen = k.size(2), headDim = q.size(3);
    const uint32_t totalQueries = batch * queryHeads * queryLen;
    const uint32_t coreNum = std::max(1u, std::min(8u, totalQueries));
    GqaAttentionOptimizedTiling tiling;
    tiling.batch = batch; tiling.queryHeads = queryHeads; tiling.kvHeads = kvHeads; tiling.queryLen = queryLen; tiling.keyLen = keyLen; tiling.headDim = headDim;
    tiling.totalQueries = totalQueries; tiling.coreNum = coreNum; tiling.queriesPerCore = (totalQueries + coreNum - 1) / coreNum; tiling.causal = causal ? 1 : 0;
    tiling.scale = scale == 0.0 ? 1.0f / std::sqrt(static_cast<float>(headDim)) : static_cast<float>(scale);

    InitAclOnce();
    auto qc = q.contiguous(), kc = k.contiguous(), vc = v.contiguous(), output = at::empty_like(qc);
    const size_t qBytes = qc.nbytes(), kvBytes = kc.nbytes();
    void *qd = nullptr, *kd = nullptr, *vd = nullptr, *od = nullptr, *workspace = nullptr, *tilingd = nullptr;
    CHECK_ACL(aclrtMalloc(&qd, qBytes, ACL_MEM_MALLOC_HUGE_FIRST)); CHECK_ACL(aclrtMalloc(&kd, kvBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(&vd, kvBytes, ACL_MEM_MALLOC_HUGE_FIRST)); CHECK_ACL(aclrtMalloc(&od, qBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(&workspace, 32, ACL_MEM_MALLOC_NORMAL_ONLY)); CHECK_ACL(aclrtMalloc(&tilingd, sizeof(tiling), ACL_MEM_MALLOC_NORMAL_ONLY));
    CHECK_ACL(aclrtMemcpy(qd, qBytes, qc.data_ptr<float>(), qBytes, ACL_MEMCPY_HOST_TO_DEVICE)); CHECK_ACL(aclrtMemcpy(kd, kvBytes, kc.data_ptr<float>(), kvBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(vd, kvBytes, vc.data_ptr<float>(), kvBytes, ACL_MEMCPY_HOST_TO_DEVICE)); CHECK_ACL(aclrtMemcpy(tilingd, sizeof(tiling), &tiling, sizeof(tiling), ACL_MEMCPY_HOST_TO_DEVICE));
    ACLRT_LAUNCH_KERNEL(gqa_attention_optimized_kernel)(coreNum, gStream, qd, kd, vd, od, workspace, tilingd);
    CHECK_ACL(aclrtSynchronizeStream(gStream));
    CHECK_ACL(aclrtMemcpy(output.data_ptr<float>(), qBytes, od, qBytes, ACL_MEMCPY_DEVICE_TO_HOST));
    CHECK_ACL(aclrtFree(qd)); CHECK_ACL(aclrtFree(kd)); CHECK_ACL(aclrtFree(vd)); CHECK_ACL(aclrtFree(od)); CHECK_ACL(aclrtFree(workspace)); CHECK_ACL(aclrtFree(tilingd));
    return output;
}

TORCH_LIBRARY(gqa_attention_optimized_custom, m) { m.def("gqa_attention(Tensor q, Tensor k, Tensor v, float scale=0., bool causal=True) -> Tensor"); }
TORCH_LIBRARY_IMPL(gqa_attention_optimized_custom, CompositeExplicitAutograd, m) { m.impl("gqa_attention", gqa_attention_optimized_npu); }
