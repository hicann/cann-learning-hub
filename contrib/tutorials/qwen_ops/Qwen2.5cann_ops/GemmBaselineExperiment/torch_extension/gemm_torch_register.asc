#include <torch/extension.h>
#include <acl/acl.h>
#include <acl/acl_rt.h>

#include <algorithm>
#include <cstdint>
#include <limits>
#include <stdexcept>
#include <string>

#include "torch_npu/csrc/core/npu/NPUStream.h"

#include "aclrtlaunch_gemm_baseline_kernel.h"
#include "gemm_tiling.h"

#define CHECK_ACL_THROW(call)                                                   \
    do {                                                                        \
        const aclError ret = (call);                                            \
        if (ret != ACL_SUCCESS) {                                               \
            throw std::runtime_error(std::string("ACL call failed: ") + #call); \
        }                                                                       \
    } while (0)

namespace {

constexpr uint32_t kDefaultBlockDim = 8;
constexpr size_t kWorkspaceBytes = 32;

void CheckInput(const torch::Tensor &a, const torch::Tensor &b)
{
    TORCH_CHECK(a.device().type() == c10::DeviceType::PrivateUse1, "a must be an NPU tensor");
    TORCH_CHECK(b.device().type() == c10::DeviceType::PrivateUse1, "b must be an NPU tensor");
    TORCH_CHECK(a.dim() == 2, "a must be 2D [M, K]");
    TORCH_CHECK(b.dim() == 2, "b must be 2D [K, N]");
    TORCH_CHECK(a.scalar_type() == at::ScalarType::Float, "a must be float32");
    TORCH_CHECK(b.scalar_type() == at::ScalarType::Float, "b must be float32");
    TORCH_CHECK(a.size(1) == b.size(0), "shape mismatch: A[M,K] @ B[K,N]");
    TORCH_CHECK(a.is_contiguous(), "a must be contiguous");
    TORCH_CHECK(b.is_contiguous(), "b must be contiguous");
    TORCH_CHECK(a.size(0) > 0 && a.size(1) > 0 && b.size(1) > 0, "empty matrix is not supported");
    TORCH_CHECK(a.size(0) <= std::numeric_limits<uint32_t>::max(), "M is too large");
    TORCH_CHECK(a.size(1) <= std::numeric_limits<uint32_t>::max(), "K is too large");
    TORCH_CHECK(b.size(1) <= std::numeric_limits<uint32_t>::max(), "N is too large");
}

GemmBaselineTiling BuildTiling(uint32_t m, uint32_t n, uint32_t k)
{
    const uint32_t coreNum = std::max(1U, std::min(kDefaultBlockDim, m));
    GemmBaselineTiling tiling {};
    tiling.m = m;
    tiling.n = n;
    tiling.k = k;
    tiling.coreNum = coreNum;
    tiling.rowsPerCore = (m + coreNum - 1U) / coreNum;
    return tiling;
}

}  // namespace

torch::Tensor gemm_baseline_npu(const torch::Tensor &a, const torch::Tensor &b)
{
    CheckInput(a, b);

    const int32_t deviceIndex = a.device().index() < 0 ? 0 : a.device().index();
    CHECK_ACL_THROW(aclrtSetDevice(deviceIndex));

    const uint32_t m = static_cast<uint32_t>(a.size(0));
    const uint32_t k = static_cast<uint32_t>(a.size(1));
    const uint32_t n = static_cast<uint32_t>(b.size(1));
    auto c = torch::empty({a.size(0), b.size(1)}, a.options());

    const GemmBaselineTiling tiling = BuildTiling(m, n, k);
    void *workspaceD = nullptr;
    void *tilingD = nullptr;

    CHECK_ACL_THROW(aclrtMalloc(&workspaceD, kWorkspaceBytes, ACL_MEM_MALLOC_NORMAL_ONLY));
    CHECK_ACL_THROW(aclrtMalloc(&tilingD, sizeof(GemmBaselineTiling), ACL_MEM_MALLOC_NORMAL_ONLY));
    CHECK_ACL_THROW(aclrtMemcpy(
        tilingD,
        sizeof(GemmBaselineTiling),
        &tiling,
        sizeof(GemmBaselineTiling),
        ACL_MEMCPY_HOST_TO_DEVICE));

    aclrtStream stream = c10_npu::getCurrentNPUStream().stream();

    const uint32_t launchRet = ACLRT_LAUNCH_KERNEL(gemm_baseline_kernel)(
        tiling.coreNum,
        stream,
        static_cast<uint8_t *>(a.data_ptr()),
        static_cast<uint8_t *>(b.data_ptr()),
        static_cast<uint8_t *>(c.data_ptr()),
        static_cast<uint8_t *>(workspaceD),
        static_cast<uint8_t *>(tilingD));

    TORCH_CHECK(launchRet == 0, "gemm_baseline_kernel launch failed, ret=", launchRet);

    CHECK_ACL_THROW(aclrtSynchronizeStream(stream));
    CHECK_ACL_THROW(aclrtFree(tilingD));
    CHECK_ACL_THROW(aclrtFree(workspaceD));

    return c;
}

TORCH_LIBRARY(gemm_custom, m) {
    m.def("gemm(Tensor a, Tensor b) -> Tensor");
}

TORCH_LIBRARY_IMPL(gemm_custom, PrivateUse1, m) {
    m.impl("gemm", gemm_baseline_npu);
}