#include <torch/extension.h>
#include <acl/acl.h>
#include <acl/acl_rt.h>

#include <algorithm>
#include <cstdint>
#include <limits>
#include <stdexcept>
#include <string>

#include "torch_npu/csrc/core/npu/NPUStream.h"

#include "aclrtlaunch_swiglu_baseline_kernel.h"
#include "swiglu_tiling.h"

#define CHECK_ACL_THROW(call)                                                   \
    do {                                                                        \
        const aclError ret = (call);                                            \
        if (ret != ACL_SUCCESS) {                                               \
            throw std::runtime_error(std::string("ACL call failed: ") + #call); \
        }                                                                       \
    } while (0)

namespace {

constexpr uint32_t kDefaultBlockDim = 8;
constexpr size_t kWorkspaceBytes = 32;

void CheckInput(const torch::Tensor &gate, const torch::Tensor &up)
{
    TORCH_CHECK(gate.device().type() == c10::DeviceType::PrivateUse1, "gate must be an NPU tensor");
    TORCH_CHECK(up.device().type() == c10::DeviceType::PrivateUse1, "up must be an NPU tensor");
    TORCH_CHECK(gate.scalar_type() == at::ScalarType::Float, "gate must be float32");
    TORCH_CHECK(up.scalar_type() == at::ScalarType::Float, "up must be float32");
    TORCH_CHECK(gate.sizes() == up.sizes(), "gate and up must have the same shape");
    TORCH_CHECK(gate.is_contiguous(), "gate must be contiguous");
    TORCH_CHECK(up.is_contiguous(), "up must be contiguous");
    TORCH_CHECK(gate.numel() > 0, "input must not be empty");
    TORCH_CHECK(gate.numel() <= static_cast<int64_t>(std::numeric_limits<uint32_t>::max()),
        "input is too large for uint32 tiling");
}

SwiGluTiling BuildTiling(uint32_t totalSize)
{
    const uint32_t coreNum = std::max(1U, std::min(kDefaultBlockDim, totalSize));
    SwiGluTiling tiling {};
    tiling.totalSize = totalSize;
    tiling.coreNum = coreNum;
    tiling.elementsPerCore = (totalSize + coreNum - 1U) / coreNum;
    return tiling;
}

}  // namespace

torch::Tensor swiglu_baseline_npu(const torch::Tensor &gate, const torch::Tensor &up)
{
    CheckInput(gate, up);

    const int32_t deviceIndex = gate.device().index() < 0 ? 0 : gate.device().index();
    CHECK_ACL_THROW(aclrtSetDevice(deviceIndex));

    auto output = torch::empty_like(gate);
    const uint32_t totalSize = static_cast<uint32_t>(gate.numel());
    const SwiGluTiling tiling = BuildTiling(totalSize);

    void *workspaceD = nullptr;
    void *tilingD = nullptr;

    CHECK_ACL_THROW(aclrtMalloc(&workspaceD, kWorkspaceBytes, ACL_MEM_MALLOC_NORMAL_ONLY));
    CHECK_ACL_THROW(aclrtMalloc(&tilingD, sizeof(SwiGluTiling), ACL_MEM_MALLOC_NORMAL_ONLY));
    CHECK_ACL_THROW(aclrtMemcpy(
        tilingD,
        sizeof(SwiGluTiling),
        &tiling,
        sizeof(SwiGluTiling),
        ACL_MEMCPY_HOST_TO_DEVICE));

    aclrtStream stream = c10_npu::getCurrentNPUStream().stream();

    const uint32_t launchRet = ACLRT_LAUNCH_KERNEL(swiglu_baseline_kernel)(
        tiling.coreNum,
        stream,
        static_cast<uint8_t *>(gate.data_ptr()),
        static_cast<uint8_t *>(up.data_ptr()),
        static_cast<uint8_t *>(output.data_ptr()),
        static_cast<uint8_t *>(workspaceD),
        static_cast<uint8_t *>(tilingD));

    TORCH_CHECK(launchRet == 0, "swiglu_baseline_kernel launch failed, ret=", launchRet);

    CHECK_ACL_THROW(aclrtSynchronizeStream(stream));
    CHECK_ACL_THROW(aclrtFree(tilingD));
    CHECK_ACL_THROW(aclrtFree(workspaceD));

    return output;
}

TORCH_LIBRARY(swiglu_custom, m) {
    m.def("swiglu(Tensor gate, Tensor up) -> Tensor");
}

TORCH_LIBRARY_IMPL(swiglu_custom, PrivateUse1, m) {
    m.impl("swiglu", swiglu_baseline_npu);
}