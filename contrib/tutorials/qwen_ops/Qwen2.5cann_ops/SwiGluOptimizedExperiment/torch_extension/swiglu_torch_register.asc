#include <torch/extension.h>
#include <acl/acl.h>
#include <acl/acl_rt.h>

#include <algorithm>
#include <cstdint>
#include <stdexcept>
#include <string>

#include "torch_npu/csrc/core/npu/NPUStream.h"

#include "swiglu_tiling.h"
#include "aclrtlaunch_swiglu_optimized_kernel.h"

namespace {

constexpr uint32_t kDefaultBlockDim = 8;
constexpr uint32_t kDefaultTileLength = 1024;
constexpr uint32_t kMinElementsPerCore = 8;
constexpr size_t kWorkspaceBytes = 32;

#define CHECK_ACL_THROW(call)                                                   \
    do {                                                                        \
        const aclError ret = (call);                                            \
        if (ret != ACL_SUCCESS) {                                               \
            throw std::runtime_error(std::string("ACL call failed: ") + #call); \
        }                                                                       \
    } while (0)

void CheckInput(const torch::Tensor &gate, const torch::Tensor &up)
{
    TORCH_CHECK(gate.device().type() == c10::DeviceType::PrivateUse1, "gate must be an NPU tensor");
    TORCH_CHECK(up.device().type() == c10::DeviceType::PrivateUse1, "up must be an NPU tensor");
    TORCH_CHECK(gate.scalar_type() == at::ScalarType::Float, "gate must be float32");
    TORCH_CHECK(up.scalar_type() == at::ScalarType::Float, "up must be float32");
    TORCH_CHECK(gate.sizes() == up.sizes(), "gate and up must have the same shape");
    TORCH_CHECK(gate.is_contiguous(), "gate must be contiguous");
    TORCH_CHECK(up.is_contiguous(), "up must be contiguous");
    TORCH_CHECK(gate.numel() > 0, "input must not be empty");
    TORCH_CHECK(gate.numel() <= static_cast<int64_t>(UINT32_MAX), "input is too large for uint32 tiling");
}

uint32_t SelectBlockDim(uint32_t totalSize)
{
    uint32_t blockDim = totalSize / kMinElementsPerCore;
    if (blockDim == 0) {
        blockDim = 1;
    }
    return std::min(kDefaultBlockDim, blockDim);
}

SwiGluTilingData BuildTiling(uint32_t totalSize, uint32_t blockDim)
{
    SwiGluTilingData tiling {};
    tiling.totalSize = totalSize;
    tiling.coreNum = blockDim;
    tiling.elementsPerCore = (totalSize + blockDim - 1U) / blockDim;
    tiling.tileLength = kDefaultTileLength;
    return tiling;
}

}  // namespace

torch::Tensor SwiGluOptimized(const torch::Tensor &gate, const torch::Tensor &up)
{
    CheckInput(gate, up);

    const int32_t deviceIndex = gate.device().index() < 0 ? 0 : gate.device().index();
    CHECK_ACL_THROW(aclrtSetDevice(deviceIndex));

    auto output = torch::zeros_like(gate);

    const uint32_t totalSize = static_cast<uint32_t>(gate.numel());
    const uint32_t blockDim = SelectBlockDim(totalSize);
    const SwiGluTilingData tiling = BuildTiling(totalSize, blockDim);

    void *workspaceDev = nullptr;
    void *tilingDev = nullptr;

    CHECK_ACL_THROW(aclrtMalloc(&workspaceDev, kWorkspaceBytes, ACL_MEM_MALLOC_NORMAL_ONLY));
    CHECK_ACL_THROW(aclrtMalloc(&tilingDev, sizeof(SwiGluTilingData), ACL_MEM_MALLOC_NORMAL_ONLY));
    CHECK_ACL_THROW(aclrtMemcpy(
        tilingDev,
        sizeof(SwiGluTilingData),
        &tiling,
        sizeof(SwiGluTilingData),
        ACL_MEMCPY_HOST_TO_DEVICE));

    aclrtStream stream = c10_npu::getCurrentNPUStream().stream();

    const uint32_t launchRet = ACLRT_LAUNCH_KERNEL(swiglu_optimized_kernel)(
        blockDim,
        stream,
        static_cast<uint8_t *>(gate.data_ptr()),
        static_cast<uint8_t *>(up.data_ptr()),
        static_cast<uint8_t *>(output.data_ptr()),
        static_cast<uint8_t *>(workspaceDev),
        static_cast<uint8_t *>(tilingDev));

    TORCH_CHECK(launchRet == 0, "swiglu_optimized_kernel launch failed, ret=", launchRet);

    CHECK_ACL_THROW(aclrtSynchronizeStream(stream));
    CHECK_ACL_THROW(aclrtFree(tilingDev));
    CHECK_ACL_THROW(aclrtFree(workspaceDev));

    return output;
}

TORCH_LIBRARY(swiglu_custom, m)
{
    m.def("swiglu(Tensor gate, Tensor up) -> Tensor");
}

TORCH_LIBRARY_IMPL(swiglu_custom, PrivateUse1, m)
{
    m.impl("swiglu", SwiGluOptimized);
}