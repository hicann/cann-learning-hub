#include <torch/extension.h>
#include <acl/acl.h>
#include <acl/acl_rt.h>

#include <algorithm>
#include <cstdint>
#include <stdexcept>
#include <string>

#include "torch_npu/csrc/core/npu/NPUStream.h"

#include "aclrtlaunch_gemm_optimized_kernel.h"
#include "gemm_tiling.h"

namespace {

constexpr uint32_t kDefaultBlockDim = 16;
constexpr uint32_t kTileM = 8;
constexpr uint32_t kTileN = 8;
constexpr uint32_t kTileK = 128;
constexpr size_t kWorkspaceBytes = 32;

#define CHECK_ACL_THROW(call)                                                   \
    do {                                                                        \
        const aclError ret = (call);                                            \
        if (ret != ACL_SUCCESS) {                                               \
            throw std::runtime_error(std::string("ACL call failed: ") + #call); \
        }                                                                       \
    } while (0)

void CheckInput(const torch::Tensor &a, const torch::Tensor &b)
{
    TORCH_CHECK(a.device().type() == c10::DeviceType::PrivateUse1, "a must be an NPU tensor");
    TORCH_CHECK(b.device().type() == c10::DeviceType::PrivateUse1, "b must be an NPU tensor");
    TORCH_CHECK(a.scalar_type() == at::ScalarType::Float, "a must be float32");
    TORCH_CHECK(b.scalar_type() == at::ScalarType::Float, "b must be float32");
    TORCH_CHECK(a.dim() == 2, "a must be 2D");
    TORCH_CHECK(b.dim() == 2, "b must be 2D");
    TORCH_CHECK(a.size(1) == b.size(0), "shape mismatch: a[M,K] and b[K,N]");
    TORCH_CHECK(a.is_contiguous(), "a must be contiguous");
    TORCH_CHECK(b.is_contiguous(), "b must be contiguous");
    TORCH_CHECK(a.size(0) > 0 && a.size(1) > 0 && b.size(1) > 0, "empty matrix is not supported");
}

GemmOptimizedTiling BuildTiling(uint32_t m, uint32_t n, uint32_t k, uint32_t blockDim)
{
    GemmOptimizedTiling t {};
    t.m = m;
    t.n = n;
    t.k = k;
    t.coreNum = std::max(1U, std::min(blockDim, 32U));
    t.tileM = kTileM;
    t.tileN = kTileN;
    t.tileK = kTileK;

    const uint32_t mTiles = (t.m + t.tileM - 1U) / t.tileM;
    const uint32_t nTiles = (t.n + t.tileN - 1U) / t.tileN;
    t.totalTiles = mTiles * nTiles;
    return t;
}

}  // namespace

torch::Tensor GemmOptimized(const torch::Tensor &a, const torch::Tensor &b)
{
    CheckInput(a, b);

    const uint32_t m = static_cast<uint32_t>(a.size(0));
    const uint32_t k = static_cast<uint32_t>(a.size(1));
    const uint32_t n = static_cast<uint32_t>(b.size(1));

    auto aContig = a.contiguous();
    auto bTrans = b.transpose(0, 1).contiguous();
    auto c = torch::empty({a.size(0), b.size(1)}, a.options());

    GemmOptimizedTiling tiling = BuildTiling(m, n, k, kDefaultBlockDim);
    const uint32_t realBlockDim = std::min(tiling.coreNum, tiling.totalTiles);

    void *workspaceDev = nullptr;
    void *tilingDev = nullptr;

    CHECK_ACL_THROW(aclrtMalloc(&workspaceDev, kWorkspaceBytes, ACL_MEM_MALLOC_NORMAL_ONLY));
    CHECK_ACL_THROW(aclrtMalloc(&tilingDev, sizeof(GemmOptimizedTiling), ACL_MEM_MALLOC_NORMAL_ONLY));
    CHECK_ACL_THROW(aclrtMemcpy(
        tilingDev,
        sizeof(GemmOptimizedTiling),
        &tiling,
        sizeof(GemmOptimizedTiling),
        ACL_MEMCPY_HOST_TO_DEVICE));

    aclrtStream stream = c10_npu::getCurrentNPUStream().stream();

    const uint32_t launchRet = ACLRT_LAUNCH_KERNEL(gemm_optimized_kernel)(
        realBlockDim,
        stream,
        static_cast<uint8_t *>(aContig.data_ptr()),
        static_cast<uint8_t *>(bTrans.data_ptr()),
        static_cast<uint8_t *>(c.data_ptr()),
        static_cast<uint8_t *>(workspaceDev),
        static_cast<uint8_t *>(tilingDev));

    TORCH_CHECK(launchRet == 0, "gemm_optimized_kernel launch failed, ret=", launchRet);

    CHECK_ACL_THROW(aclrtSynchronizeStream(stream));
    CHECK_ACL_THROW(aclrtFree(tilingDev));
    CHECK_ACL_THROW(aclrtFree(workspaceDev));

    return c;
}

TORCH_LIBRARY(gemm_custom, m)
{
    m.def("gemm(Tensor a, Tensor b) -> Tensor");
}

TORCH_LIBRARY_IMPL(gemm_custom, PrivateUse1, m)
{
    m.impl("gemm", GemmOptimized);
}