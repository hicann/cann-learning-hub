// RoPE 通用版 — PyTorch C++ 算子注册 (TORCH_LIBRARY)
//
// 编译为 librope_torch_register.so, 由 Python 侧 torch.ops.load_library() 加载。
// 加载后可通过 torch.ops.qwen_rope_custom.rope_baseline(x, cos, sin) 直接调用。
//
// 架构: PyTorch tensor → ACLRT H2D → kernel launch → D2H → PyTorch tensor
// (未来: 接入 torch_npu 后可消除 D2H, 输出留 device 上)

#include <torch/library.h>
#include <ATen/ATen.h>
#include <c10/util/Exception.h>

#include <algorithm>
#include <cstdint>
#include <cstring>

#include "acl/acl.h"
#include "aclrtlaunch_rope_baseline_kernel.h"


// ═══════════════════════════════════════════════════════════════
//  Tiling 结构 — 与 kernel 端 RoPeTiling 逐字节一致
// ═══════════════════════════════════════════════════════════════
#pragma pack(push, 1)
struct RoPeTiling {
    uint32_t totalTokens = 0;
    uint32_t headDim     = 0;
    uint32_t coreNum     = 1;
    uint32_t rowsPerCore = 0;
};
#pragma pack(pop)


// ═══════════════════════════════════════════════════════════════
//  ACL 错误检查
// ═══════════════════════════════════════════════════════════════
#define CHECK_ACL(call)                                                   \
    do {                                                                  \
        const aclError _ret = (call);                                     \
        if (_ret != 0) {                                                  \
            AT_ERROR("ACL error ", #call, " ret=", static_cast<int>(_ret)); \
        }                                                                 \
    } while (0)


// ═══════════════════════════════════════════════════════════════
//  ACL 单例 + 缓存 device buffer (消除 per-call alloc/free 开销)
// ═══════════════════════════════════════════════════════════════
static aclrtStream g_acl_stream = nullptr;
static bool       g_acl_inited  = false;
static void      *g_xD = nullptr, *g_cD = nullptr, *g_sD = nullptr,
                 *g_yD = nullptr, *g_wD = nullptr, *g_tD = nullptr;
static size_t     g_bufBytes = 0;

static void acl_init_once() {
    if (g_acl_inited) return;
    // The standalone path owns ACL initialization; the five-operator Qwen
    // integration is entered through torch_npu, which has already initialized
    // the same ACL runtime.  Both cases use the identical kernel/tiling path.
    const aclError init_ret = aclInit(nullptr);
    if (init_ret != ACL_SUCCESS && init_ret != ACL_ERROR_REPEAT_INITIALIZE) {
        AT_ERROR("ACL error aclInit(nullptr) ret=", static_cast<int>(init_ret));
    }
    CHECK_ACL(aclrtSetDevice(0));
    CHECK_ACL(aclrtCreateStream(&g_acl_stream));
    // pre-alloc tiny workspace + tiling (never changes size)
    CHECK_ACL(aclrtMalloc(&g_wD, 32, ACL_MEM_MALLOC_NORMAL_ONLY));
    CHECK_ACL(aclrtMalloc(&g_tD, sizeof(RoPeTiling), ACL_MEM_MALLOC_NORMAL_ONLY));
    g_acl_inited = true;
}

static void ensure_buffers(size_t bytes) {
    if (bytes <= g_bufBytes) return;  // 已有足够大
    // free old
    if (g_xD) { aclrtFree(g_xD); g_xD = nullptr; }
    if (g_cD) { aclrtFree(g_cD); g_cD = nullptr; }
    if (g_sD) { aclrtFree(g_sD); g_sD = nullptr; }
    if (g_yD) { aclrtFree(g_yD); g_yD = nullptr; }
    // alloc new
    CHECK_ACL(aclrtMalloc(&g_xD, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(&g_cD, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(&g_sD, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(&g_yD, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    g_bufBytes = bytes;
}


// ═══════════════════════════════════════════════════════════════
//  算子实现: y = x * cos + rotate_half(x) * sin
// ═══════════════════════════════════════════════════════════════
static at::Tensor rope_baseline_npu(
    const at::Tensor &x,
    const at::Tensor &cos,
    const at::Tensor &sin)
{
    acl_init_once();

    // 维度
    const int64_t totalTokens = x.size(0);
    const int64_t headDim     = x.size(1);
    const int64_t nElems      = totalTokens * headDim;
    const size_t  bufBytes    = static_cast<size_t>(nElems) * sizeof(float);

    // 确保 contiguous float32
    auto x_c   = x.contiguous().to(at::kFloat);
    auto cos_c = cos.contiguous().to(at::kFloat);
    auto sin_c = sin.contiguous().to(at::kFloat);

    // ── 动态 tiling ──────────────────────────────────────
    uint32_t coreNum = static_cast<uint32_t>(std::min<int64_t>(8, totalTokens));
    coreNum = std::max(1u, coreNum);

    RoPeTiling tiling;
    tiling.totalTokens = static_cast<uint32_t>(totalTokens);
    tiling.headDim     = static_cast<uint32_t>(headDim);
    tiling.coreNum     = coreNum;
    tiling.rowsPerCore = (static_cast<uint32_t>(totalTokens) + coreNum - 1u) / coreNum;

    // ── 分配 device 内存 (缓存复用, 仅在尺寸变大时 realloc) ──
    ensure_buffers(bufBytes);

    CHECK_ACL(aclrtMemcpy(g_xD, bufBytes, x_c.data_ptr(),  bufBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(g_cD, bufBytes, cos_c.data_ptr(), bufBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(g_sD, bufBytes, sin_c.data_ptr(), bufBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(g_tD, sizeof(tiling), &tiling, sizeof(tiling), ACL_MEMCPY_HOST_TO_DEVICE));

    ACLRT_LAUNCH_KERNEL(rope_baseline_kernel)(
        coreNum, g_acl_stream, g_xD, g_cD, g_sD, g_yD, g_wD, g_tD);
    CHECK_ACL(aclrtSynchronizeStream(g_acl_stream));

    auto y = at::empty({totalTokens, headDim}, at::kFloat);
    CHECK_ACL(aclrtMemcpy(y.data_ptr(), bufBytes, g_yD, bufBytes, ACL_MEMCPY_DEVICE_TO_HOST));

    return y;
}


// ═══════════════════════════════════════════════════════════════
//  TORCH_LIBRARY: 算子定义 + 实现注册
//  .so 被 torch.ops.load_library() 加载时自动执行
// ═══════════════════════════════════════════════════════════════
TORCH_LIBRARY(qwen_rope_custom, m) {
    m.def("rope_baseline(Tensor x, Tensor cos, Tensor sin) -> Tensor");
}

TORCH_LIBRARY_IMPL(qwen_rope_custom, CompositeExplicitAutograd, m) {
    m.impl("rope_baseline", rope_baseline_npu);
}
