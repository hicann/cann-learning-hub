#include <algorithm>
#include <chrono>
#include <cmath>
#include <cstdint>
#include <cstdlib>
#include <iomanip>
#include <iostream>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "kernel_operator.h"

#ifndef PIPELINE_BUFFER_NUM
#define PIPELINE_BUFFER_NUM 1
#endif

constexpr int32_t kBufferNum = PIPELINE_BUFFER_NUM;
constexpr int32_t kQueueDepth = 1;
constexpr uint32_t kDefaultBlockDim = 8;
constexpr uint32_t kDefaultTileCount = 8;
constexpr uint64_t kUbBudgetBytes = 192ULL * 1024ULL;

static_assert(kBufferNum == 1 || kBufferNum == 2,
    "PIPELINE_BUFFER_NUM must be 1 or 2");

#if PIPELINE_BUFFER_NUM == 1
constexpr const char *kScheduleName = "sequential";
#elif PIPELINE_BUFFER_NUM == 2
constexpr const char *kScheduleName = "prefetch";
#else
#error "unsupported PIPELINE_BUFFER_NUM"
#endif

struct VectorAddTilingData {
    uint32_t totalLength;
    uint32_t tileCount;
};

class KernelVectorAddPipeline {
public:
    __aicore__ inline KernelVectorAddPipeline() {}

    __aicore__ inline void Init(
        GM_ADDR x,
        GM_ADDR y,
        GM_ADDR z,
        uint32_t totalLength,
        uint32_t tileCount)
    {
        blockLength_ = totalLength / AscendC::GetBlockNum();
        tileCount_ = tileCount;
        tileLength_ = blockLength_ / tileCount_;

        const uint32_t blockOffset = blockLength_ * AscendC::GetBlockIdx();
        xGm_.SetGlobalBuffer((__gm__ float *)x + blockOffset, blockLength_);
        yGm_.SetGlobalBuffer((__gm__ float *)y + blockOffset, blockLength_);
        zGm_.SetGlobalBuffer((__gm__ float *)z + blockOffset, blockLength_);

        // TQue 的模板参数是队列深度。本实验的调度在任一时刻每个
        // 队列至多保留一个已入队 Tensor，因此 depth 固定为 1。
        // InitBuffer 的第二个参数才决定物理 Buffer 数量。
        pipe_.InitBuffer(inQueueX_, kBufferNum, tileLength_ * sizeof(float));
        pipe_.InitBuffer(inQueueY_, kBufferNum, tileLength_ * sizeof(float));
        pipe_.InitBuffer(outQueueZ_, kBufferNum, tileLength_ * sizeof(float));
    }

    __aicore__ inline void Process()
    {
#if PIPELINE_BUFFER_NUM == 1
        ProcessSequential();
#else
        ProcessPrefetch();
#endif
    }

private:
    __aicore__ inline void ProcessSequential()
    {
        for (uint32_t tile = 0; tile < tileCount_; ++tile) {
            CopyIn(tile);
            AscendC::LocalTensor<float> xLocal = DeQueX();
            AscendC::LocalTensor<float> yLocal = DeQueY();
            Compute(xLocal, yLocal);
            CopyOut(tile);
        }
    }

    __aicore__ inline void ProcessPrefetch()
    {
        // Prologue：先让 Tile 0 进入输入队列。
        CopyIn(0);

        for (uint32_t tile = 0; tile < tileCount_; ++tile) {
            // 先取出当前 Tile，使 depth=1 的输入队列变为空；当前
            // LocalTensor 仍占用物理槽位 0，随后预取会使用槽位 1。
            AscendC::LocalTensor<float> xLocal = DeQueX();
            AscendC::LocalTensor<float> yLocal = DeQueY();

            if (tile + 1 < tileCount_) {
                CopyIn(tile + 1);
            }
            if (tile > 0) {
                CopyOut(tile - 1);
            }
            Compute(xLocal, yLocal);
        }

        // Epilogue：循环内只写回到倒数第二个 Tile，最后一个需排空。
        CopyOut(tileCount_ - 1);
    }

    __aicore__ inline void CopyIn(uint32_t tile)
    {
        AscendC::LocalTensor<float> xLocal = inQueueX_.AllocTensor<float>();
        AscendC::LocalTensor<float> yLocal = inQueueY_.AllocTensor<float>();
        const uint32_t offset = tile * tileLength_;
        AscendC::DataCopy(xLocal, xGm_[offset], tileLength_);
        AscendC::DataCopy(yLocal, yGm_[offset], tileLength_);
        inQueueX_.EnQue(xLocal);
        inQueueY_.EnQue(yLocal);
    }

    __aicore__ inline AscendC::LocalTensor<float> DeQueX()
    {
        return inQueueX_.DeQue<float>();
    }

    __aicore__ inline AscendC::LocalTensor<float> DeQueY()
    {
        return inQueueY_.DeQue<float>();
    }

    __aicore__ inline void Compute(
        AscendC::LocalTensor<float> xLocal,
        AscendC::LocalTensor<float> yLocal)
    {
        AscendC::LocalTensor<float> zLocal = outQueueZ_.AllocTensor<float>();
        AscendC::Add(zLocal, xLocal, yLocal, tileLength_);
        outQueueZ_.EnQue(zLocal);
        inQueueX_.FreeTensor(xLocal);
        inQueueY_.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyOut(uint32_t tile)
    {
        AscendC::LocalTensor<float> zLocal = outQueueZ_.DeQue<float>();
        const uint32_t offset = tile * tileLength_;
        AscendC::DataCopy(zGm_[offset], zLocal, tileLength_);
        outQueueZ_.FreeTensor(zLocal);
    }

private:
    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::TPosition::VECIN, kQueueDepth> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECIN, kQueueDepth> inQueueY_;
    AscendC::TQue<AscendC::TPosition::VECOUT, kQueueDepth> outQueueZ_;
    AscendC::GlobalTensor<float> xGm_;
    AscendC::GlobalTensor<float> yGm_;
    AscendC::GlobalTensor<float> zGm_;
    uint32_t blockLength_ = 0;
    uint32_t tileCount_ = 0;
    uint32_t tileLength_ = 0;
};

__global__ __aicore__ void vector_add_pipeline(
    GM_ADDR x,
    GM_ADDR y,
    GM_ADDR z,
    VectorAddTilingData tiling)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    KernelVectorAddPipeline op;
    op.Init(x, y, z, tiling.totalLength, tiling.tileCount);
    op.Process();
}

struct Options {
    uint32_t length = kDefaultBlockDim * 2048;
    uint32_t blockDim = kDefaultBlockDim;
    uint32_t tileCount = kDefaultTileCount;
    uint32_t warmup = 5;
    uint32_t iterations = 50;
    uint32_t seed = 1;
};

bool ParseUnsigned(const char *text, uint32_t &value)
{
    char *end = nullptr;
    const unsigned long parsed = std::strtoul(text, &end, 10);
    if (text == end || *end != '\0' || parsed == 0 || parsed > UINT32_MAX) {
        return false;
    }
    value = static_cast<uint32_t>(parsed);
    return true;
}

bool ParseOptions(int argc, char **argv, Options &options)
{
    for (int i = 1; i < argc; i += 2) {
        if (i + 1 >= argc) {
            return false;
        }
        uint32_t value = 0;
        if (!ParseUnsigned(argv[i + 1], value)) {
            return false;
        }
        const std::string name(argv[i]);
        if (name == "--length") {
            options.length = value;
        } else if (name == "--block-dim") {
            options.blockDim = value;
        } else if (name == "--tile-count") {
            options.tileCount = value;
        } else if (name == "--warmup") {
            options.warmup = value;
        } else if (name == "--iterations") {
            options.iterations = value;
        } else if (name == "--seed") {
            options.seed = value;
        } else {
            return false;
        }
    }
    return true;
}

bool ValidateShape(const Options &options)
{
    if (options.length % options.blockDim != 0) {
        std::cerr << "length must be divisible by blockDim="
                  << options.blockDim << std::endl;
        return false;
    }
    const uint32_t blockLength = options.length / options.blockDim;
    if (blockLength % options.tileCount != 0) {
        std::cerr << "block length must be divisible by tileCount" << std::endl;
        return false;
    }
    const uint32_t tileLength = blockLength / options.tileCount;
    const uint64_t tileBytes = static_cast<uint64_t>(tileLength) * sizeof(float);
    if (tileBytes % 32 != 0) {
        std::cerr << "each DataCopy length must be 32-byte aligned" << std::endl;
        return false;
    }
    const uint64_t queueBytes = 3ULL * static_cast<uint64_t>(kBufferNum) * tileBytes;
    if (queueBytes > kUbBudgetBytes) {
        std::cerr << "queue allocation exceeds 192 KiB UB budget" << std::endl;
        return false;
    }
    return true;
}

void FillInput(std::vector<float> &x, std::vector<float> &y, uint32_t seed)
{
    for (uint32_t i = 0; i < x.size(); ++i) {
        const int32_t rawX = static_cast<int32_t>((i * 17U + seed * 13U) % 127U) - 63;
        const int32_t rawY = static_cast<int32_t>((i * 29U + seed * 7U) % 113U) - 56;
        x[i] = static_cast<float>(rawX) / 16.0F;
        y[i] = static_cast<float>(rawY) / 32.0F;
    }
}

struct AclResources {
    explicit AclResources(int32_t deviceIdValue) : deviceId(deviceIdValue) {}
    AclResources(const AclResources &) = delete;
    AclResources &operator=(const AclResources &) = delete;

    ~AclResources()
    {
        Cleanup();
    }

    bool Initialize(size_t bytes)
    {
        if (aclInit(nullptr) != ACL_SUCCESS) {
            return false;
        }
        aclInitialized = true;
        if (aclrtSetDevice(deviceId) != ACL_SUCCESS) {
            return false;
        }
        deviceSet = true;
        if (aclrtCreateStream(&stream) != ACL_SUCCESS) {
            return false;
        }
        return aclrtMalloc(reinterpret_cast<void **>(&xDevice), bytes,
                   ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS &&
            aclrtMalloc(reinterpret_cast<void **>(&yDevice), bytes,
                   ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS &&
            aclrtMalloc(reinterpret_cast<void **>(&zDevice), bytes,
                   ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS;
    }

    bool Cleanup()
    {
        bool success = true;
        if (zDevice != nullptr) {
            success &= aclrtFree(zDevice) == ACL_SUCCESS;
            zDevice = nullptr;
        }
        if (yDevice != nullptr) {
            success &= aclrtFree(yDevice) == ACL_SUCCESS;
            yDevice = nullptr;
        }
        if (xDevice != nullptr) {
            success &= aclrtFree(xDevice) == ACL_SUCCESS;
            xDevice = nullptr;
        }
        if (stream != nullptr) {
            success &= aclrtDestroyStream(stream) == ACL_SUCCESS;
            stream = nullptr;
        }
        if (deviceSet) {
            success &= aclrtResetDevice(deviceId) == ACL_SUCCESS;
            deviceSet = false;
        }
        if (aclInitialized) {
            success &= aclFinalize() == ACL_SUCCESS;
            aclInitialized = false;
        }
        return success;
    }

    int32_t deviceId;
    bool aclInitialized = false;
    bool deviceSet = false;
    aclrtStream stream = nullptr;
    uint8_t *xDevice = nullptr;
    uint8_t *yDevice = nullptr;
    uint8_t *zDevice = nullptr;
};

int main(int argc, char **argv)
{
    Options options;
    if (!ParseOptions(argc, argv, options) || !ValidateShape(options)) {
        std::cerr << "usage: " << argv[0]
                  << " [--length N] [--block-dim N] [--tile-count N]"
                  << " [--warmup N] [--iterations N] [--seed N]" << std::endl;
        return 2;
    }

    std::vector<float> x(options.length);
    std::vector<float> y(options.length);
    std::vector<float> output(options.length, 0.0F);
    FillInput(x, y, options.seed);

    const size_t bytes = static_cast<size_t>(options.length) * sizeof(float);
    AclResources resources(0);
    if (!resources.Initialize(bytes)) {
        std::cerr << "ACL initialization or allocation failed" << std::endl;
        return 3;
    }
    if (aclrtMemcpy(resources.xDevice, bytes, x.data(), bytes,
            ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS ||
        aclrtMemcpy(resources.yDevice, bytes, y.data(), bytes,
            ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
        std::cerr << "host-to-device copy failed" << std::endl;
        return 3;
    }

    const VectorAddTilingData tiling = {options.length, options.tileCount};
    for (uint32_t i = 0; i < options.warmup; ++i) {
        vector_add_pipeline<<<options.blockDim, nullptr, resources.stream>>>(
            resources.xDevice, resources.yDevice, resources.zDevice, tiling);
    }
    if (aclrtSynchronizeStream(resources.stream) != ACL_SUCCESS) {
        std::cerr << "kernel warmup failed" << std::endl;
        return 3;
    }

    const auto start = std::chrono::steady_clock::now();
    for (uint32_t i = 0; i < options.iterations; ++i) {
        vector_add_pipeline<<<options.blockDim, nullptr, resources.stream>>>(
            resources.xDevice, resources.yDevice, resources.zDevice, tiling);
    }
    if (aclrtSynchronizeStream(resources.stream) != ACL_SUCCESS) {
        std::cerr << "kernel execution failed" << std::endl;
        return 3;
    }
    const auto stop = std::chrono::steady_clock::now();

    if (aclrtMemcpy(output.data(), bytes, resources.zDevice, bytes,
            ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
        std::cerr << "device-to-host copy failed" << std::endl;
        return 3;
    }

    float maxAbsError = 0.0F;
    bool allFinite = true;
    for (uint32_t i = 0; i < options.length; ++i) {
        const float error = std::fabs(output[i] - (x[i] + y[i]));
        if (!std::isfinite(output[i]) || !std::isfinite(error)) {
            allFinite = false;
            break;
        }
        maxAbsError = std::max(maxAbsError, error);
    }
    const bool correct = allFinite && maxAbsError <= 1.0e-6F;
    const uint32_t tileLength = options.length / options.blockDim / options.tileCount;
    const uint64_t tileBytes = static_cast<uint64_t>(tileLength) * sizeof(float);
    const uint64_t queueBytes = 3ULL * static_cast<uint64_t>(kBufferNum) * tileBytes;
    const double totalUs = std::chrono::duration<double, std::micro>(stop - start).count();
    const double averageUs = totalUs / static_cast<double>(options.iterations);
    const double effectiveGbPerSecond =
        (3.0 * static_cast<double>(bytes)) / averageUs / 1000.0;

    if (!resources.Cleanup()) {
        std::cerr << "ACL cleanup failed" << std::endl;
        return 3;
    }

    std::cout << std::fixed << std::setprecision(6)
              << "METRIC buffer_num=" << kBufferNum
              << " queue_depth=" << kQueueDepth
              << " schedule=" << kScheduleName
              << " length=" << options.length
              << " block_dim=" << options.blockDim
              << " tile_count=" << options.tileCount
              << " tile_length=" << tileLength
              << " tile_bytes=" << tileBytes
              << " queue_bytes=" << queueBytes
              << " queue_scope=per_block"
              << " correctness=" << (correct ? "PASS" : "FAIL")
              << " max_abs_error=" << maxAbsError
              << " timing_scope=launch_plus_sync"
              << " avg_kernel_us=" << averageUs
              << " effective_gb_s=" << effectiveGbPerSecond << std::endl;
    return correct ? 0 : 1;
}
