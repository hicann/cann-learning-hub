#include <algorithm>
#include <chrono>
#include <cstdint>
#include <cstdlib>
#include <iomanip>
#include <iostream>
#include <limits>
#include <string>
#include <type_traits>
#include <vector>

#include "acl/acl.h"
#include "kernel_operator.h"

#ifdef STUDENT_MODE
#include "student_compute.h"
#endif

constexpr uint32_t kCopyAlignBytes = 32;
constexpr uint32_t kBlockAlignUnits = 512;
constexpr uint32_t kTileBytes = 8192;
constexpr uint32_t kAvailableVectorCores = 20;
constexpr uint32_t kMinBytesPerCore = 4096;
constexpr uint32_t kGuardBytes = 64;
constexpr uint8_t kGuardValue = 0xA5;
constexpr int32_t kBufferNum = 1;

struct BitmapAndTilingData {
    uint32_t blockFormer;
    uint32_t blockTail;
    uint32_t tileUnits;
};

// CANN 9.0 documents uint16_t as the portable And type for the course's Atlas
// A2 target. Reinterpreting the byte-dense and uint32 bitmap LocalTensors as
// uint16_t preserves every bit, the GM layout, and the physical byte count.
template <typename T>
__aicore__ inline void ComputeSetAnd(
    AscendC::LocalTensor<T> output,
    AscendC::LocalTensor<T> left,
    AscendC::LocalTensor<T> right,
    uint32_t count)
{
    const uint32_t count16 = count * sizeof(T) / sizeof(uint16_t);
    AscendC::And(
        output.template ReinterpretCast<uint16_t>(),
        left.template ReinterpretCast<uint16_t>(),
        right.template ReinterpretCast<uint16_t>(),
        static_cast<int32_t>(count16));
}

template <typename T>
class KernelSetAnd {
public:
    __aicore__ inline KernelSetAnd() {}

    __aicore__ inline void Init(
        GM_ADDR left,
        GM_ADDR right,
        GM_ADDR output,
        BitmapAndTilingData tiling)
    {
        const uint32_t blockIdx = AscendC::GetBlockIdx();
        const uint32_t blockNum = AscendC::GetBlockNum();
#ifdef STUDENT_MODE
        const uint32_t blockOffset = StudentBlockOffset(tiling.blockFormer, blockIdx);
        blockUnits_ = StudentCurrentUnits(
            blockIdx, blockNum, tiling.blockFormer, tiling.blockTail);
#else
        const uint32_t blockOffset = tiling.blockFormer * blockIdx;
        blockUnits_ = (blockIdx + 1U == blockNum) ? tiling.blockTail : tiling.blockFormer;
#endif
        tileUnits_ = tiling.tileUnits;

        leftGm_.SetGlobalBuffer((__gm__ T *)left + blockOffset, blockUnits_);
        rightGm_.SetGlobalBuffer((__gm__ T *)right + blockOffset, blockUnits_);
        outputGm_.SetGlobalBuffer((__gm__ T *)output + blockOffset, blockUnits_);

        // Single buffering keeps this experiment focused on representation and
        // bandwidth. All three queues are still included in the UB budget.
        pipe_.InitBuffer(leftQueue_, kBufferNum, tileUnits_ * sizeof(T));
        pipe_.InitBuffer(rightQueue_, kBufferNum, tileUnits_ * sizeof(T));
        pipe_.InitBuffer(outputQueue_, kBufferNum, tileUnits_ * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        const uint32_t loopCount = (blockUnits_ + tileUnits_ - 1U) / tileUnits_;
        for (uint32_t progress = 0; progress < loopCount; ++progress) {
            const uint32_t offset = progress * tileUnits_;
            const uint32_t remain = blockUnits_ - offset;
            const uint32_t currentUnits = remain < tileUnits_ ? remain : tileUnits_;
            CopyIn(offset, currentUnits);
            Compute(currentUnits);
            CopyOut(offset, currentUnits);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t currentUnits)
    {
        AscendC::LocalTensor<T> leftLocal = leftQueue_.AllocTensor<T>();
        AscendC::LocalTensor<T> rightLocal = rightQueue_.AllocTensor<T>();
        // The Host pads every row to 32 bytes and preserves that alignment in
        // Block/Tile partitioning, so the aligned DataCopy API is sufficient.
        AscendC::DataCopy(leftLocal, leftGm_[offset], currentUnits);
        AscendC::DataCopy(rightLocal, rightGm_[offset], currentUnits);
        leftQueue_.EnQue(leftLocal);
        rightQueue_.EnQue(rightLocal);
    }

    __aicore__ inline void Compute(uint32_t currentUnits)
    {
        AscendC::LocalTensor<T> leftLocal = leftQueue_.DeQue<T>();
        AscendC::LocalTensor<T> rightLocal = rightQueue_.DeQue<T>();
        AscendC::LocalTensor<T> outputLocal = outputQueue_.AllocTensor<T>();
#ifdef STUDENT_MODE
        STUDENT_COMPUTE(outputLocal, leftLocal, rightLocal, currentUnits);
#else
        ComputeSetAnd(outputLocal, leftLocal, rightLocal, currentUnits);
#endif
        outputQueue_.EnQue(outputLocal);
        leftQueue_.FreeTensor(leftLocal);
        rightQueue_.FreeTensor(rightLocal);
    }

    __aicore__ inline void CopyOut(uint32_t offset, uint32_t currentUnits)
    {
        AscendC::LocalTensor<T> outputLocal = outputQueue_.DeQue<T>();
        AscendC::DataCopy(outputGm_[offset], outputLocal, currentUnits);
        outputQueue_.FreeTensor(outputLocal);
    }

private:
    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::TPosition::VECIN, kBufferNum> leftQueue_;
    AscendC::TQue<AscendC::TPosition::VECIN, kBufferNum> rightQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, kBufferNum> outputQueue_;
    AscendC::GlobalTensor<T> leftGm_;
    AscendC::GlobalTensor<T> rightGm_;
    AscendC::GlobalTensor<T> outputGm_;
    uint32_t blockUnits_ = 0;
    uint32_t tileUnits_ = 0;
};

__global__ __aicore__ void dense_and(
    GM_ADDR left, GM_ADDR right, GM_ADDR output, BitmapAndTilingData tiling)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    KernelSetAnd<uint8_t> op;
    op.Init(left, right, output, tiling);
    op.Process();
}

__global__ __aicore__ void bitmap_and(
    GM_ADDR left, GM_ADDR right, GM_ADDR output, BitmapAndTilingData tiling)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    KernelSetAnd<uint32_t> op;
    op.Init(left, right, output, tiling);
    op.Process();
}

struct Options {
    std::string layout = "bitmap";
    uint32_t batch = 256;
    uint32_t universe = 4096;
    uint32_t warmup = 5;
    uint32_t iterations = 20;
    uint32_t seed = 1;
};

bool ParseUint32(const char *text, uint32_t &value)
{
    char *end = nullptr;
    const unsigned long long parsed = std::strtoull(text, &end, 10);
    if (text == end || *end != '\0' || parsed > std::numeric_limits<uint32_t>::max()) {
        return false;
    }
    value = static_cast<uint32_t>(parsed);
    return true;
}

bool ParseOptions(int argc, char **argv, Options &options)
{
    for (int i = 1; i < argc; i += 2) {
        if (i + 1 >= argc) {
            return false;
        }
        const std::string name(argv[i]);
        if (name == "--layout") {
            options.layout = argv[i + 1];
            continue;
        }
        uint32_t value = 0;
        if (!ParseUint32(argv[i + 1], value)) {
            return false;
        }
        if (name == "--batch") {
            options.batch = value;
        } else if (name == "--universe") {
            options.universe = value;
        } else if (name == "--warmup") {
            options.warmup = value;
        } else if (name == "--iterations") {
            options.iterations = value;
        } else if (name == "--seed") {
            options.seed = value;
        } else {
            return false;
        }
    }
    return true;
}

uint64_t CeilDiv(uint64_t value, uint64_t divisor)
{
    return (value + divisor - 1U) / divisor;
}

uint64_t AlignUp(uint64_t value, uint64_t alignment)
{
    return CeilDiv(value, alignment) * alignment;
}

bool ValidateOptions(const Options &options)
{
    if (options.layout != "dense" && options.layout != "bitmap") {
        std::cerr << "layout must be dense or bitmap" << std::endl;
        return false;
    }
    if (options.batch == 0 || options.universe == 0) {
        std::cerr << "batch and universe must be positive" << std::endl;
        return false;
    }
    if (options.iterations == 0) {
        std::cerr << "iterations must be positive" << std::endl;
        return false;
    }
    return true;
}

template <typename T>
struct LayoutPlan {
    uint32_t validUnitsPerRow;
    uint32_t physicalUnitsPerRow;
    uint32_t totalUnits;
    uint32_t blockDim;
    BitmapAndTilingData tiling;
};

template <typename T>
bool MakeLayoutPlan(const Options &options, LayoutPlan<T> &plan)
{
    const uint64_t validUnits = std::is_same<T, uint8_t>::value
        ? static_cast<uint64_t>(options.universe)
        : CeilDiv(options.universe, 32U);
    const uint64_t alignUnits = kCopyAlignBytes / sizeof(T);
    const uint64_t physicalUnits = AlignUp(validUnits, alignUnits);
    const uint64_t totalUnits = static_cast<uint64_t>(options.batch) * physicalUnits;
    if (totalUnits == 0 || totalUnits > std::numeric_limits<uint32_t>::max()) {
        std::cerr << "physical element count exceeds the teaching runner limit" << std::endl;
        return false;
    }

    const uint64_t minUnitsPerCore = CeilDiv(kMinBytesPerCore, sizeof(T));
    const uint64_t targetCores = std::min<uint64_t>(
        kAvailableVectorCores, std::max<uint64_t>(1U, CeilDiv(totalUnits, minUnitsPerCore)));
    const uint64_t blockFormer = AlignUp(CeilDiv(totalUnits, targetCores), kBlockAlignUnits);
    const uint64_t blockDim = CeilDiv(totalUnits, blockFormer);
    const uint64_t blockTail = totalUnits - (blockDim - 1U) * blockFormer;
    const uint64_t tileUnits = kTileBytes / sizeof(T);
    if (blockFormer > std::numeric_limits<uint32_t>::max()) {
        std::cerr << "block partition exceeds the teaching runner limit" << std::endl;
        return false;
    }

    plan.validUnitsPerRow = static_cast<uint32_t>(validUnits);
    plan.physicalUnitsPerRow = static_cast<uint32_t>(physicalUnits);
    plan.totalUnits = static_cast<uint32_t>(totalUnits);
    plan.blockDim = static_cast<uint32_t>(blockDim);
    plan.tiling = {
        static_cast<uint32_t>(blockFormer),
        static_cast<uint32_t>(blockTail),
        static_cast<uint32_t>(tileUnits),
    };
    return true;
}

bool MemberLeft(uint32_t row, uint32_t value, uint32_t seed)
{
    return (static_cast<uint64_t>(row) * 17U + static_cast<uint64_t>(value) * 29U +
        static_cast<uint64_t>(seed) * 13U) % 100U < 47U;
}

bool MemberRight(uint32_t row, uint32_t value, uint32_t seed)
{
    return (static_cast<uint64_t>(row) * 31U + static_cast<uint64_t>(value) * 19U +
        static_cast<uint64_t>(seed) * 7U + 11U) % 100U < 53U;
}

template <typename T>
void FillInputs(
    const Options &options,
    const LayoutPlan<T> &plan,
    std::vector<T> &left,
    std::vector<T> &right)
{
    for (uint32_t row = 0; row < options.batch; ++row) {
        const uint64_t rowOffset = static_cast<uint64_t>(row) * plan.physicalUnitsPerRow;
        for (uint32_t value = 0; value < options.universe; ++value) {
            const bool inLeft = MemberLeft(row, value, options.seed);
            const bool inRight = MemberRight(row, value, options.seed);
            if constexpr (std::is_same<T, uint8_t>::value) {
                left[rowOffset + value] = static_cast<uint8_t>(inLeft);
                right[rowOffset + value] = static_cast<uint8_t>(inRight);
            } else {
                const uint32_t word = value / 32U;
                const uint32_t bit = value % 32U;
                if (inLeft) {
                    left[rowOffset + word] |= (1U << bit);
                }
                if (inRight) {
                    right[rowOffset + word] |= (1U << bit);
                }
            }
        }
    }
}

struct AclResources {
    ~AclResources()
    {
        Cleanup();
    }

    bool Initialize(size_t inputBytes, size_t outputBytes)
    {
        if (aclInit(nullptr) != ACL_SUCCESS) {
            return false;
        }
        aclInitialized = true;
        if (aclrtSetDevice(0) != ACL_SUCCESS) {
            return false;
        }
        deviceSet = true;
        return aclrtCreateStream(&stream) == ACL_SUCCESS &&
            aclrtMalloc(reinterpret_cast<void **>(&leftDevice), inputBytes,
                ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS &&
            aclrtMalloc(reinterpret_cast<void **>(&rightDevice), inputBytes,
                ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS &&
            aclrtMalloc(reinterpret_cast<void **>(&outputDevice), outputBytes,
                ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS;
    }

    bool Cleanup()
    {
        bool success = true;
        if (outputDevice != nullptr) {
            success &= aclrtFree(outputDevice) == ACL_SUCCESS;
            outputDevice = nullptr;
        }
        if (rightDevice != nullptr) {
            success &= aclrtFree(rightDevice) == ACL_SUCCESS;
            rightDevice = nullptr;
        }
        if (leftDevice != nullptr) {
            success &= aclrtFree(leftDevice) == ACL_SUCCESS;
            leftDevice = nullptr;
        }
        if (stream != nullptr) {
            success &= aclrtDestroyStream(stream) == ACL_SUCCESS;
            stream = nullptr;
        }
        if (deviceSet) {
            success &= aclrtResetDevice(0) == ACL_SUCCESS;
            deviceSet = false;
        }
        if (aclInitialized) {
            success &= aclFinalize() == ACL_SUCCESS;
            aclInitialized = false;
        }
        return success;
    }

    bool aclInitialized = false;
    bool deviceSet = false;
    aclrtStream stream = nullptr;
    uint8_t *leftDevice = nullptr;
    uint8_t *rightDevice = nullptr;
    uint8_t *outputDevice = nullptr;
};

template <typename T>
int RunLayout(const Options &options, const std::string &layoutName)
{
    LayoutPlan<T> plan{};
    if (!MakeLayoutPlan(options, plan)) {
        return 2;
    }
    std::vector<T> left(plan.totalUnits, 0);
    std::vector<T> right(plan.totalUnits, 0);
    FillInputs(options, plan, left, right);

    const size_t dataBytes = static_cast<size_t>(plan.totalUnits) * sizeof(T);
    const size_t outputBytes = dataBytes + kGuardBytes;
    std::vector<uint8_t> outputWithGuard(outputBytes, kGuardValue);
    AclResources resources;
    if (!resources.Initialize(dataBytes, outputBytes)) {
        std::cerr << "ACL initialization or allocation failed" << std::endl;
        return 3;
    }
    if (aclrtMemcpy(resources.leftDevice, dataBytes, left.data(), dataBytes,
            ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS ||
        aclrtMemcpy(resources.rightDevice, dataBytes, right.data(), dataBytes,
            ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS ||
        aclrtMemcpy(resources.outputDevice, outputBytes, outputWithGuard.data(), outputBytes,
            ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
        std::cerr << "host-to-device copy failed" << std::endl;
        return 3;
    }

    auto launch = [&]() {
        if constexpr (std::is_same<T, uint8_t>::value) {
            dense_and<<<plan.blockDim, nullptr, resources.stream>>>(
                resources.leftDevice, resources.rightDevice, resources.outputDevice, plan.tiling);
        } else {
            bitmap_and<<<plan.blockDim, nullptr, resources.stream>>>(
                resources.leftDevice, resources.rightDevice, resources.outputDevice, plan.tiling);
        }
    };

    for (uint32_t i = 0; i < options.warmup; ++i) {
        launch();
    }
    if (aclrtSynchronizeStream(resources.stream) != ACL_SUCCESS) {
        std::cerr << "kernel warmup failed" << std::endl;
        return 3;
    }
    const auto start = std::chrono::steady_clock::now();
    for (uint32_t i = 0; i < options.iterations; ++i) {
        launch();
    }
    if (aclrtSynchronizeStream(resources.stream) != ACL_SUCCESS) {
        std::cerr << "kernel execution failed" << std::endl;
        return 3;
    }
    const auto stop = std::chrono::steady_clock::now();

    if (aclrtMemcpy(outputWithGuard.data(), outputBytes, resources.outputDevice, outputBytes,
            ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
        std::cerr << "device-to-host copy failed" << std::endl;
        return 3;
    }

    const T *output = reinterpret_cast<const T *>(outputWithGuard.data());
    bool correct = true;
    for (uint32_t i = 0; i < plan.totalUnits; ++i) {
        if (output[i] != static_cast<T>(left[i] & right[i])) {
            correct = false;
            break;
        }
    }
    const bool guardPass = std::all_of(
        outputWithGuard.begin() + dataBytes,
        outputWithGuard.end(),
        [](uint8_t value) { return value == kGuardValue; });

    const double totalUs =
        std::chrono::duration<double, std::micro>(stop - start).count();
    const double averageUs = totalUs / static_cast<double>(options.iterations);
    const uint64_t physicalBytes = 3ULL * dataBytes;
    const uint64_t logicalBytes =
        3ULL * static_cast<uint64_t>(options.batch) * options.universe;
    const double physicalGbPerSecond = static_cast<double>(physicalBytes) / averageUs / 1000.0;
    const double logicalGbPerSecond = static_cast<double>(logicalBytes) / averageUs / 1000.0;

    if (!resources.Cleanup()) {
        std::cerr << "ACL cleanup failed" << std::endl;
        return 3;
    }
    std::cout << std::fixed << std::setprecision(6)
              << "METRIC layout=" << layoutName
              << " batch=" << options.batch
              << " universe=" << options.universe
              << " valid_units_per_row=" << plan.validUnitsPerRow
              << " physical_units_per_row=" << plan.physicalUnitsPerRow
              << " total_units=" << plan.totalUnits
              << " block_dim=" << plan.blockDim
              << " block_former=" << plan.tiling.blockFormer
              << " block_tail=" << plan.tiling.blockTail
              << " tile_units=" << plan.tiling.tileUnits
              << " buffer_num=" << kBufferNum
              << " physical_bytes=" << physicalBytes
              << " logical_bytes=" << logicalBytes
              << " correctness=" << (correct ? "PASS" : "FAIL")
              << " guard=" << (guardPass ? "PASS" : "FAIL")
              << " timing_scope=launch_plus_sync"
              << " avg_kernel_us=" << averageUs
              << " physical_gb_s=" << physicalGbPerSecond
              << " logical_gb_s=" << logicalGbPerSecond << std::endl;
    return correct && guardPass ? 0 : 1;
}

int main(int argc, char **argv)
{
    Options options;
    if (!ParseOptions(argc, argv, options) || !ValidateOptions(options)) {
        std::cerr << "usage: " << argv[0]
                  << " --layout dense|bitmap [--batch N] [--universe N]"
                  << " [--warmup N] [--iterations N] [--seed N]" << std::endl;
        return 2;
    }
    if (options.layout == "dense") {
        return RunLayout<uint8_t>(options, "dense");
    }
    return RunLayout<uint32_t>(options, "bitmap");
}
