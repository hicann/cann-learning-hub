// ============================================================================
// Ascend C Kernel 直调 - rope_optimized 算子（Host + Main 入口）
// ============================================================================
//
// 文件结构说明：
//   op_kernel/rope_optimized_tiling.h   - Tiling 常量 + 结构体（纯 C/C++，kernel 和 host 共用）
//   op_kernel/rope_optimized_kernel.asc - Kernel 实现（KernelRopeOptimized 类 + 核函数入口）
//   op_host/rope_optimized.asc          - 本文件：Host 端代码 + main 入口（引用 op_kernel/ 下的文件）
// ============================================================================

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include "acl/acl.h"
#include "../op_kernel/rope_optimized_tiling.h"
#include "data_utils.h"

// 引用拆出的纯 kernel 文件（包含 kernel_operator.h）
#include "../op_kernel/rope_optimized_kernel.asc"

// ============================================================================
// Host 端代码 - 运行在 CPU 上
// ============================================================================

struct ArgInfo {
    std::string fileName;
    size_t length;
};

// Tiling 计算（baseRows/remainRows 负载均衡 + sTile 动态计算）
// 参考 DESIGN.md §6
void ComputeTiling(RopeOptimizedTilingData& tiling, int64_t B, int64_t S, int64_t H, int64_t D,
                   int32_t availableCoreNum, int32_t elemBytes, int32_t dtypeFlag)
{
    tiling.B = B;
    tiling.S = S;
    tiling.H = H;
    tiling.D = D;
    tiling.BH = B * H;
    tiling.dtype = dtypeFlag;

    // 多核切分：baseRows/remainRows 负载均衡策略（O1 优化）
    tiling.coreNum = (int32_t)std::min((int64_t)tiling.BH, (int64_t)availableCoreNum);
    tiling.baseRows = (int32_t)(tiling.BH / tiling.coreNum);
    tiling.remainRows = (int32_t)(tiling.BH % tiling.coreNum);
    tiling.blockNum = tiling.coreNum;

    // UB 切分：单缓冲，bufferNum=6（4 TQue + 2 TBuf）
    // UB_SIZE = 184 KB（TPipe 可用容量）
    int32_t totalBufferNum = 6;
    int64_t maxElemNum = UB_SIZE / ((int64_t)totalBufferNum * elemBytes);
    int64_t maxSTile = maxElemNum / D;

    // 对齐到 8 的倍数（保守对齐策略，减少 DataBlock 边界非对齐风险）
    int32_t sTile = (int32_t)((maxSTile / 8) * 8);
    if (sTile > (int32_t)S) sTile = (int32_t)S;
    if (sTile < 1) sTile = 1;

    // sTile 上限约束：repeatTime (uint8_t) <= 255
    if (sTile > 255) sTile = 255;

    tiling.sTile = sTile;
    tiling.sLoop = ((int32_t)S + sTile - 1) / sTile;
    tiling.sTail = (int32_t)S - (tiling.sLoop - 1) * sTile;
}

// KernelCall 封装 - 处理完整的核函数调用流程
void KernelCall(uint32_t blockNum, aclrtStream stream,
    std::vector<ArgInfo> &inputsInfo, std::vector<ArgInfo> &outputsInfo,
    uint8_t *tilingData, int32_t dtypeFlag)
{
    std::vector<uint8_t *> inputHost(inputsInfo.size());
    std::vector<uint8_t *> inputDevice(inputsInfo.size());
    std::vector<uint8_t *> outputHost(outputsInfo.size());
    std::vector<uint8_t *> outputDevice(outputsInfo.size());
    uint8_t *tilingDevice = nullptr;

    aclrtMalloc((void **)&tilingDevice, sizeof(RopeOptimizedTilingData), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(tilingDevice, sizeof(RopeOptimizedTilingData), tilingData,
        sizeof(RopeOptimizedTilingData), ACL_MEMCPY_HOST_TO_DEVICE);

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtMallocHost((void **)&inputHost[i], inputsInfo[i].length);
        aclrtMalloc((void **)&inputDevice[i], inputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile(inputsInfo[i].fileName, inputsInfo[i].length, inputHost[i], inputsInfo[i].length);
        aclrtMemcpy(inputDevice[i], inputsInfo[i].length, inputHost[i],
            inputsInfo[i].length, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMallocHost((void **)&outputHost[i], outputsInfo[i].length);
        aclrtMalloc((void **)&outputDevice[i], outputsInfo[i].length, ACL_MEM_MALLOC_HUGE_FIRST);
    }

    // 根据 dtype 选择 kernel 入口
    if (dtypeFlag == DTYPE_FLOAT) {
        rope_optimized_kernel<<<blockNum, nullptr, stream>>>(
            inputDevice[0], inputDevice[1], inputDevice[2],
            outputDevice[0], tilingDevice);
    } else {
        rope_optimized_kernel_fp16<<<blockNum, nullptr, stream>>>(
            inputDevice[0], inputDevice[1], inputDevice[2],
            outputDevice[0], tilingDevice);
    }
    aclrtSynchronizeStream(stream);

    aclrtFree(tilingDevice);
    for (size_t i = 0; i < outputsInfo.size(); i++) {
        aclrtMemcpy(outputHost[i], outputsInfo[i].length, outputDevice[i],
            outputsInfo[i].length, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile(outputsInfo[i].fileName, outputHost[i], outputsInfo[i].length);
        aclrtFree(outputDevice[i]);
        aclrtFreeHost(outputHost[i]);
    }

    for (size_t i = 0; i < inputsInfo.size(); i++) {
        aclrtFree(inputDevice[i]);
        aclrtFreeHost(inputHost[i]);
    }
}

// ACL 标准初始化流程
int32_t main(int32_t argc, char *argv[])
{
    // 默认参数：B=2, S=8, H=2, D=64, FP32（与 gen_data.py 默认参数一致）
    // 可通过命令行参数覆盖：./rope_optimized <B> <S> <H> <D> <dtype>
    int64_t B = 2;
    int64_t S = 8;
    int64_t H = 2;
    int64_t D = 64;
    int32_t dtypeFlag = DTYPE_FLOAT;

    if (argc >= 5) {
        B = atol(argv[1]);
        S = atol(argv[2]);
        H = atol(argv[3]);
        D = atol(argv[4]);
    }
    if (argc >= 6) {
        std::string dt = argv[5];
        if (dt == "float" || dt == "fp32" || dt == "0") {
            dtypeFlag = DTYPE_FLOAT;
        } else if (dt == "half" || dt == "fp16" || dt == "1") {
            dtypeFlag = DTYPE_HALF;
        }
    }

    int32_t elemBytes = (dtypeFlag == DTYPE_FLOAT) ? 4 : 2;
    const char* dtypeStr = (dtypeFlag == DTYPE_FLOAT) ? "float32" : "float16";

    aclInit(nullptr);
    int32_t deviceId = 0;
    auto ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        printf("aclrtSetDevice failed, ret=%d\n", ret);
        return ret;
    }

    // 获取设备最大核数
    int64_t availableCoreNum = 0;
    ret = aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum);
    if (ret != ACL_SUCCESS) {
        printf("aclrtGetDeviceInfo failed, ret=%d\n", ret);
        aclrtResetDevice(deviceId);
        return ret;
    }

    // 计算 Tiling 数据
    RopeOptimizedTilingData tiling;
    ComputeTiling(tiling, B, S, H, D, (int32_t)availableCoreNum, elemBytes, dtypeFlag);

    // blockNum = coreNum
    uint32_t blockNum = (uint32_t)tiling.blockNum;

    printf("RoPE Optimized (v2): B=%ld, S=%ld, H=%ld, D=%ld, dtype=%s\n",
           B, S, H, D, dtypeStr);
    printf("  BH=%ld, coreNum=%d, baseRows=%d, remainRows=%d, blockNum=%u\n",
           tiling.BH, tiling.coreNum, tiling.baseRows, tiling.remainRows, blockNum);
    printf("  sTile=%d, sLoop=%d, sTail=%d\n", tiling.sTile, tiling.sLoop, tiling.sTail);
    printf("  UB_SIZE=%ld, totalBufferNum=6, elemBytes=%d\n", UB_SIZE, elemBytes);

    // 计算 byte 大小
    size_t totalElements = (size_t)B * S * H * D;
    size_t xByteSize = totalElements * elemBytes;       // B*S*H*D
    size_t cosSinByteSize = S * D * elemBytes;           // S*D
    size_t outputByteSize = xByteSize;

    std::vector<ArgInfo> inputsInfo = {
        {"./input/input_x.bin", xByteSize},
        {"./input/input_cos.bin", cosSinByteSize},
        {"./input/input_sin.bin", cosSinByteSize}
    };
    std::vector<ArgInfo> outputsInfo = {
        {"./output/output.bin", outputByteSize}
    };

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    KernelCall(blockNum, stream, inputsInfo, outputsInfo, (uint8_t *)&tiling, dtypeFlag);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
