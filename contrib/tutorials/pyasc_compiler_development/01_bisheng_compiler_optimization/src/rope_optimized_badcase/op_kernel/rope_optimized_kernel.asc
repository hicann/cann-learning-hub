// ============================================================================
// Ascend C Kernel 实现 - rope_optimized 算子（纯 kernel，不含 host 代码）
// ============================================================================
//
// RoPE 部分优化版本（v2）:
//   output = x * cos + rotate_half(x) * sin
//
// v2 优化策略（相对 v1 朴素基线）:
//   O1: baseRows/remainRows 负载均衡多核切分
//   O2: sTile 动态计算，一次处理多行（非逐行）
//   O3: Muls 高维切分（mask + repeatTime + stride）批量取负
//   O4: DataCopy UB→UB 高维切分（blockCount + blockLen + gap）批量搬移
//
// v2 刻意未采用的优化（留给 v3）:
//   O6: 禁止 Double Buffer（保持 bufferNum=1）
//   O7: 禁止 DataCopyPad 多 block 模式（保持 blockCount=1，外层循环逐行搬运）
//   O8: 禁止 FusedMulAdd（保持 Mul + Mul + Add 三步分离）
// ============================================================================

#include "kernel_operator.h"
#include "rope_optimized_tiling.h"

using namespace AscendC;

// ============================================================================
// 教学专用：故意写坏的模式集合（纯函数、结果不参与输出，输出仍与原版一致）
// 覆盖华为工程师 x86/GCC 模板的 4 类经典优化场景：
//   B1 常量折叠 + 死代码消除：a + b*3 编译期可算，if(c<100) 恒假分支
//   B2 循环不变量外提 + 归纳变量消除：100 次循环重复使用不变量 n*37
//   B3 强度削减：n*15 可用移位+加法替代乘法
//   B4 函数内联：-O0 下是真实函数调用，-O2 下内联后整体消除
// -O0：按字面执行（汇编/周期数可观测）
// -O2/-O3：整个函数被消除（符号消失、周期数无增长）
// ============================================================================
__aicore__ inline int32_t BadWritePatterns(int32_t n)
{
    // B1: 常量折叠 + 死代码消除
    int32_t a = 100;
    int32_t b = 200;
    int32_t c = a + b * 3;          // 编译期可算出 700
    int32_t fix = 0;
    if (c < 100) {                  // 条件恒为假，分支体不可达
        fix = -1;                   // 死代码
    }

    // B2: 循环不变量外提 + 归纳变量消除
    int32_t sum = 0;
    for (int32_t i = 0; i < 100; i++) {
        sum += n * 37 + fix;        // n*37+fix 与 i 无关，是循环不变量
    }

    // B3: 强度削减
    int32_t m = n * 15;             // 乘法可用移位+加法低开销指令替代

    // 恒等于 n*37*100 + n*15 + 700
    return sum + m + c;
}

// ============================================================================
// Kernel 类 - 封装 NPU 上的 RoPE v2 计算逻辑
// ============================================================================
template <typename T>
class KernelRopeOptimized {
public:
    __aicore__ inline KernelRopeOptimized(AscendC::TPipe* pipe)
    {
        pipe_ = pipe;
    };

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR cos, GM_ADDR sin, GM_ADDR output,
                                const __gm__ RopeOptimizedTilingData* tiling)
    {
        this->tiling = tiling;

        // 从 tiling 读取基本参数
        B_ = tiling->B;
        S_ = tiling->S;
        H_ = tiling->H;
        D_ = tiling->D;
        BH_ = tiling->BH;
        sTile_ = tiling->sTile;
        sLoop_ = tiling->sLoop;
        sTail_ = tiling->sTail;
        halfD_ = (int32_t)(D_ / 2);

        // 多核切分：baseRows/remainRows 负载均衡策略（O1 优化）
        // 第 blockIdx 个核处理的 BH 范围：[bhStart, bhEnd)
        uint32_t blockIdx = GetBlockIdx();
        baseRows_ = tiling->baseRows;
        remainRows_ = tiling->remainRows;

        if ((int32_t)blockIdx < remainRows_) {
            bhStart_ = (int64_t)blockIdx * (baseRows_ + 1);
            bhEnd_ = bhStart_ + baseRows_ + 1;
        } else {
            bhStart_ = (int64_t)remainRows_ * (baseRows_ + 1) +
                       ((int64_t)blockIdx - remainRows_) * baseRows_;
            bhEnd_ = bhStart_ + baseRows_;
        }
        bhEnd_ = min(bhEnd_, BH_);

        // 设置 GlobalTensor（不做 per-core 偏移，循环内部按偏移访问）
        xGm.SetGlobalBuffer((__gm__ T*)x);
        cosGm.SetGlobalBuffer((__gm__ T*)cos);
        sinGm.SetGlobalBuffer((__gm__ T*)sin);
        outGm.SetGlobalBuffer((__gm__ T*)output);

        // 初始化 UB Buffer（全部单缓冲，bufferNum=1）
        // 各 buffer 大小为 sTile * D 个元素（v2 多行处理，v1 为 D 个元素）
        int32_t tileElemCount = sTile_ * D_;
        pipe_->InitBuffer(xQue, BUFFER_NUM, tileElemCount * sizeof(T));
        pipe_->InitBuffer(cosQue, BUFFER_NUM, tileElemCount * sizeof(T));
        pipe_->InitBuffer(sinQue, BUFFER_NUM, tileElemCount * sizeof(T));
        pipe_->InitBuffer(outQue, BUFFER_NUM, tileElemCount * sizeof(T));
        pipe_->InitBuffer(rotateHalfBuf, tileElemCount * sizeof(T));
        pipe_->InitBuffer(tmpBuf, tileElemCount * sizeof(T));

        // 高维切分参数预计算（O3 + O4）
        // elementsPerBlock: half=16, float=8
        // repStride: 每行间隔的 DataBlock 数 = D / elementsPerBlock
        int32_t elementsPerBlock = 32 / sizeof(T);
        repStride_ = D_ / elementsPerBlock;
        // blockLenBlocks / gapBlocks: halfD 对应的 DataBlock 数
        blockLenBlocks_ = (uint16_t)(halfD_ / elementsPerBlock);
        gapBlocks_ = (uint16_t)(halfD_ / elementsPerBlock);

        // DataCopyPad 单 block 参数（O5: 单 block 模式，禁止多 block）
        dByteLen_ = (uint32_t)(D_ * sizeof(T));
    }

    __aicore__ inline void Process()
    {
        // 空闲核直接返回（BH < coreNum 时部分核空闲）
        if (sLoop_ == 0 || bhStart_ >= bhEnd_) {
            return;
        }

        for (int64_t bh = bhStart_; bh < bhEnd_; bh++) {
            int64_t b = bh / H_;
            int64_t h = bh % H_;

            // 教学专用：调用坏写法集合（结果不参与输出；-O0 真实执行，-O2 整体消除）
            int32_t dead = BadWritePatterns((int32_t)(bh - bhStart_));
            (void)dead;

            for (int32_t sIter = 0; sIter < sLoop_; sIter++) {
                int32_t sStart = sIter * sTile_;
                int32_t sLen = (sIter == sLoop_ - 1) ? sTail_ : sTile_;

                ProcessOneTile(b, sStart, h, sLen);
            }
        }
    }

private:
    __aicore__ inline void ProcessOneTile(int64_t b, int32_t sStart, int64_t h, int32_t sLen)
    {
        // CopyIn: 逐行 DataCopyPad 单 block 搬入 x/cos/sin
        CopyIn(b, sStart, h, sLen);

        // Compute: rotate_half 高维切分 + Mul + Mul + Add
        Compute(sLen);

        // CopyOut: 逐行 DataCopyPad 单 block 搬出 output
        CopyOut(b, sStart, h, sLen);
    }

    // === CopyIn（O5: 单 block 模式，循环 sLen 行搬入）===
    __aicore__ inline void CopyIn(int64_t b, int32_t sStart, int64_t h, int32_t sLen)
    {
        // DataCopyPad 单 block 模式（blockCount=1）
        // DataCopyExtParams 字段顺序: {blockCount, blockLen, srcStride, dstStride, rsv}
        DataCopyExtParams copyParams = {1, dByteLen_, 0, 0, 0};
        DataCopyPadExtParams<T> padParams = {false, 0, 0, T(0)};

        LocalTensor<T> xLocal = xQue.AllocTensor<T>();
        LocalTensor<T> cosLocal = cosQue.AllocTensor<T>();
        LocalTensor<T> sinLocal = sinQue.AllocTensor<T>();

        // 约束：D * sizeof(T) 必须为 32B 倍数（见 DESIGN.md §9），保证逐行 DataCopyPad
        // 的 UB 端起始地址 i * D * sizeof(T) 始终 32B 对齐
        for (int32_t i = 0; i < sLen; i++) {
            int64_t xOffset = ((b * S_ + sStart + i) * H_ + h) * D_;
            int64_t cosOffset = (int64_t)(sStart + i) * D_;

            DataCopyPad(xLocal[i * D_], xGm[xOffset], copyParams, padParams);
            DataCopyPad(cosLocal[i * D_], cosGm[cosOffset], copyParams, padParams);
            DataCopyPad(sinLocal[i * D_], sinGm[cosOffset], copyParams, padParams);
        }

        xQue.EnQue(xLocal);
        cosQue.EnQue(cosLocal);
        sinQue.EnQue(sinLocal);
    }

    // === Compute ===
    __aicore__ inline void Compute(int32_t sLen)
    {
        LocalTensor<T> xLocal = xQue.DeQue<T>();
        LocalTensor<T> cosLocal = cosQue.DeQue<T>();
        LocalTensor<T> sinLocal = sinQue.DeQue<T>();
        LocalTensor<T> outLocal = outQue.AllocTensor<T>();
        LocalTensor<T> rotateHalfLocal = rotateHalfBuf.Get<T>();
        LocalTensor<T> tmpLocal = tmpBuf.Get<T>();

        int32_t count = sLen * D_;

        // === rotate_half（高维切分，O3 + O4）===
        RotateHalf(rotateHalfLocal, xLocal, sLen);

        // === 主计算：out = x * cos + rotate_half(x) * sin ===
        // 三步分离（O8: 禁止 FusedMulAdd）
        Mul(outLocal, xLocal, cosLocal, count);           // out = x * cos
        Mul(tmpLocal, rotateHalfLocal, sinLocal, count);  // tmp = rotateHalf * sin
        Add(outLocal, outLocal, tmpLocal, count);         // out = x*cos + rotateHalf*sin

        outQue.EnQue<T>(outLocal);
        xQue.FreeTensor(xLocal);
        cosQue.FreeTensor(cosLocal);
        sinQue.FreeTensor(sinLocal);
    }

    // === rotate_half 实现（高维切分 — O3 + O4 核心优化）===
    // rotateHalf[row, 0:halfD]  = -x[row, halfD:D]   (前半 = -x后半)
    // rotateHalf[row, halfD:D]  =  x[row, 0:halfD]   (后半 = x前半)
    __aicore__ inline void RotateHalf(LocalTensor<T>& rotateHalfLocal,
                                       LocalTensor<T>& xLocal,
                                       int32_t sLen)
    {
        // 步骤 1：后半取负 → 前半（O3: Muls 高维切分）
        // mask = halfD（每行处理 halfD 个元素）
        // repeatTime = sLen（处理 sLen 行）
        // srcRepStride/dstRepStride = repStride_（每行间隔 D 个元素的 DataBlock 数）
        uint64_t mask = (uint64_t)halfD_;
        uint8_t repeatTime = (uint8_t)sLen;
        Muls(rotateHalfLocal[0], xLocal[halfD_], (T)(-1.0),
             mask, repeatTime,
             UnaryRepeatParams(1, 1, (uint8_t)repStride_, (uint8_t)repStride_));

        // 步骤 2：前半搬移 → 后半（O4: DataCopy UB→UB 高维切分）
        // blockCount = sLen, blockLen = halfD / elementsPerBlock（DataBlock 单位）
        // srcGap = halfD / elementsPerBlock（跳过后半到下一行前半）
        // dstGap = halfD / elementsPerBlock（跳过前半到下一行后半）
        DataCopyParams copyParams;
        copyParams.blockCount = (uint16_t)sLen;
        copyParams.blockLen = blockLenBlocks_;
        copyParams.srcGap = gapBlocks_;
        copyParams.dstGap = gapBlocks_;
        DataCopy(rotateHalfLocal[halfD_], xLocal[0], copyParams);
    }

    // === CopyOut（O5: 单 block 模式，循环 sLen 行搬出）===
    __aicore__ inline void CopyOut(int64_t b, int32_t sStart, int64_t h, int32_t sLen)
    {
        LocalTensor<T> outLocal = outQue.DeQue<T>();

        // DataCopyPad 单 block 模式（blockCount=1）
        // 注意：UB→GM 方向 DataCopyPad 签名不包含 padParams 参数
        DataCopyExtParams copyParams = {1, dByteLen_, 0, 0, 0};
        for (int32_t i = 0; i < sLen; i++) {
            int64_t outOffset = ((b * S_ + sStart + i) * H_ + h) * D_;
            DataCopyPad(outGm[outOffset], outLocal[i * D_], copyParams);
        }
        outQue.FreeTensor(outLocal);
    }

private:
    AscendC::TPipe* pipe_;
    const __gm__ RopeOptimizedTilingData* tiling;

    // Shape 参数
    int64_t B_, S_, H_, D_, BH_;
    int32_t sTile_, sLoop_, sTail_;
    int32_t halfD_;
    int32_t baseRows_, remainRows_;
    int64_t bhStart_, bhEnd_;

    // 高维切分参数
    int32_t repStride_;         // Muls repeatStride（DataBlock 单位）
    uint16_t blockLenBlocks_;   // DataCopy UB→UB blockLen（DataBlock 单位）
    uint16_t gapBlocks_;        // DataCopy UB→UB gap（DataBlock 单位）
    uint32_t dByteLen_;         // DataCopyPad blockLen（字节）

    // Global Tensor
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> cosGm;
    AscendC::GlobalTensor<T> sinGm;
    AscendC::GlobalTensor<T> outGm;

    // UB Buffer（单缓冲，bufferNum=1）
    // 禁止 Double Buffer（O6 留给 v3）
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> xQue;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> cosQue;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> sinQue;
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> outQue;
    AscendC::TBuf<AscendC::TPosition::VECCALC> rotateHalfBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmpBuf;
};

// ============================================================================
// 核函数入口
// ============================================================================

// FP32 入口
extern "C" __global__ __vector__ void rope_optimized_kernel(GM_ADDR x, GM_ADDR cos, GM_ADDR sin,
                                                             GM_ADDR output, GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    KernelRopeOptimized<float> op(&pipe);
    op.Init(x, cos, sin, output, (__gm__ RopeOptimizedTilingData*)tiling);
    op.Process();
}

// FP16 入口
extern "C" __global__ __vector__ void rope_optimized_kernel_fp16(GM_ADDR x, GM_ADDR cos, GM_ADDR sin,
                                                                  GM_ADDR output, GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    KernelRopeOptimized<half> op(&pipe);
    op.Init(x, cos, sin, output, (__gm__ RopeOptimizedTilingData*)tiling);
    op.Process();
}
