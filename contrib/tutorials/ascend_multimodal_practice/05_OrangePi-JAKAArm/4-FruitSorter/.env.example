# 多模态机械臂控制 - 凭证配置示例
# 使用方法：复制本文件为 .env 并填入真实凭证（.env 切勿上传到公开仓库）

# ===== 华为云语音交互服务 SIS（用于 ASR 语音识别 / TTS 语音播报）=====
# AK/SK 在「华为云 → 控制台 → 我的凭证 → 访问密钥」中创建
HUAWEI_SIS_AK=你的AccessKey
HUAWEI_SIS_SK=你的SecretKey
# Region 与 Project ID 需对应（如华东3 cn-east-3）
HUAWEI_SIS_REGION=cn-east-3
HUAWEI_SIS_PROJECT_ID=你的项目ID

# TTS 音色（可选，默认 chinese_xiaoyan_common 女声）
# 可选：chinese_xiaoyu_common(男声) / chinese_xiaoqi_common / chinese_xiaowei_common
HUAWEI_TTS_VOICE=chinese_xiaoyan_common

# ===== DeepSeek 大模型 API（意图解析 + 多轮对话）=====
# 获取地址：https://platform.deepseek.com/ → API Keys
DEEPSEEK_API_KEY=你的DeepSeekAPIKey
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
