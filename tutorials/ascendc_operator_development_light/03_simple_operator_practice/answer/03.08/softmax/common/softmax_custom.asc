#include "kernel_operator.h"

// Case 0: one row loop, MemBase ReduceMax / Duplicate / Sub / Exp /
// ReduceSum / Duplicate / Div. A2/A3 scalar broadcast uses GetValue.
__global__ __vector__ void softmax_custom(__gm__ uint8_t* x, __gm__ uint8_t* y)
{
    constexpr uint32_t rows = 128, cols = 128;
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inputQueue;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outputQueue;
    AscendC::TBuf<AscendC::TPosition::VECCALC> expBuffer, sumBuffer, scratchBuffer;
    pipe.InitBuffer(inputQueue, 1, cols * sizeof(float));
    pipe.InitBuffer(outputQueue, 1, cols * sizeof(float));
    pipe.InitBuffer(expBuffer, cols * sizeof(float));
    pipe.InitBuffer(sumBuffer, cols * sizeof(float));
    pipe.InitBuffer(scratchBuffer, cols * sizeof(float));
    auto expTensor = expBuffer.Get<float>();
    auto sumTensor = sumBuffer.Get<float>();
    auto scratch = scratchBuffer.Get<float>();
    AscendC::GlobalTensor<float> xGm, yGm;
    xGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(x), rows * cols);
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y), rows * cols);
    for (uint32_t row = 0; row < rows; ++row) {
        auto src = inputQueue.AllocTensor<float>();
        AscendC::DataCopy(src, xGm[row * cols], cols);
        inputQueue.EnQue(src);
        src = inputQueue.DeQue<float>();
        auto dst = outputQueue.AllocTensor<float>();
        AscendC::ReduceMax(expTensor, src, scratch, cols);
        AscendC::SetFlag<AscendC::HardEvent::V_S>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_S>(EVENT_ID0);
        float maxValue = expTensor.GetValue(0);
        AscendC::SetFlag<AscendC::HardEvent::S_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::S_V>(EVENT_ID0);
        AscendC::Duplicate(expTensor, maxValue, cols);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Sub(expTensor, src, expTensor, cols);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Exp(expTensor, expTensor, cols);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::ReduceSum(sumTensor, expTensor, scratch, cols);
        AscendC::SetFlag<AscendC::HardEvent::V_S>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_S>(EVENT_ID0);
        float sumValue = sumTensor.GetValue(0);
        AscendC::SetFlag<AscendC::HardEvent::S_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::S_V>(EVENT_ID0);
        AscendC::Duplicate(sumTensor, sumValue, cols);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Div(dst, expTensor, sumTensor, cols);
        outputQueue.EnQue(dst);
        inputQueue.FreeTensor(src);
        dst = outputQueue.DeQue<float>();
        AscendC::DataCopy(yGm[row * cols], dst, cols);
        outputQueue.FreeTensor(dst);
    }
}

extern "C" void softmax_custom_impl(void* stream, uint8_t* x, uint8_t* y)
{
    softmax_custom<<<1, 0, stream>>>(x, y);
}
