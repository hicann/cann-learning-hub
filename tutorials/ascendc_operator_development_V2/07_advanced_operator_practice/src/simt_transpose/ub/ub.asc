#include <algorithm>
#include <cmath>
#include <iostream>
#include <iterator>
#include <vector>
#include "acl/acl.h"
#include "simt_api/asc_simt.h"

constexpr uint32_t MAX_THREAD_COUNT = 1024;

// 纯 SIMT 核函数：固定启动 64 个 Thread Block，每个 Thread Block 循环处理多个 32 x 32 tile。
template <uint32_t tile_dim>
__global__ __launch_bounds__(MAX_THREAD_COUNT) void transpose_ub_fixed64_custom(
    float* output, const float* input, uint32_t width, uint32_t height, uint32_t total_tiles)
{
    __ubuf__ float tile[tile_dim][tile_dim];

    uint32_t tiles_per_row = width / tile_dim;                         // 输入矩阵每行包含的 tile 数。
    uint32_t local_row = threadIdx.y;                                  // 当前线程在 tile 内的行号。
    uint32_t local_col = threadIdx.x;                                  // 当前线程在 tile 内的列号。

    for (uint32_t tile_id = blockIdx.x; tile_id < total_tiles; tile_id += gridDim.x) {
        uint32_t tile_row = tile_id / tiles_per_row;                   // 当前 tile 在输入矩阵中的 tile 行号。
        uint32_t tile_col = tile_id - tile_row * tiles_per_row;         // 当前 tile 在输入矩阵中的 tile 列号。
        uint32_t input_row = tile_row * tile_dim + local_row;           // 当前线程读取的输入矩阵行号。
        uint32_t input_col = tile_col * tile_dim + local_col;           // 当前线程读取的输入矩阵列号。
        tile[local_row][local_col] = input[input_row * width + input_col]; // 按原布局读入 UB。
        asc_syncthreads();

        uint32_t output_row = tile_col * tile_dim + local_row;          // 转置后输出 tile 的行号来自输入 tile 列号。
        uint32_t output_col = tile_row * tile_dim + local_col;          // 转置后输出 tile 的列号来自输入 tile 行号。
        output[output_row * height + output_col] = tile[local_col][local_row]; // 从 UB 转置读，连续写回 GM。
        asc_syncthreads();
    }
}

// Host 侧 golden 函数
void transpose_golden(const std::vector<float>& input, std::vector<float>& golden, uint32_t width, uint32_t height)
{
    for (uint32_t row = 0; row < height; ++row) {
        for (uint32_t col = 0; col < width; ++col) {
            golden[col * height + row] = input[row * width + col];
        }
    }
}

// 结果校验函数
uint32_t verify_result(std::vector<float>& output, std::vector<float>& golden)
{
    auto print_tensor = [](std::vector<float>& tensor, const char* name) {
        constexpr size_t max_print_size = 20;
        std::cout << name << ": ";
        std::copy(
            tensor.begin(), tensor.begin() + std::min(tensor.size(), max_print_size),
            std::ostream_iterator<float>(std::cout, " "));
        if (tensor.size() > max_print_size) {
            std::cout << "...";
        }
        std::cout << std::endl;
    };
    print_tensor(output, "Output");
    print_tensor(golden, "Golden");
    for (size_t i = 0; i < output.size(); ++i) {
        if (std::fabs(output[i] - golden[i]) > 1e-3f) {
            std::cout << "[Failed] Case accuracy verification failed!" << std::endl;
            return 1;
        }
    }
    std::cout << "[Success] Case accuracy verification passed." << std::endl;
    return 0;
}

// 查询硬件 vector core 数（AIV 核数），不同环境上的物理核数不同，需要在运行时获取
uint32_t get_vector_core_num(uint32_t device_id)
{
    int64_t core_num = 0;
    aclError ret = aclrtGetDeviceInfo(device_id, ACL_DEV_ATTR_VECTOR_CORE_NUM, &core_num);
    if (ret != ACL_SUCCESS) {
        return 0;
    }
    return static_cast<uint32_t>(core_num);
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t matrix_height = 1024;
    constexpr uint32_t matrix_width = 1024;
    constexpr uint32_t input_total_length = matrix_height * matrix_width;
    constexpr uint32_t tile_dim = 32;
    constexpr uint32_t total_tiles = (matrix_width / tile_dim) * (matrix_height / tile_dim);

    // 构造输入数据
    std::vector<float> input(input_total_length);
    for (uint32_t i = 0; i < input_total_length; ++i) {
        input[i] = static_cast<float>(i * 1.25f);
    }

    // 计算预期结果
    std::vector<float> golden(input_total_length);
    transpose_golden(input, golden, matrix_width, matrix_height);

    constexpr size_t byte_size = input_total_length * sizeof(float);

    // 初始化与创建 stream
    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);

    // Thread Block 数固定为物理核数；需在 aclrtSetDevice 之后查询
    uint32_t num_blocks = get_vector_core_num(device_id);
    if (num_blocks == 0) {
        std::cout << "[Failed] Get vector core num failed!" << std::endl;
        return 1;
    }
    std::cout << "Vector core num: " << num_blocks << std::endl;
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    float* input_device = nullptr;
    float* output_device = nullptr;
    uint8_t* output_host = nullptr;

    // 分配 Host / Device 内存并把数据从 Host 拷贝到 Device
    aclrtMalloc((void**)&input_device, byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(input_device, byte_size, input.data(), byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    aclrtMalloc((void**)&output_device, byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost((void**)(&output_host), byte_size);

    // 启动核函数
    dim3 grid(num_blocks, 1, 1);
    dim3 block(tile_dim, tile_dim, 1);
    transpose_ub_fixed64_custom<tile_dim><<<grid, block, 0, stream>>>(
        output_device, input_device, matrix_width, matrix_height, total_tiles);

    // 同步等待核函数执行完成
    aclrtSynchronizeStream(stream);

    // 把结果从 Device 拷回 Host
    aclrtMemcpy(output_host, byte_size, output_device, byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> result((float*)output_host, (float*)(output_host + byte_size));

    // 释放内存
    aclrtFree(input_device);
    aclrtFree(output_device);
    aclrtFreeHost(output_host);

    // 去初始化
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    // 校验结果
    return verify_result(result, golden);
}
