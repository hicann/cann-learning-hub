#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstring>
#include <iostream>
#include <iterator>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "simt_api/asc_simt.h"

constexpr uint32_t MAX_THREAD_COUNT = 1024;
constexpr uint32_t TILE_DIM = 32;
constexpr uint32_t TILE_PAD = 2;
constexpr uint32_t TILE_PAD_STRIDE = TILE_DIM + TILE_PAD;

// 性能对比用的 shape：正文主 shape，完全对齐。
// 两个版本在这个 shape 上的数据量、tile 数、循环轮数完全相同，结果也都正确，
// 因此 Task Duration 的差值就是"为支持非对齐 shape 所付出的代价"。
constexpr uint32_t PERF_HEIGHT = 1024;
constexpr uint32_t PERF_WIDTH = 1024;

// ============================================================================
// 对照组：正文 3.6 节的最终实现（UB padding + 双缓冲），原样拷贝，未做任何泛化。
// 只能处理 height/width 都是 tile_dim 整数倍的 shape，用作性能对照基线。
// ============================================================================
template <uint32_t tile_dim, uint32_t tile_pad_stride>
__global__ __launch_bounds__(MAX_THREAD_COUNT) void transpose_ub_padding_db_custom(
    float* output, const float* input, uint32_t width, uint32_t height, uint32_t total_tiles)
{
    __ubuf__ float tile[2][tile_dim][tile_pad_stride];

    uint32_t tiles_per_row = width / tile_dim; // 整除：非对齐 shape 上会丢掉边界残块
    uint32_t local_row = threadIdx.y;
    uint32_t local_col = threadIdx.x;
    uint32_t cnt = 0;

    for (uint32_t tile_id = blockIdx.x; tile_id < total_tiles; tile_id += gridDim.x) {
        uint32_t tile_row = tile_id / tiles_per_row;
        uint32_t tile_col = tile_id - tile_row * tiles_per_row;
        uint32_t input_row = tile_row * tile_dim + local_row;
        uint32_t input_col = tile_col * tile_dim + local_col;
        tile[cnt][local_row][local_col] = input[input_row * width + input_col]; // 无边界判断
        asc_syncthreads();

        uint32_t output_row = tile_col * tile_dim + local_row;
        uint32_t output_col = tile_row * tile_dim + local_col;
        output[output_row * height + output_col] = tile[cnt][local_col][local_row]; // 无边界判断

        cnt ^= 1;
    }
}

// ============================================================================
// 课后习题参考答案：在上面的双缓冲实现基础上做非对齐 shape 的功能泛化。
// 相比对照组只有三处变化：
//   1. tiles_per_row 用向上取整，保证边界上不足一个 tile 的残块也分到 tile；
//   2. 从 GM 加载前判断 (input_row, input_col) 是否落在输入矩阵内；
//   3. 向 GM 写回前判断 (output_row, output_col) 是否落在输出矩阵内。
// UB padding 布局、双缓冲轮换、转置读 tile[cnt][local_col][local_row] 都保持不变。
// 注意：两处边界判断只包住 GM 访问本身，asc_syncthreads() 必须留在 if 之外，
// 由 Thread Block 内所有线程无条件执行，否则越界线程不参与同步会导致挂死或读到脏数据。
// ============================================================================
template <uint32_t tile_dim, uint32_t tile_pad_stride>
__global__ __launch_bounds__(MAX_THREAD_COUNT) void transpose_unaligned_ub_padding_db_custom(
    float* output, const float* input, uint32_t width, uint32_t height, uint32_t total_tiles)
{
    __ubuf__ float tile[2][tile_dim][tile_pad_stride]; // 双缓冲：轮换缓冲区，去除尾部同步

    // 非对齐 shape 下 width 不再是 tile_dim 的整数倍，必须向上取整，
    // 且要与 host 侧 total_tiles 的算法保持一致
    uint32_t tiles_per_row = (width + tile_dim - 1) / tile_dim;
    uint32_t local_row = threadIdx.y;
    uint32_t local_col = threadIdx.x;
    uint32_t cnt = 0;

    for (uint32_t tile_id = blockIdx.x; tile_id < total_tiles; tile_id += gridDim.x) {
        uint32_t tile_row = tile_id / tiles_per_row;
        uint32_t tile_col = tile_id - tile_row * tiles_per_row;

        // 加载：越界的线程不读 GM，对应的 UB 元素也不会被写入
        uint32_t input_row = tile_row * tile_dim + local_row;
        uint32_t input_col = tile_col * tile_dim + local_col;
        if (input_row < height && input_col < width) {
            tile[cnt][local_row][local_col] = input[input_row * width + input_col];
        }
        asc_syncthreads(); // 只保留数据加载后的同步；必须由所有线程无条件执行

        // 写回：输出矩阵形状为 width x height，越界的线程不写 GM。
        // 该判断与加载判断严格互为镜像，因此读到的 tile 元素一定被写过。
        uint32_t output_row = tile_col * tile_dim + local_row;
        uint32_t output_col = tile_row * tile_dim + local_col;
        if (output_row < width && output_col < height) {
            output[output_row * height + output_col] = tile[cnt][local_col][local_row];
        }

        cnt ^= 1; // 切换到下一份缓冲区
    }
}

// Host 侧 golden 函数
void transpose_golden(const std::vector<float>& input, std::vector<float>& golden, uint32_t width, uint32_t height)
{
    for (uint32_t row = 0; row < height; ++row) {
        for (uint32_t col = 0; col < width; ++col) {
            golden[col * height + row] = input[row * width + col];
        }
    }
}

// 查询硬件 vector core 数（AIV 核数），不同环境上的物理核数不同，需要在运行时获取
uint32_t get_vector_core_num(uint32_t device_id)
{
    int64_t core_num = 0;
    aclError ret = aclrtGetDeviceInfo(device_id, ACL_DEV_ATTR_VECTOR_CORE_NUM, &core_num);
    if (ret != ACL_SUCCESS) {
        return 0;
    }
    return static_cast<uint32_t>(core_num);
}

constexpr uint32_t ceil_div(uint32_t value, uint32_t divisor)
{
    return (value + divisor - 1) / divisor;
}

// 选择运行哪一个核函数：对照组（未泛化）还是泛化版本
enum class KernelKind { Original, Generalized };

// 运行一个 shape：构造数据、启动一次核函数、校验结果并打印一行结论。
// 每次调用只启动一次核函数，便于用 msopprof 采集单个核函数的性能数据。
bool run_case(
    uint32_t height, uint32_t width, KernelKind kind, const char* note, uint32_t core_num, aclrtStream stream)
{
    uint32_t total_length = height * width;
    size_t byte_size = static_cast<size_t>(total_length) * sizeof(float);

    // 输入数据全部非零，这样输出缓冲区里残留的 0 一定意味着"漏写"
    std::vector<float> input(total_length);
    for (uint32_t i = 0; i < total_length; ++i) {
        input[i] = static_cast<float>(i % 4096) * 1.25f + 1.0f;
    }
    std::vector<float> golden(total_length);
    transpose_golden(input, golden, width, height);

    uint32_t tiles_per_row = ceil_div(width, TILE_DIM);
    uint32_t tiles_per_col = ceil_div(height, TILE_DIM);
    uint32_t total_tiles = tiles_per_row * tiles_per_col;
    // tile 总数可能小于物理核数，多启动的 Thread Block 只会空转，因此按 tile 总数截断
    uint32_t num_blocks = std::min(core_num, total_tiles);

    float* input_device = nullptr;
    float* output_device = nullptr;
    uint8_t* output_host = nullptr;
    aclrtMalloc((void**)&input_device, byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(input_device, byte_size, input.data(), byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMalloc((void**)&output_device, byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemset(output_device, byte_size, 0, byte_size);
    aclrtMallocHost((void**)(&output_host), byte_size);

    dim3 grid(num_blocks, 1, 1);
    dim3 block(TILE_DIM, TILE_DIM, 1);
    if (kind == KernelKind::Original) {
        transpose_ub_padding_db_custom<TILE_DIM, TILE_PAD_STRIDE><<<grid, block, 0, stream>>>(
            output_device, input_device, width, height, total_tiles);
    } else {
        transpose_unaligned_ub_padding_db_custom<TILE_DIM, TILE_PAD_STRIDE><<<grid, block, 0, stream>>>(
            output_device, input_device, width, height, total_tiles);
    }
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(output_host, byte_size, output_device, byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    float* result = reinterpret_cast<float*>(output_host);

    bool is_ok = true;
    uint32_t bad_index = 0;
    for (uint32_t i = 0; i < total_length; ++i) {
        if (std::fabs(result[i] - golden[i]) > 1e-3f) {
            is_ok = false;
            bad_index = i;
            break;
        }
    }

    std::cout << (is_ok ? "[ OK ] " : "[FAIL] ") << height << " x " << width << " -> " << width << " x " << height
              << " | tiles " << tiles_per_col << " x " << tiles_per_row << " = " << total_tiles << " | blocks "
              << num_blocks << " | " << note << std::endl;
    if (!is_ok) {
        // 输出侧下标 -> 输出矩阵二维坐标，便于定位是哪一块边界残块算错了
        std::cout << "       first mismatch at output index " << bad_index << " (row " << bad_index / height << ", col "
                  << bad_index % height << "): got " << result[bad_index] << ", expect " << golden[bad_index]
                  << std::endl;
    }

    aclrtFree(input_device);
    aclrtFree(output_device);
    aclrtFreeHost(output_host);
    return is_ok;
}

// 功能测试用例表（用例1~9）：每一个 shape 针对一类特定的边界情形，合起来覆盖
// "残块出现在哪个方向"、"残块有多大"、"tile 数少于物理核数" 这几个维度。
// 用例5 和用例9 完全对齐，作为回归用例——泛化前后都必须通过。
struct TransposeCase {
    uint32_t height;
    uint32_t width;
    const char* note;
};

void print_usage(const char* exe)
{
    std::cout << "用法:\n"
              << "  " << exe << "               # 默认：用例1~9 功能校验\n"
              << "  " << exe << " original      # 用例A：只在 1024x1024 上启动一次未泛化核函数（供 msopprof 采集）\n"
              << "  " << exe << " generalized   # 用例B：只在 1024x1024 上启动一次泛化核函数（供 msopprof 采集）"
              << std::endl;
}

int32_t main(int32_t argc, char* argv[])
{
    // 三种运行模式：默认做功能校验；另外两种各自只启动一次对应的核函数，
    // 这样 msopprof 采集到的就是指定核函数在 1024x1024 上的 Task Duration。
    std::string mode = (argc > 1) ? argv[1] : "verify";
    if (mode != "verify" && mode != "original" && mode != "generalized") {
        print_usage(argv[0]);
        return 1;
    }

    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);

    uint32_t core_num = get_vector_core_num(device_id);
    if (core_num == 0) {
        std::cout << "[Failed] Get vector core num failed!" << std::endl;
        return 1;
    }
    std::cout << "Vector core num: " << core_num << std::endl;

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    bool all_ok = true;
    if (mode == "verify") {
        const std::vector<TransposeCase> cases = {
            {1021, 1325, "用例1  主用例：行列均非 32 倍数，右下角 tile 同时缺行缺列"},
            {1021, 1024, "用例2  仅 height 非对齐：残块只在最后一行 tile"},
            {1024, 1325, "用例3  仅 width 非对齐：残块只在最后一列 tile"},
            {33, 31, "用例4  刚跨过一个 tile 边界：残块极小"},
            {32, 32, "用例5  正好一个 tile：无残块，回归验证"},
            {1, 1325, "用例6  单行：height < tile_dim"},
            {1021, 1, "用例7  单列：width < tile_dim，整除会得到 tiles_per_row = 0"},
            {1, 1, "用例8  极端最小 shape：只有 1 个线程有效"},
            {1024, 1024, "用例9  正文主 shape（对齐）：回归验证"},
        };

        // 功能泛化校验：泛化版本必须在全部 shape 上算对
        std::cout << "\n=== 功能校验（用例1~9）===" << std::endl;
        for (const TransposeCase& c : cases) {
            all_ok = run_case(c.height, c.width, KernelKind::Generalized, c.note, core_num, stream) && all_ok;
        }
    } else if (mode == "original") {
        std::cout << "\n=== 用例A 未泛化版本（正文 ub_padding_db），1024x1024 ===" << std::endl;
        all_ok = run_case(PERF_HEIGHT, PERF_WIDTH, KernelKind::Original, "用例A 未泛化", core_num, stream);
    } else {
        std::cout << "\n=== 用例B 已泛化版本（+ 取整 + 边界判断），1024x1024 ===" << std::endl;
        all_ok = run_case(PERF_HEIGHT, PERF_WIDTH, KernelKind::Generalized, "用例B 已泛化", core_num, stream);
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    std::cout << std::endl;
    if (all_ok) {
        std::cout << "[Success] Case accuracy verification passed." << std::endl;
    } else {
        std::cout << "[Failed] Case accuracy verification failed!" << std::endl;
    }
    return all_ok ? 0 : 1;
}
