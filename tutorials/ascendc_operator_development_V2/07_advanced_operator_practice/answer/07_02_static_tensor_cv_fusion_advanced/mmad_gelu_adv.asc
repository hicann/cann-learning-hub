/* !
 * \file mmad_gelu_adv.asc
 * \brief 基于静态 Tensor 的 MMAD-GELU 高性能 CV 融合样例。
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "mmad_gelu_adv_operator.h"
#include "data_utils.h"
#include <chrono>
#include <cstdlib>

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

#define ACL_CHECK(call)                                                                                               \
    do {                                                                                                              \
        aclError aclRet = (call);                                                                                     \
        if (aclRet != ACL_SUCCESS) {                                                                                  \
            fprintf(stderr, "ACL call failed: %s, ret=%d, line=%d\n", #call, static_cast<int>(aclRet), __LINE__);   \
            return 1;                                                                                                 \
        }                                                                                                             \
    } while (0)

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t M = 1920;
    constexpr uint32_t K = 2048;
    constexpr uint32_t N = 2048;
    constexpr uint32_t baseK = 64;
    constexpr uint32_t baseN = 256;
    constexpr uint32_t singleCoreK = K;
    constexpr uint32_t stepKb = 4;
    constexpr uint32_t baseM = 240;
    constexpr uint32_t stepKa = 4;
    constexpr uint32_t singleCoreN = 256;
    constexpr uint32_t singleCoreM = 480;
    constexpr uint32_t numBlocks =
        ((M + singleCoreM - 1) / singleCoreM) * ((N + singleCoreN - 1) / singleCoreN);

    size_t aFileSize = M * K * sizeof(int16_t);
    size_t bFileSize = K * N * sizeof(int16_t);
    size_t biasFileSize = N * sizeof(int16_t);
    size_t cFileSize = M * N * sizeof(float);

    ACL_CHECK(aclInit(nullptr));
    const char* deviceIdEnv = std::getenv("SAMPLE_DEVICE_ID");
    int32_t deviceId = deviceIdEnv == nullptr ? 0 : std::atoi(deviceIdEnv);
    ACL_CHECK(aclrtSetDevice(deviceId));
    aclrtStream stream = nullptr;
    ACL_CHECK(aclrtCreateStream(&stream));

    uint8_t* aHost;
    uint8_t* aDevice;
    ACL_CHECK(aclrtMallocHost((void**)(&aHost), aFileSize));
    ACL_CHECK(aclrtMalloc((void**)&aDevice, aFileSize, ACL_MEM_MALLOC_HUGE_FIRST));
    if (!ReadFile("./input/x1_gm.bin", aFileSize, aHost, aFileSize)) {
        fprintf(stderr, "Read x1_gm.bin failed.\n");
        return 1;
    }
    ACL_CHECK(aclrtMemcpy(aDevice, aFileSize, aHost, aFileSize, ACL_MEMCPY_HOST_TO_DEVICE));

    uint8_t* bHost;
    uint8_t* bDevice;
    ACL_CHECK(aclrtMallocHost((void**)(&bHost), bFileSize));
    ACL_CHECK(aclrtMalloc((void**)&bDevice, bFileSize, ACL_MEM_MALLOC_HUGE_FIRST));
    if (!ReadFile("./input/x2_gm.bin", bFileSize, bHost, bFileSize)) {
        fprintf(stderr, "Read x2_gm.bin failed.\n");
        return 1;
    }
    ACL_CHECK(aclrtMemcpy(bDevice, bFileSize, bHost, bFileSize, ACL_MEMCPY_HOST_TO_DEVICE));

    uint8_t* biasHost;
    uint8_t* biasDevice;
    ACL_CHECK(aclrtMallocHost((void**)(&biasHost), biasFileSize));
    ACL_CHECK(aclrtMalloc((void**)&biasDevice, biasFileSize, ACL_MEM_MALLOC_HUGE_FIRST));
    if (!ReadFile("./input/bias_gm.bin", biasFileSize, biasHost, biasFileSize)) {
        fprintf(stderr, "Read bias_gm.bin failed.\n");
        return 1;
    }
    ACL_CHECK(aclrtMemcpy(biasDevice, biasFileSize, biasHost, biasFileSize, ACL_MEMCPY_HOST_TO_DEVICE));

    uint8_t* cHost;
    uint8_t* cDevice;
    ACL_CHECK(aclrtMallocHost((void**)(&cHost), cFileSize));
    ACL_CHECK(aclrtMalloc((void**)&cDevice, cFileSize, ACL_MEM_MALLOC_HUGE_FIRST));

    const char* warmupEnv = std::getenv("CV_WARMUP_COUNT");
    const char* benchmarkEnv = std::getenv("CV_BENCHMARK_COUNT");
    uint32_t warmupCount = warmupEnv == nullptr ? 3 : static_cast<uint32_t>(std::strtoul(warmupEnv, nullptr, 10));
    uint32_t benchmarkCount =
        benchmarkEnv == nullptr ? 20 : static_cast<uint32_t>(std::strtoul(benchmarkEnv, nullptr, 10));
    if (benchmarkCount == 0) {
        benchmarkCount = 1;
    }
    for (uint32_t i = 0; i < warmupCount; ++i) {
        mmad_gelu_adv<M, K, N, baseM, baseK, baseN, singleCoreM, singleCoreK, singleCoreN, stepKa, stepKb>
            <<<numBlocks, 0, stream>>>(aDevice, bDevice, biasDevice, cDevice);
    }
    ACL_CHECK(aclrtSynchronizeStream(stream));
    auto begin = std::chrono::steady_clock::now();
    for (uint32_t i = 0; i < benchmarkCount; ++i) {
        mmad_gelu_adv<M, K, N, baseM, baseK, baseN, singleCoreM, singleCoreK, singleCoreN, stepKa, stepKb>
            <<<numBlocks, 0, stream>>>(aDevice, bDevice, biasDevice, cDevice);
    }
    ACL_CHECK(aclrtSynchronizeStream(stream));
    auto end = std::chrono::steady_clock::now();
    double averageUs =
        std::chrono::duration<double, std::micro>(end - begin).count() / static_cast<double>(benchmarkCount);
    printf("benchmark_average_us=%.3f\n", averageUs);

    ACL_CHECK(aclrtMemcpy(cHost, cFileSize, cDevice, cFileSize, ACL_MEMCPY_DEVICE_TO_HOST));
    if (!WriteFile("./output/output.bin", cHost, cFileSize)) {
        fprintf(stderr, "Write output.bin failed.\n");
        return 1;
    }

    ACL_CHECK(aclrtFree(aDevice));
    ACL_CHECK(aclrtFreeHost(aHost));
    ACL_CHECK(aclrtFree(bDevice));
    ACL_CHECK(aclrtFreeHost(bHost));
    ACL_CHECK(aclrtFree(biasDevice));
    ACL_CHECK(aclrtFreeHost(biasHost));
    ACL_CHECK(aclrtFree(cDevice));
    ACL_CHECK(aclrtFreeHost(cHost));

    ACL_CHECK(aclrtDestroyStream(stream));
    ACL_CHECK(aclrtResetDevice(deviceId));
    ACL_CHECK(aclFinalize());

    printf("MMAD-GELU operator completed.\n");
    return 0;
}
