#include <cstdint>

#include <torch/extension.h>

#include "kernel_operator.h"
#include "torch_npu/csrc/core/npu/NPUStream.h"

namespace ascendc_ops {
namespace {
__aicore__ __inline__ constexpr uint32_t DivCeil(uint32_t a, uint32_t b)
{
    return (a + b - 1U) / b;
}

constexpr int64_t GELU_TOTAL_M = 9216;
constexpr int64_t GELU_TOTAL_N = 2048;
constexpr uint32_t TOTAL_M = static_cast<uint32_t>(GELU_TOTAL_M);
constexpr uint32_t TOTAL_N = static_cast<uint32_t>(GELU_TOTAL_N);
constexpr uint32_t SINGLE_CORE_M = 256U;
constexpr uint32_t SINGLE_CORE_N = 2048U;
constexpr uint32_t TILE_LEN = 2U * SINGLE_CORE_N;
constexpr uint32_t GELU_BLOCK_NUM = DivCeil(TOTAL_M, SINGLE_CORE_M) * DivCeil(TOTAL_N, SINGLE_CORE_N);
constexpr float COEFF_A = 0.044715f;
constexpr float COEFF_B = -1.595769f;

template <uint32_t totalM, uint32_t totalN, uint32_t singleCoreM, uint32_t singleCoreN, uint32_t tileLen>
class KernelGelu {
public:
    __aicore__ inline KernelGelu() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y)
    {
        AscendC::InitSocState();
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(y));
        InitGMOffsets();
    }

    __aicore__ inline void InitGMOffsets()
    {
        uint32_t blockIdx = AscendC::GetBlockIdx();
        constexpr uint32_t mIndex = DivCeil(totalM, singleCoreM);
        constexpr uint32_t nIndex = DivCeil(totalN, singleCoreN);
        constexpr uint32_t tailSingleCoreM = totalM - (mIndex - 1U) * singleCoreM;
        constexpr uint32_t tailSingleCoreN = totalN - (nIndex - 1U) * singleCoreN;

        uint32_t mIterIdx = blockIdx % mIndex;
        uint32_t nIterIdx = blockIdx / mIndex;
        actualSingleCoreM = (mIterIdx == (mIndex - 1U)) ? tailSingleCoreM : singleCoreM;
        actualSingleCoreN = (nIterIdx == (nIndex - 1U)) ? tailSingleCoreN : singleCoreN;

        uint64_t gmOffset = static_cast<uint64_t>(mIterIdx) * singleCoreM * totalN +
                            static_cast<uint64_t>(nIterIdx) * singleCoreN;
        xGm = xGm[gmOffset];
        yGm = yGm[gmOffset];
    }

    __aicore__ inline void GeluCompute(
        const AscendC::LocalTensor<float>& xLocal, const AscendC::LocalTensor<float>& yLocal, uint32_t n)
    {
        AscendC::Mul(yLocal, xLocal, xLocal, n);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(yLocal, yLocal, xLocal, n);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(yLocal, yLocal, COEFF_A, n);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Add(yLocal, xLocal, yLocal, n);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(yLocal, yLocal, COEFF_B, n);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Exp(yLocal, yLocal, n);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Adds(yLocal, yLocal, 1.0f, n);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Div(yLocal, xLocal, yLocal, n);
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalTensor<int8_t> ioPing(AscendC::TPosition::VECCALC, IO_ADDR_PING, tileLen);
        AscendC::LocalTensor<int8_t> ioPong(AscendC::TPosition::VECCALC, IO_ADDR_PONG, tileLen);
        AscendC::LocalTensor<float> xPing(AscendC::TPosition::VECCALC, X_ADDR_PING, tileLen);
        AscendC::LocalTensor<float> yPing(AscendC::TPosition::VECCALC, Y_ADDR_PING, tileLen);
        AscendC::LocalTensor<float> xPong(AscendC::TPosition::VECCALC, X_ADDR_PONG, tileLen);
        AscendC::LocalTensor<float> yPong(AscendC::TPosition::VECCALC, Y_ADDR_PONG, tileLen);

        constexpr uint32_t tileRow = tileLen / singleCoreN;
        uint32_t loopNum = DivCeil(actualSingleCoreM, tileRow);
        uint32_t tailRow = actualSingleCoreM - (loopNum - 1U) * tileRow;

        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID1);

        for (uint32_t loopIdx = 0; loopIdx < loopNum; ++loopIdx) {
            uint32_t copyRows = (loopIdx == (loopNum - 1U)) ? tailRow : tileRow;
            int32_t eventId = ((loopIdx & 1U) == 0U ? EVENT_ID0 : EVENT_ID1);
            AscendC::LocalTensor<int8_t>& ioLocal = ((loopIdx & 1U) == 0U ? ioPing : ioPong);
            AscendC::LocalTensor<float>& xLocal = ((loopIdx & 1U) == 0U ? xPing : xPong);
            AscendC::LocalTensor<float>& yLocal = ((loopIdx & 1U) == 0U ? yPing : yPong);

            AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(eventId);

            uint32_t blockLen = actualSingleCoreN * sizeof(int8_t);
            uint32_t gmStride = (totalN - actualSingleCoreN) * sizeof(int8_t);
            AscendC::DataCopyExtParams copyParams = {
                static_cast<uint16_t>(copyRows), blockLen, gmStride, 0U, 0U};
            AscendC::DataCopyPadExtParams<int8_t> padParams = {false, 0U, 0U, 0};
            AscendC::DataCopyPad<int8_t>(ioLocal, xGm[loopIdx * tileRow * totalN], copyParams, padParams);

            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(eventId);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(eventId);
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(eventId);

            uint32_t elementCount = copyRows * singleCoreN;
            AscendC::LocalTensor<half> inputHalf = yLocal.ReinterpretCast<half>();
            AscendC::Cast(inputHalf, ioLocal, AscendC::RoundMode::CAST_NONE, elementCount);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Cast(xLocal, inputHalf, AscendC::RoundMode::CAST_NONE, elementCount);
            AscendC::PipeBarrier<PIPE_V>();
            GeluCompute(xLocal, yLocal, elementCount);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::LocalTensor<int16_t> outputInt16 = xLocal.ReinterpretCast<int16_t>();
            AscendC::Cast(outputInt16, yLocal, AscendC::RoundMode::CAST_TRUNC, elementCount);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::LocalTensor<half> outputHalf = yLocal.ReinterpretCast<half>();
            AscendC::Cast(outputHalf, outputInt16, AscendC::RoundMode::CAST_NONE, elementCount);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Cast(ioLocal, outputHalf, AscendC::RoundMode::CAST_TRUNC, elementCount);
            AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(eventId);

            AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(eventId);
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(eventId);

            copyParams.srcStride = 0U;
            copyParams.dstStride = gmStride;
            AscendC::DataCopyPad<int8_t>(yGm[loopIdx * tileRow * totalN], ioLocal, copyParams);
            AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(eventId);
        }

        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID1);
    }

private:
    static constexpr uint32_t IO_ADDR_PING = 0U;
    static constexpr uint32_t IO_ADDR_PONG = IO_ADDR_PING + tileLen * sizeof(int8_t);
    static constexpr uint32_t X_ADDR_PING = IO_ADDR_PONG + tileLen * sizeof(int8_t);
    static constexpr uint32_t X_ADDR_PONG = X_ADDR_PING + tileLen * sizeof(float);
    static constexpr uint32_t Y_ADDR_PING = X_ADDR_PONG + tileLen * sizeof(float);
    static constexpr uint32_t Y_ADDR_PONG = Y_ADDR_PING + tileLen * sizeof(float);

    AscendC::GlobalTensor<int8_t> xGm;
    AscendC::GlobalTensor<int8_t> yGm;
    uint32_t actualSingleCoreM = 0U;
    uint32_t actualSingleCoreN = 0U;
};

__aicore__ inline void RunGelu(GM_ADDR x, GM_ADDR y)
{
    KernelGelu<TOTAL_M, TOTAL_N, SINGLE_CORE_M, SINGLE_CORE_N, TILE_LEN> op;
    op.Init(x, y);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}
} // namespace

extern "C" __global__ __vector__ void gelu_custom_kernel(GM_ADDR x, GM_ADDR y)
{
    RunGelu(x, y);
}

// TODO: add the SuperKernel argument struct, entry and SK_BIND here.

at::Tensor gelu_custom_impl_npu(const at::Tensor& x)
{
    TORCH_CHECK(x.dim() == 2 && x.size(0) == GELU_TOTAL_M && x.size(1) == GELU_TOTAL_N,
        "gelu_custom only supports shape [", GELU_TOTAL_M, ", ", GELU_TOTAL_N, "] in this homework sample.");
    TORCH_CHECK(x.scalar_type() == at::ScalarType::Char, "gelu_custom only supports int8 tensors.");
    TORCH_CHECK(x.is_contiguous(), "gelu_custom expects a contiguous tensor.");

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    at::Tensor y = at::empty(x.sizes(), x.options());
    gelu_custom_kernel<<<GELU_BLOCK_NUM, 0, stream>>>(static_cast<uint8_t*>(x.mutable_data_ptr()),
        static_cast<uint8_t*>(y.mutable_data_ptr()));
    return y;
}
} // namespace ascendc_ops

namespace {
at::Tensor GeluCustomMeta(const at::Tensor& x)
{
    TORCH_CHECK(x.dim() == 2 && x.size(0) == ascendc_ops::GELU_TOTAL_M && x.size(1) == ascendc_ops::GELU_TOTAL_N,
        "gelu_custom only supports shape [", ascendc_ops::GELU_TOTAL_M, ", ", ascendc_ops::GELU_TOTAL_N,
        "] in this homework sample.");
    TORCH_CHECK(x.scalar_type() == at::ScalarType::Char, "gelu_custom only supports int8 tensors.");
    return at::empty_like(x);
}
} // namespace

TORCH_LIBRARY_FRAGMENT(ascendc_ops, m)
{
    m.def("gelu_custom(Tensor x) -> Tensor");
}

TORCH_LIBRARY_IMPL(ascendc_ops, Meta, m)
{
    m.impl("gelu_custom", TORCH_FN(GeluCustomMeta));
}

TORCH_LIBRARY_IMPL(ascendc_ops, PrivateUse1, m)
{
    m.impl("gelu_custom", TORCH_FN(ascendc_ops::gelu_custom_impl_npu));
}
