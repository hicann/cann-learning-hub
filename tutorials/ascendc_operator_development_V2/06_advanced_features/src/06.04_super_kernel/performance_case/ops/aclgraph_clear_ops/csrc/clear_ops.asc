#include <pybind11/pybind11.h>
#include <torch/extension.h>

#include <limits>

#include "third_party/acl/inc/acl/acl_rt.h"
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "kernel_operator.h"

#define NOP_1 __asm__ volatile("NOP")
#define NOP_2 NOP_1; NOP_1
#define NOP_4 NOP_2; NOP_2
#define NOP_8 NOP_4; NOP_4
#define NOP_16 NOP_8; NOP_8
#define NOP_32 NOP_16; NOP_16
#define NOP_64 NOP_32; NOP_32
#define NOP_128 NOP_64; NOP_64
#define NOP_256 NOP_128; NOP_128
#define NOP_512 NOP_256; NOP_256
#define NOP_1024 NOP_512; NOP_512
#define NOP_2048 NOP_1024; NOP_1024
#define NOP_4096 NOP_2048; NOP_2048
#define NOP_8192 NOP_4096; NOP_4096

__aicore__ inline void clear_ops_impl(){
    NOP_8192;
}

extern "C" __global__ __mix__(1,2) void clear_ops()
{
    clear_ops_impl();
    AscendC::SyncAll<false>();
}

template<uint32_t splitidx>
__sk__ __mix__(1,2) void clear_ops_sk()
{
    clear_ops_impl();
    AscendC::SyncAll<false>();
}

SK_BIND(clear_ops, 0, clear_ops_sk<0>, clear_ops_sk<1>, clear_ops_sk<2>, clear_ops_sk<3>);

namespace ascendc_ops {
uint32_t get_current_aicore_num()
{
    int32_t device_id = 0;
    auto ret = aclrtGetDevice(&device_id);
    TORCH_CHECK(ret == ACL_ERROR_NONE, "Failed to get current NPU device id, acl error: ", ret);

    int64_t aicore_num = 0;
    ret = aclrtGetDeviceInfo(static_cast<uint32_t>(device_id), ACL_DEV_ATTR_AICORE_CORE_NUM, &aicore_num);
    TORCH_CHECK(ret == ACL_ERROR_NONE, "Failed to get NPU AI Core num for device ", device_id, ", acl error: ", ret);
    TORCH_CHECK(aicore_num > 0 && aicore_num <= std::numeric_limits<uint32_t>::max(),
                "Invalid NPU AI Core num: ", aicore_num);
    return static_cast<uint32_t>(aicore_num);
}

at::Tensor run_clear_ops(const at::Tensor &x)
{
    auto acl_stream = c10_npu::getCurrentNPUStream().stream(true);
    uint32_t blockDim = get_current_aicore_num();
    clear_ops<<<blockDim, nullptr, acl_stream>>>();
    return x;
}

}  // namespace ascendc_ops
