#include <cstddef>
#include <cstdint>
#include <iostream>

#include "graph/custom_op.h"
#include "graph/operator_reg.h"
#include "kernel_operator.h"

namespace {
constexpr uint32_t BLOCK_NUM = 8U;
constexpr uint32_t BLOCK_LENGTH = 2048U;
constexpr size_t INPUT_X_INDEX = 0U;
constexpr size_t INPUT_Y_INDEX = 1U;
constexpr size_t OUTPUT_Z_INDEX = 0U;
}  // namespace

template <uint32_t block_length>
__global__ __vector__ void launch_add_kernel(__gm__ float *x, __gm__ float *y, __gm__ float *z)
{
    AscendC::InitSocState();

    AscendC::GlobalTensor<float> x_gm, y_gm, z_gm;
    x_gm.SetGlobalBuffer(x + block_idx * block_length, block_length);
    y_gm.SetGlobalBuffer(y + block_idx * block_length, block_length);
    z_gm.SetGlobalBuffer(z + block_idx * block_length, block_length);

    AscendC::LocalMemAllocator<AscendC::Hardware::UB> allocator;
    auto x_local = allocator.Alloc<float, block_length>();
    auto y_local = allocator.Alloc<float, block_length>();
    auto z_local = allocator.Alloc<float, block_length>();

    AscendC::DataCopy(x_local, x_gm, block_length);
    AscendC::DataCopy(y_local, y_gm, block_length);
    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::Add(z_local, x_local, y_local, block_length);
    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::DataCopy(z_gm, z_local, block_length);
    AscendC::PipeBarrier<PIPE_ALL>();
}

namespace ge {
class LaunchAddCustom : public EagerExecuteOp, public ShapeInferOp {
public:
    graphStatus InferShape(gert::InferShapeContext *ctx) override
    {
        if (ctx == nullptr || ctx->GetInputShape(INPUT_X_INDEX) == nullptr ||
            ctx->GetOutputShape(OUTPUT_Z_INDEX) == nullptr) {
            return GRAPH_FAILED;
        }
        *ctx->GetOutputShape(OUTPUT_Z_INDEX) = *ctx->GetInputShape(INPUT_X_INDEX);
        return GRAPH_SUCCESS;
    }

    graphStatus InferDataType(gert::InferDataTypeContext *ctx) override
    {
        if (ctx == nullptr) {
            return GRAPH_FAILED;
        }
        return ctx->SetOutputDataType(OUTPUT_Z_INDEX, ctx->GetInputDataType(INPUT_X_INDEX));
    }

    graphStatus Execute(gert::EagerOpExecutionContext *ctx) override
    {
        if (ctx == nullptr) {
            return GRAPH_FAILED;
        }
        const gert::Tensor *x = ctx->GetInputTensor(INPUT_X_INDEX);
        const gert::Tensor *y = ctx->GetInputTensor(INPUT_Y_INDEX);
        if (x == nullptr || y == nullptr || x->GetDataType() != DT_FLOAT || y->GetDataType() != DT_FLOAT ||
            x->GetShapeSize() != BLOCK_NUM * BLOCK_LENGTH || y->GetShapeSize() != BLOCK_NUM * BLOCK_LENGTH) {
            std::cerr << "LaunchAddCustom expects float inputs with shape [8, 2048]." << std::endl;
            return GRAPH_FAILED;
        }

        gert::Tensor *z = ctx->MallocOutputTensor(OUTPUT_Z_INDEX, x->GetShape(), x->GetFormat(), x->GetDataType());
        if (z == nullptr) {
            return GRAPH_FAILED;
        }

        launch_add_kernel<BLOCK_LENGTH><<<BLOCK_NUM, nullptr, ctx->GetStream()>>>(
            static_cast<float *>(const_cast<void *>(x->GetAddr())),
            static_cast<float *>(const_cast<void *>(y->GetAddr())),
            static_cast<float *>(z->GetAddr()));
        return GRAPH_SUCCESS;
    }
};

REG_OP(LaunchAddCustom)
    .INPUT(x, TensorType({DT_FLOAT}))
    .INPUT(y, TensorType({DT_FLOAT}))
    .OUTPUT(z, TensorType({DT_FLOAT}))
    .OP_END_FACTORY_REG(LaunchAddCustom);

REG_AUTO_MAPPING_OP(LaunchAddCustom);
}  // namespace ge
