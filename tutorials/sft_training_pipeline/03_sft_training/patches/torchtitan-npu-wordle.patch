index 0000000..d2187bd
--- /dev/null
+++ b/torchtitan_npu/models/qwen3/ulysses.py
@@ -0,0 +1,86 @@
+# Copyright (c) 2026 Huawei Technologies Co., Ltd. All rights reserved.
+#
+# This source code is licensed under the BSD-style license found in the
+# LICENSE file in the root directory of this source tree.
+
+"""Ulysses context parallelism for the current torchtitan Qwen3 attention API.
+
+Qwen3 attention receives tensors in ``(batch, sequence, heads, head_dim)``
+layout. Each rank starts with a sequence shard; Ulysses exchanges head
+shards for sequence shards before attention and reverses that exchange after
+attention. Hooks are installed before torchtitan's model parallelizer runs.
+"""
+
+from functools import partial
+from typing import Any
+
+import torch
+import torch.distributed as dist
+from torch.distributed.device_mesh import DeviceMesh
+from torchtitan.models.common.attention import ScaledDotProductAttention
+
+
+class _AllToAll(torch.autograd.Function):
+    """Differentiable all-to-all with independently selected dimensions."""
+
+    @staticmethod
+    def forward(ctx, tensor: torch.Tensor, mesh: DeviceMesh, scatter_dim: int, gather_dim: int):
+        ctx.mesh = mesh
+        ctx.scatter_dim = scatter_dim
+        ctx.gather_dim = gather_dim
+        world_size = mesh.size()
+        if tensor.size(scatter_dim) % world_size != 0:
+            raise ValueError(
+                f"Ulysses all-to-all requires dimension {scatter_dim} size "
+                f"{tensor.size(scatter_dim)} divisible by CP degree {world_size}"
+            )
+        chunks = [chunk.contiguous() for chunk in tensor.chunk(world_size, dim=scatter_dim)]
+        outputs = [torch.empty_like(chunks[0]) for _ in range(world_size)]
+        dist.all_to_all(outputs, chunks, group=mesh.get_group())
+        return torch.cat(outputs, dim=gather_dim)
+
+    @staticmethod
+    def backward(ctx, grad_output: torch.Tensor):
+        world_size = ctx.mesh.size()
+        if grad_output.size(ctx.gather_dim) % world_size != 0:
+            raise ValueError(
+                f"Ulysses all-to-all requires dimension {ctx.gather_dim} size "
+                f"{grad_output.size(ctx.gather_dim)} divisible by CP degree {world_size}"
+            )
+        chunks = [chunk.contiguous() for chunk in grad_output.chunk(world_size, dim=ctx.gather_dim)]
+        outputs = [torch.empty_like(chunks[0]) for _ in range(world_size)]
+        dist.all_to_all(outputs, chunks, group=ctx.mesh.get_group())
+        return torch.cat(outputs, dim=ctx.scatter_dim), None, None, None
+
+
+def _all_to_all(tensor: torch.Tensor, mesh: DeviceMesh, scatter_dim: int, gather_dim: int) -> torch.Tensor:
+    return _AllToAll.apply(tensor, mesh, scatter_dim, gather_dim)
+
+
+def _pre_hook(module: torch.nn.Module, args: tuple[Any, ...], kwargs: dict[str, Any], mesh: DeviceMesh):
+    if len(args) < 3:
+        raise TypeError("Qwen3 attention expects q, k, and v as its first three arguments")
+    q, k, v = args[:3]
+    q = _all_to_all(q, mesh, scatter_dim=2, gather_dim=1)
+    k = _all_to_all(k, mesh, scatter_dim=2, gather_dim=1)
+    v = _all_to_all(v, mesh, scatter_dim=2, gather_dim=1)
+    return (q, k, v, *args[3:]), kwargs
+
+
+def _post_hook(module: torch.nn.Module, args: tuple[Any, ...], output: torch.Tensor, mesh: DeviceMesh):
+    return _all_to_all(output, mesh, scatter_dim=1, gather_dim=2)
+
+
+def apply_ulysses_cp(attention_modules: list[torch.nn.Module], cp_mesh: DeviceMesh) -> None:
+    """Install Ulysses pre/post all-to-all hooks on Qwen3 SDPA modules."""
+    if not attention_modules:
+        raise ValueError("Cannot apply Ulysses CP to an empty attention module list")
+    if not all(isinstance(module, ScaledDotProductAttention) for module in attention_modules):
+        kinds = sorted({type(module).__name__ for module in attention_modules})
+        raise TypeError(f"Qwen3 Ulysses CP expects ScaledDotProductAttention, got {kinds}")
+    for module in attention_modules:
+        if getattr(module, "_torchtitan_npu_ulysses_cp", False):
+            continue
+        module.register_forward_pre_hook(partial(_pre_hook, mesh=cp_mesh), with_kwargs=True)
+        module.register_forward_hook(partial(_post_hook, mesh=cp_mesh))
+        module._torchtitan_npu_ulysses_cp = True
diff --git a/torchtitan_npu/override/qwen3/varlen_attention.py b/torchtitan_npu/override/qwen3/varlen_attention.py
new file mode 100644
index 0000000..02cb641
--- /dev/null
+++ b/torchtitan_npu/override/qwen3/varlen_attention.py
@@ -0,0 +1,89 @@
+# Copyright (c) 2026 Huawei Technologies Co., Ltd. All rights reserved.
+#
+# This source code is licensed under the BSD-style license found in the
+# LICENSE file in the root directory of this source tree.
+
+"""Override: run Qwen3 varlen attention on CANN FA v3 (TND layout).
+
+``AscVarlenAttention`` keeps the upstream ``VarlenAttention`` contract — the
+trainer still builds ``VarlenMetadata`` from the per-document positions — and
+replaces only the computation: BSND is flattened to TND and the per-document
+cumulative lengths become ``actual_seq_qlen`` / ``actual_seq_kvlen``.
+"""
+
+from dataclasses import dataclass
+
+import torch
+from torchtitan.config import derive, override
+from torchtitan.models.common.attention import VarlenAttention
+
+_MASK_SIZE = 2048
+_SPARSE_MODE_VARLEN = 7  # per-document causal (varlen) in CANN FA v3
+
+
+class AscVarlenAttention(VarlenAttention):
+    @dataclass(kw_only=True, slots=True)
+    class Config(VarlenAttention.Config):
+        pass
+
+    def _causal_mask_for(self, query: torch.Tensor) -> torch.Tensor:
+        mask = getattr(self, "_causal_mask", None)
+        if mask is None or mask.device != query.device:
+            self._causal_mask = mask = torch.triu(
+                torch.ones(_MASK_SIZE, _MASK_SIZE, dtype=torch.bool, device=query.device),
+                diagonal=1,
+            )
+        return mask
+
+    def forward(
+        self,
+        q_BLNH: torch.Tensor,
+        k_BLNH: torch.Tensor,
+        v_BLNH: torch.Tensor,
+        *,
+        attention_masks,
+        scale: float | None = None,
+        enable_gqa: bool = False,
+        **kwargs,
+    ) -> torch.Tensor:
+        del enable_gqa, kwargs  # GQA head counts are carried by the K/V shapes.
+        batch, length, heads, head_dim = q_BLNH.shape
+        dtype = q_BLNH.dtype
+
+        # BSND -> TND; FA v3 consumes bf16/fp16 only.
+        query, key, value = (
+            tensor.reshape(batch * length, tensor.size(2), head_dim).to(torch.bfloat16)
+            for tensor in (q_BLNH, k_BLNH, v_BLNH)
+        )
+
+        # FA v3 takes the per-document cumulative lengths on CPU, without the
+        # leading 0.
+        actual_seq = attention_masks.cu_seq_q.to(torch.int64).cpu()[1:]
+
+        output = torch.ops.npu.npu_fusion_attention_v3(
+            query=query,
+            key=key,
+            value=value,
+            head_num=heads,
+            input_layout="TND",
+            atten_mask=self._causal_mask_for(query),
+            scale=head_dim**-0.5 if scale is None else scale,
+            keep_prob=1.0,
+            pre_tockens=length,
+            next_tockens=0,
+            actual_seq_qlen=actual_seq,
+            actual_seq_kvlen=actual_seq,
+            sparse_mode=_SPARSE_MODE_VARLEN,
+        )[0]
+
+        return output.view(batch, length, heads, head_dim).to(dtype)
+
+
+@override(
+    target=VarlenAttention.Config,
+    fqns=["model_spec.model.layers.*.attention.inner_attention"],
+    exact=True,
+    description="Use CANN TND attention for Qwen3 varlen layers",
+)
+def asc(cfg: VarlenAttention.Config) -> AscVarlenAttention.Config:
+    return derive(cfg, AscVarlenAttention.Config)
