+++ b/torchtitan_npu/models/qwen3/parallelize.py
@@ -0,0 +1,78 @@
+# Copyright (c) 2026 Huawei Technologies Co., Ltd. All rights reserved.
+# Copyright (c) Meta Platforms, Inc. and affiliates.
+#
+# This source code is licensed under the BSD-style license found in the
+# LICENSE file in the root directory of this source tree.
+
+"""Qwen3 parallelization with the NPU Ulysses CP hook."""
+
+import torchtitan.models.qwen3.parallelize as _upstream
+from torchtitan.config import CompileConfig, ParallelismConfig, TrainingConfig
+from torchtitan.distributed import ParallelDims
+from torchtitan.distributed.activation_checkpoint import ActivationCheckpointingConfig
+from torchtitan.models.common.attention import ScaledDotProductAttention
+from torchtitan.models.qwen3 import Qwen3Model
+
+from .ulysses import apply_ulysses_cp
+
+
+def parallelize_qwen3(
+    model: Qwen3Model,
+    *,
+    parallel_dims: ParallelDims,
+    training: TrainingConfig,
+    parallelism: ParallelismConfig,
+    compile_config: CompileConfig,
+    ac_config: ActivationCheckpointingConfig,
+    dump_folder: str,
+    skip_dp: bool = False,
+):
+    """Use upstream Qwen3 setup with Ulysses CP where applicable."""
+    if parallel_dims.cp_enabled:
+        cp_degree = parallel_dims.cp
+        layers = list(model.layers.values())
+        if not layers:
+            raise ValueError("Qwen3 model has no decoder layers; cannot enable Ulysses CP")
+        attention_modules = [layer.attention.inner_attention for layer in layers]
+        n_heads = layers[0].attention.n_heads
+        if n_heads % cp_degree != 0:
+            raise ValueError(
+                f"Ulysses CP requires n_heads={n_heads} divisible by cp_degree={cp_degree}"
+            )
+        # The current torchtitan Qwen3 recipe uses FlexAttention.  Its native
+        # CP wrapper correctly all-gathers K/V while retaining the sharded
+        # query mask.  Use the NPU Ulysses exchange for SDPA modules (the
+        # backend for which this patch is needed), and retain native CP for
+        # FlexAttention/other current backends.
+        use_ulysses = all(
+            isinstance(module, ScaledDotProductAttention)
+            for module in attention_modules
+        )
+        if use_ulysses:
+            apply_ulysses_cp(attention_modules, parallel_dims.get_mesh("cp"))
+            upstream_cp = _upstream.apply_cp_to_forward
+            _upstream.apply_cp_to_forward = lambda _modules, _mesh: None
+            try:
+                return _upstream.parallelize_qwen3(
+                    model=model,
+                    parallel_dims=parallel_dims,
+                    training=training,
+                    parallelism=parallelism,
+                    compile_config=compile_config,
+                    ac_config=ac_config,
+                    dump_folder=dump_folder,
+                    skip_dp=skip_dp,
+                )
+            finally:
+                _upstream.apply_cp_to_forward = upstream_cp
+
+    return _upstream.parallelize_qwen3(
+        model=model,
+        parallel_dims=parallel_dims,
+        training=training,
+        parallelism=parallelism,
+        compile_config=compile_config,
+        ac_config=ac_config,
+        dump_folder=dump_folder,
+        skip_dp=skip_dp,
+    )
diff --git a/torchtitan_npu/models/qwen3/ulysses.py b/torchtitan_npu/models/qwen3/ulysses.py
