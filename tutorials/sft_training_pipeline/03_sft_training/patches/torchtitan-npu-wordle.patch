+# Copyright (c) 2026 Huawei Technologies Co., Ltd. All rights reserved.
+# Copyright (c) Meta Platforms, Inc. and affiliates.
+#
+# This source code is licensed under the BSD-style license found in the
+# LICENSE file in the root directory of this source tree.
+
+from dataclasses import replace
+
+from torchtitan.models.qwen3 import (
+    Qwen3StateDictAdapter,
+)
+from torchtitan.models.qwen3 import (
+    model_registry as _upstream_model_registry,
+)
+
+from torchtitan_npu.models.qwen3.parallelize import parallelize_qwen3
+
+
+def model_registry(flavor: str, attn_backend: str = "flex"):
+    """NPU Qwen3 registry: upstream backend selection plus NPU hooks.
+
+    ``attn_backend`` mirrors the upstream signature (``flex`` / ``flex_flash`` /
+    ``varlen``); the TND recipe passes ``varlen`` and then activates the
+    AscendC override that replaces the inner attention.
+    """
+    spec = _upstream_model_registry(flavor, attn_backend=attn_backend)
+    # ``ModelSpec`` gained/removed optional fields across torchtitan releases;
+    # replacing only the two hooks keeps this adapter compatible with the
+    # current clone while preserving every upstream field.
+    return replace(
+        spec,
+        parallelize_fn=parallelize_qwen3,
+        state_dict_adapter=Qwen3StateDictAdapter,
+    )
diff --git a/torchtitan_npu/models/qwen3/config_registry.py b/torchtitan_npu/models/qwen3/config_registry.py
