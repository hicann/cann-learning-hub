+++ b/torchtitan_npu/models/qwen3/config_registry.py
@@ -0,0 +1,77 @@
+# Copyright (c) 2026 Huawei Technologies Co., Ltd. All rights reserved.
+# Copyright (c) Meta Platforms, Inc. and affiliates.
+#
+# This source code is licensed under the BSD-style license found in the
+# LICENSE file in the root directory of this source tree.
+
+"""Qwen3 Wordle SFT recipe for the current torchtitan configuration API."""
+
+from torchtitan.components.optimizer import default_adamw
+from torchtitan.hf_datasets.text_datasets import ChatDataLoader
+from torchtitan.models.qwen3.config_registry import qwen3_1_7b
+from torchtitan.trainer import Trainer
+
+from torchtitan_npu.models.qwen3 import model_registry
+
+
+def _process_wordle_sample(sample: dict) -> list[dict]:
+    """Convert a Wordle record into the multi-turn chat message list."""
+    if "messages" in sample:
+        messages = list(sample["messages"])
+    elif "prompt" in sample and "completion" in sample:
+        messages = list(sample["prompt"]) + list(sample["completion"])
+    else:
+        raise KeyError(
+            "Wordle sample must have 'messages' or 'prompt'+'completion'. "
+            f"Got keys: {list(sample)}"
+        )
+    for message in messages:
+        if isinstance(message.get("content"), list):
+            message["content"] = "\n".join(str(item) for item in message["content"])
+    return messages
+
+
+def sft_qwen3_1_7b_wordle() -> Trainer.Config:
+    """Train Qwen3-1.7B on the multi-turn Wordle chat dataset."""
+    config = qwen3_1_7b()
+    # The config registry is loaded from this module, so explicitly replace
+    # the upstream model spec with the NPU registry.  This is what wires the
+    # current clone's parallelize_qwen3 (including Ulysses CP) into training.
+    config.model_spec = model_registry("1.7B")
+    config.dataloader = ChatDataLoader.Config(
+        dataset_path="willcb/V3-wordle",
+        load_dataset_kwargs={"split": "train"},
+        sample_processor=_process_wordle_sample,
+        infinite=True,
+    )
+    config.optimizer = default_adamw(lr=1e-5, weight_decay=0.0)
+    config.training.local_batch_size = 2
+    config.training.global_batch_size = 64
+    config.training.seq_len = 1024
+    config.training.max_norm = 1.0
+    config.training.steps = 20
+    config.checkpoint.folder = "checkpoint_wordle_sft"
+    config.checkpoint.initial_load_in_hf = True
+    # Leave initial_load_path unset: the trainer resolves HF weights from
+    # config.hf_assets_path (which the CLI may override).
+    config.checkpoint.initial_load_path = None
+    return config
+
+
+def sft_qwen3_1_7b_wordle_tnd() -> Trainer.Config:
+    """Wordle SFT with per-document varlen attention on CANN FA v3.
+
+    Same data, optimizer and checkpoint settings as
+    :func:`sft_qwen3_1_7b_wordle`; only two things change:
+
+    - the model spec selects the upstream varlen contract, so the trainer
+      builds ``VarlenMetadata`` from the packed ``positions``;
+    - ``override.imports`` activates ``AscVarlenAttention``, which runs the
+      same per-document segmentation as a TND fused kernel.
+    """
+    config = sft_qwen3_1_7b_wordle()
+    config.model_spec = model_registry("1.7B", attn_backend="varlen")
+    config.override.imports.append(
+        "torchtitan_npu.override.qwen3.varlen_attention.asc"
+    )
+    return config
diff --git a/torchtitan_npu/models/qwen3/parallelize.py b/torchtitan_npu/models/qwen3/parallelize.py
